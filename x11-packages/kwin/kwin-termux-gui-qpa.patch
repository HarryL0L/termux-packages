+
+bool TermuxGuiQPainterLayer::ensureBuffers(const QSize &size)
+{
+    bool recreate = false;
+    for (const auto &buffer : m_buffers) {
+        if (!buffer.valid) {
+            recreate = true;
+            break;
+        }
+    }
+    if (!recreate) {
+        auto &api = androidHardwareBufferApi();
+        if (!api.ensureLoaded()) {
+            return false;
+        }
+        AHardwareBuffer_Desc desc{};
+        api.describe()(m_buffers[0].hb.buffer, &desc);
+        recreate = QSize(static_cast<int>(desc.width), static_cast<int>(desc.height)) != size;
+    }
+    if (!recreate) {
+        return true;
+    }
+
+    destroyBuffers();
+    for (auto &buffer : m_buffers) {
+        if (m_integration->createHardwareBuffer(&buffer.hb, static_cast<uint32_t>(size.width()), static_cast<uint32_t>(size.height())) != TGUI_ERR_OK) {
+            destroyBuffers();
+            return false;
+        }
+        buffer.valid = true;
+    }
+    m_currentBuffer = 0;
+    return true;
+}
+
+void TermuxGuiQPainterLayer::destroyBuffers()
+{
+    for (auto &buffer : m_buffers) {
+        if (buffer.valid) {
+            m_integration->destroyHardwareBuffer(&buffer.hb);
+            buffer.valid = false;
+        }
+    }
+}
+
+bool TermuxGuiQPainterLayer::copyImageToBuffer(const QImage *image, Buffer *buffer)
+{
+    if (!image || image->isNull() || !buffer->valid) {
+        return false;
+    }
+
+    auto &api = androidHardwareBufferApi();
+    if (!api.ensureLoaded()) {
+        return false;
+    }
+
+    AHardwareBuffer_Desc desc{};
+    api.describe()(buffer->hb.buffer, &desc);
+    if (desc.width != static_cast<uint32_t>(image->width()) || desc.height != static_cast<uint32_t>(image->height())) {
+        return false;
+    }
+
+    void *mapped = nullptr;
+    const int rc = api.lock()(buffer->hb.buffer, AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN, -1, nullptr, &mapped);
+    if (rc != 0 || !mapped) {
+        return false;
+    }
+
+    const size_t srcStride = static_cast<size_t>(image->bytesPerLine());
+    auto *dst = static_cast<unsigned char *>(mapped);
+    const auto *src = image->constBits();
+    const size_t dstStride = static_cast<size_t>(desc.stride) * 4;
+    for (int y = 0; y < image->height(); ++y) {
+        const auto *srcRow = src + static_cast<size_t>(y) * srcStride;
+        auto *dstRow = dst + static_cast<size_t>(image->height() - 1 - y) * dstStride;
+        for (int x = 0; x < image->width(); ++x) {
+            dstRow[x * 4 + 0] = srcRow[x * 4 + 2];
+            dstRow[x * 4 + 1] = srcRow[x * 4 + 1];
+            dstRow[x * 4 + 2] = srcRow[x * 4 + 0];
+            dstRow[x * 4 + 3] = 0xff;
+        }
+    }
+
+    api.unlock()(buffer->hb.buffer, nullptr);
+    return true;
+}
+
+std::optional<OutputLayerBeginFrameInfo> TermuxGuiQPainterLayer::doBeginFrame()
+{
+    const QSize nativeSize = m_output->modeSize();
+    if (nativeSize.isEmpty()) {
+        return std::nullopt;
+    }
+    if (!m_swapchain || m_swapchain->size() != nativeSize) {
+        m_swapchain = std::make_unique<QPainterSwapchain>(m_backend->graphicsBufferAllocator(), nativeSize, DRM_FORMAT_XRGB8888);
+    }
+    if (!ensureBuffers(nativeSize)) {
+        return std::nullopt;
+    }
+
+    m_current = m_swapchain->acquire();
+    if (!m_current) {
+        return std::nullopt;
+    }
+
+    m_renderTime = std::make_unique<CpuRenderTimeQuery>();
+    return OutputLayerBeginFrameInfo{
+        .renderTarget = RenderTarget(m_current->view()->image()),
+        .repaint = Region::infinite(),
+    };
+}
+
+bool TermuxGuiQPainterLayer::doEndFrame(const Region &renderedDeviceRegion, const Region &damagedDeviceRegion, OutputFrame *frame)
+{
+    if (m_renderTime) {
+        m_renderTime->end();
+        if (frame) {
+            frame->addRenderTimeQuery(std::move(m_renderTime));
+        }
+    }
+
+    Buffer &buffer = m_buffers[m_currentBuffer];
+    if (copyImageToBuffer(m_current ? m_current->view()->image() : nullptr, &buffer)) {
+        if (m_integration->view() != -1) {
+            m_integration->setBuffer(&buffer.hb);
+        }
+        m_currentBuffer = (m_currentBuffer + 1) % m_buffers.size();
+    }
+    if (m_current) {
+        m_swapchain->release(m_current);
+        m_current.reset();
+    }
+    return true;
+}
+
+DrmDevice *TermuxGuiQPainterLayer::scanoutDevice() const
+{
+    return nullptr;
+}
+
+FormatModifierMap TermuxGuiQPainterLayer::supportedDrmFormats() const
+{
+    return {};
+}
+
+void TermuxGuiQPainterLayer::releaseBuffers()
+{
+    m_current.reset();
+    m_swapchain.reset();
+    destroyBuffers();
+}
+
+TermuxGuiQPainterBackend::TermuxGuiQPainterBackend(VirtualBackend *backend, TermuxGuiIntegration *integration)
+    : m_backend(backend)
+    , m_integration(integration)
+    , m_allocator(std::make_unique<ShmGraphicsBufferAllocator>())
+{
+    qRegisterMetaType<QSize>();
+    connect(m_backend, &VirtualBackend::outputAdded, this, &TermuxGuiQPainterBackend::addOutput);
+    connect(m_integration, &TermuxGuiIntegration::surfaceSizeChanged, this, &TermuxGuiQPainterBackend::updateOutputSize, Qt::QueuedConnection);
+
+    for (BackendOutput *output : m_backend->outputs()) {
+        addOutput(output);
+    }
+
+    const QSize size = m_integration->surfaceSize();
+    if (!size.isEmpty()) {
+        updateOutputSize(size);
+    }
+}
+
+TermuxGuiQPainterBackend::~TermuxGuiQPainterBackend()
+{
+    const auto outputs = m_backend->outputs();
+    for (BackendOutput *output : outputs) {
+        static_cast<VirtualOutput *>(output)->setOutputLayer(nullptr);
+    }
+}
+
+GraphicsBufferAllocator *TermuxGuiQPainterBackend::graphicsBufferAllocator() const
+{
+    return m_allocator.get();
+}
+
+TermuxGuiIntegration *TermuxGuiQPainterBackend::integration() const
+{
+    return m_integration;
+}
+
+void TermuxGuiQPainterBackend::addOutput(BackendOutput *output)
+{
+    auto *virtualOutput = static_cast<VirtualOutput *>(output);
+    virtualOutput->setOutputLayer(std::make_unique<TermuxGuiQPainterLayer>(output, this));
+}
+
+void TermuxGuiQPainterBackend::updateOutputSize(const QSize &size)
+{
+    if (size.isEmpty()) {
+        return;
+    }
+
+    const TermuxGuiDisplayInfo info = m_integration->displayInfo();
+    QList<TermuxGuiDisplayMode> modes = info.modes;
+    if (modes.isEmpty()) {
+        modes.append({info.currentMode.size.isEmpty() ? size : info.currentMode.size, info.currentMode.refreshRate ? info.currentMode.refreshRate : 60000u});
+    }
+
+    const bool landscape = size.width() > size.height();
+    const bool currentModeLandscape = info.currentMode.size.width() > info.currentMode.size.height();
+    const bool transpose = landscape != currentModeLandscape;
+
+    for (BackendOutput *output : m_backend->outputs()) {
+        auto *virtualOutput = static_cast<VirtualOutput *>(output);
+        OutputConfiguration config;
+        auto change = config.changeSet(virtualOutput);
+
+        QList<CustomModeDefinition> customModes;
+        std::optional<TermuxGuiDisplayMode> current;
+        for (const TermuxGuiDisplayMode &mode : modes) {
+            QSize modeSize = mode.size;
+            if (transpose) {
+                modeSize.transpose();
+            }
+            OutputModeline::Flags flags = OutputModeline::Flag::Custom;
+            if (mode.size == info.currentMode.size && mode.refreshRate == info.currentMode.refreshRate) {
+                flags |= OutputModeline::Flag::Preferred;
+                current = TermuxGuiDisplayMode{modeSize, mode.refreshRate};
+            }
+            customModes.append({modeSize, mode.refreshRate, flags});
+        }
+
+        if (!current) {
+            current = TermuxGuiDisplayMode{size, virtualOutput->refreshRate() ? virtualOutput->refreshRate() : 60000};
+            customModes.append({size, current->refreshRate, OutputModeline::Flags(OutputModeline::Flag::Custom) | OutputModeline::Flag::Preferred});
+        }
+
+        change->customModes = customModes;
+        change->currentMode = OutputModeline(current->size, current->refreshRate, OutputModeline::Flags(OutputModeline::Flag::Custom) | OutputModeline::Flag::Preferred);
+        change->scale = info.density > 0 ? info.density : 1.0;
+        change->scaleSetting = change->scale;
+        change->pos = QPoint(0, 0);
+        change->transform = OutputTransform::Kind::Normal;
+        change->manualTransform = OutputTransform::Kind::Normal;
+        virtualOutput->applyChanges(config);
+    }
+}
+
+QList<OutputLayer *> TermuxGuiQPainterBackend::compatibleOutputLayers(BackendOutput *output)
+{
+    return {static_cast<VirtualOutput *>(output)->outputLayer()};
+}
