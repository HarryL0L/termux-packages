+class AndroidHardwareBufferApi
+{
+public:
+    using DescribeFn = void (*)(const AHardwareBuffer *, AHardwareBuffer_Desc *);
+    using LockFn = int (*)(AHardwareBuffer *, uint64_t, int32_t, const ARect *, void **);
+    using UnlockFn = int (*)(AHardwareBuffer *, int32_t *);
+
+    bool ensureLoaded()
+    {
+        if (m_loaded) {
+            return m_describe && m_lock && m_unlock;
+        }
+        m_loaded = true;
+        if (!m_library.load()) {
+            return false;
+        }
+        m_describe = reinterpret_cast<DescribeFn>(m_library.resolve("AHardwareBuffer_describe"));
+        m_lock = reinterpret_cast<LockFn>(m_library.resolve("AHardwareBuffer_lock"));
+        m_unlock = reinterpret_cast<UnlockFn>(m_library.resolve("AHardwareBuffer_unlock"));
+        return m_describe && m_lock && m_unlock;
+    }
+
+    DescribeFn describe() const
+    {
+        return m_describe;
+    }
+
+    LockFn lock() const
+    {
+        return m_lock;
+    }
+
+    UnlockFn unlock() const
+    {
+        return m_unlock;
+    }
+
+private:
+    QLibrary m_library{QStringLiteral("libandroid.so")};
+    DescribeFn m_describe = nullptr;
+    LockFn m_lock = nullptr;
+    UnlockFn m_unlock = nullptr;
+    bool m_loaded = false;
+};
+
+AndroidHardwareBufferApi &androidHardwareBufferApi()
+{
+    static AndroidHardwareBufferApi api;
+    return api;
+}
