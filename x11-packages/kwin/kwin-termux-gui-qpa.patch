+bool readFull(int fd, void *buffer, size_t length)
+{
+    auto *ptr = static_cast<unsigned char *>(buffer);
+    while (length > 0) {
+        const ssize_t n = ::read(fd, ptr, length);
+        if (n > 0) {
+            ptr += n;
+            length -= static_cast<size_t>(n);
+        } else if (n < 0 && errno == EINTR) {
+            continue;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool writeFull(int fd, const void *buffer, size_t length)
+{
+    const auto *ptr = static_cast<const unsigned char *>(buffer);
+    while (length > 0) {
+        const ssize_t n = ::send(fd, ptr, length, MSG_NOSIGNAL);
+        if (n > 0) {
+            ptr += n;
+            length -= static_cast<size_t>(n);
+        } else if (n < 0 && errno == EINTR) {
+            continue;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool sendJson(int fd, const QByteArray &json)
+{
+    const uint32_t length = static_cast<uint32_t>(json.size());
+    const unsigned char header[4] = {
+        static_cast<unsigned char>(length >> 24),
+        static_cast<unsigned char>(length >> 16),
+        static_cast<unsigned char>(length >> 8),
+        static_cast<unsigned char>(length),
+    };
+    return writeFull(fd, header, sizeof(header)) && writeFull(fd, json.constData(), static_cast<size_t>(json.size()));
+}
+
+QByteArray receiveJson(int fd)
+{
+    unsigned char header[4];
+    if (!readFull(fd, header, sizeof(header))) {
+        return {};
+    }
+    const uint32_t length = (static_cast<uint32_t>(header[0]) << 24)
+        | (static_cast<uint32_t>(header[1]) << 16)
+        | (static_cast<uint32_t>(header[2]) << 8)
+        | static_cast<uint32_t>(header[3]);
+    if (length == 0 || length > 1024 * 1024) {
+        return {};
+    }
+    QByteArray json;
+    json.resize(static_cast<qsizetype>(length));
+    if (!readFull(fd, json.data(), length)) {
+        return {};
+    }
+    return json;
+}
+
+int createJsonServer(char *name, size_t nameSize)
+{
+    static constexpr char chars[] = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";
+    if (nameSize < 2) {
+        return -1;
+    }
+
+    for (int attempt = 0; attempt < 32; ++attempt) {
+        uint32_t value = static_cast<uint32_t>(getpid()) ^ (static_cast<uint32_t>(getppid()) << 16) ^ static_cast<uint32_t>(attempt);
+        const int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+        if (fd < 0) {
+            return -1;
+        }
+        for (size_t i = 0; i < nameSize - 1; ++i) {
+            value = value * 1103515245u + 12345u;
+            name[i] = chars[(value >> 16) % (sizeof(chars) - 1)];
+        }
+        name[nameSize - 1] = '\0';
+
+        sockaddr_un address{};
+        address.sun_family = AF_UNIX;
+        std::memcpy(address.sun_path + 1, name, nameSize - 1);
+        const socklen_t length = static_cast<socklen_t>(sizeof(address.sun_family) + 1 + nameSize - 1);
+        if (::bind(fd, reinterpret_cast<sockaddr *>(&address), length) == 0 && ::listen(fd, 1) == 0) {
+            return fd;
+        }
+        const int error = errno;
+        ::close(fd);
+        if (error != EADDRINUSE) {
+            errno = error;
+            return -1;
+        }
+    }
+    errno = EADDRINUSE;
+    return -1;
+}
+
+int acceptJsonConnection(int fd)
+{
+    pollfd p{.fd = fd, .events = POLLIN, .revents = 0};
+    if (::poll(&p, 1, 10000) <= 0) {
+        return -1;
+    }
+    return ::accept4(fd, nullptr, nullptr, SOCK_CLOEXEC);
+}
+
+bool broadcastJsonReceiver(const char *mainName, const char *eventName)
+{
+    const pid_t pid = ::fork();
+    if (pid < 0) {
+        return false;
+    }
+    if (pid == 0) {
+        const int nullFd = ::open("/dev/null", O_RDWR);
+        if (nullFd >= 0) {
+            ::dup2(nullFd, STDIN_FILENO);
+            ::dup2(nullFd, STDOUT_FILENO);
+            ::dup2(nullFd, STDERR_FILENO);
+            if (nullFd > STDERR_FILENO) {
+                ::close(nullFd);
+            }
+        }
+        ::execlp("am", "am", "broadcast", "--user", "0", "-n", "com.termux.gui/.GUIReceiver",
+                 "--es", "mainSocket", mainName, "--es", "eventSocket", eventName, static_cast<char *>(nullptr));
+        _exit(127);
+    }
+    int status = 0;
+    if (::waitpid(pid, &status, 0) < 0) {
+        return false;
+    }
+    return WIFEXITED(status) && WEXITSTATUS(status) == 0;
+}
