+tgui_err TermuxGuiIntegration::createHardwareBuffer(tgui_hardware_buffer *buffer, uint32_t width, uint32_t height)
+{
+    return tgui_hardware_buffer_create(m_connection, buffer, TGUI_HARDWARE_BUFFER_FORMAT_RGBA8888, width, height, TGUI_HARDWARE_BUFFER_CPU_NEVER, TGUI_HARDWARE_BUFFER_CPU_OFTEN);
+}
+
+void TermuxGuiIntegration::destroyHardwareBuffer(tgui_hardware_buffer *buffer)
+{
+    if (buffer->buffer) {
+        tgui_hardware_buffer_destroy(m_connection, buffer);
+        buffer->buffer = nullptr;
+        buffer->id = -1;
+    }
+}
+
+tgui_err TermuxGuiIntegration::setBuffer(tgui_hardware_buffer *buffer)
+{
+    const tgui_view view = m_view.load();
+    if (view == -1) {
+        return TGUI_ERR_VIEW_INVALID;
+    }
+    return tgui_surface_view_set_buffer(m_connection, m_activity, view, buffer);
+}
+
+void TermuxGuiIntegration::createSurfaceView()
+{
+    if (m_view.load() != -1) {
+        return;
+    }
+
+    tgui_view view = -1;
+    if (tgui_create_surface_view(m_connection, m_activity, &view, nullptr, TGUI_VIS_VISIBLE, false) != TGUI_ERR_OK) {
+        return;
+    }
+    m_view = view;
+    const tgui_view_size matchParent{TGUI_VIEW_MATCH_PARENT, {}};
+    tgui_set_width(m_connection, m_activity, view, matchParent);
+    tgui_set_height(m_connection, m_activity, view, matchParent);
+    tgui_set_clickable(m_connection, m_activity, view, true);
+    tgui_send_touch_event(m_connection, m_activity, view, true);
+    tgui_surface_view_config(m_connection, m_activity, view, 0xff000000u, TGUI_MISMATCH_STICK_TOPLEFT, TGUI_MISMATCH_STICK_TOPLEFT, 60.0f);
+    tgui_activity_configure_insets(m_connection, m_activity, TGUI_INSET_NONE, TGUI_INSET_BEHAVIOUR_TRANSIENT);
+}
+
+void TermuxGuiIntegration::handleEvent(tgui_event &event)
+{
+    switch (event.type) {
+    case TGUI_EVENT_CREATE:
+        if (event.activity == m_activity) {
+            createSurfaceView();
+        }
+        break;
+    case TGUI_EVENT_DESTROY:
+        if (event.activity == m_activity) {
+            m_view = -1;
+        }
+        break;
+    case TGUI_EVENT_SURFACE_CHANGED:
+        if (event.activity == m_activity && event.surfaceChanged.id == m_view.load()) {
+            const QSize size(static_cast<int>(event.surfaceChanged.width), static_cast<int>(event.surfaceChanged.height));
+            {
+                QMutexLocker locker(&m_mutex);
+                m_surfaceSize = size;
+            }
+            m_surfaceSizeReady.wakeAll();
+            Q_EMIT surfaceSizeChanged(size);
+        }
+        break;
+    case TGUI_EVENT_TOUCH:
+        if (event.activity == m_activity && event.touch.id == m_view.load()) {
+            TermuxGuiTouchEvent touch;
+            touch.action = event.touch.action;
+            touch.index = event.touch.index;
+            touch.time = event.touch.time;
+            if (event.touch.events > 0) {
+                const uint32_t last = event.touch.events - 1;
+                touch.points.reserve(static_cast<int>(event.touch.num_pointers));
+                for (uint32_t i = 0; i < event.touch.num_pointers; ++i) {
+                    const tgui_touch_pointer p = event.touch.pointers[last][i];
+                    touch.points.push_back({p.id, p.x, p.y});
+                }
+            }
+            Q_EMIT touchEvent(touch);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+void TermuxGuiIntegration::run()
+{
+    while (m_running) {
+        bool handled = false;
+        for (;;) {
+            tgui_event event{};
+            bool available = false;
+            if (tgui_poll_event(m_connection, &event, &available) != TGUI_ERR_OK) {
+                m_running = false;
+                break;
+            }
+            if (!available) {
+                break;
+            }
+            handled = true;
+            handleEvent(event);
+            tgui_event_destroy(&event);
+        }
+        if (!handled) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+    }
+}
