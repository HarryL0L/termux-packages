+bool TermuxGuiIntegration::queryDisplayInfo()
+{
+    const QByteArray response = termuxGuiConfiguration();
+    if (response.isEmpty()) {
+        return false;
+    }
+
+    const QJsonDocument document = QJsonDocument::fromJson(response);
+    if (!document.isObject()) {
+        return false;
+    }
+
+    const QJsonObject object = document.object();
+    TermuxGuiDisplayInfo info;
+    info.density = object.value(QStringLiteral("density")).toDouble(1.0);
+    info.hdrSupported = object.value(QStringLiteral("hdr_supported")).toBool(false);
+    info.orientation = object.value(QStringLiteral("orientation")).toString();
+
+    const QJsonObject current = object.value(QStringLiteral("current_mode")).toObject();
+    info.currentMode.size = QSize(current.value(QStringLiteral("width")).toInt(), current.value(QStringLiteral("height")).toInt());
+    info.currentMode.refreshRate = static_cast<uint32_t>(qRound64(current.value(QStringLiteral("refresh_rate")).toDouble() * 1000.0));
+
+    const QJsonArray modes = object.value(QStringLiteral("supported_modes")).toArray();
+    for (const QJsonValue &value : modes) {
+        const QJsonObject mode = value.toObject();
+        TermuxGuiDisplayMode displayMode;
+        displayMode.size = QSize(mode.value(QStringLiteral("width")).toInt(), mode.value(QStringLiteral("height")).toInt());
+        displayMode.refreshRate = static_cast<uint32_t>(qRound64(mode.value(QStringLiteral("refresh_rate")).toDouble() * 1000.0));
+        if (!displayMode.size.isEmpty() && displayMode.refreshRate > 0 && !info.modes.contains(displayMode)) {
+            info.modes.append(displayMode);
+        }
+    }
+
+    if (!info.currentMode.size.isEmpty() && info.currentMode.refreshRate > 0 && !info.modes.contains(info.currentMode)) {
+        info.modes.prepend(info.currentMode);
+    }
+
+    QMutexLocker locker(&m_mutex);
+    m_displayInfo = info;
+    return true;
+}
