+bool writeAll(int fd, const void *data, size_t size)
+{
+    const auto *ptr = static_cast<const uint8_t *>(data);
+    while (size) {
+        const ssize_t written = send(fd, ptr, size, MSG_NOSIGNAL);
+        if (written > 0) {
+            ptr += written;
+            size -= static_cast<size_t>(written);
+        } else if (written < 0 && errno == EINTR) {
+            continue;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool readAll(int fd, void *data, size_t size)
+{
+    auto *ptr = static_cast<uint8_t *>(data);
+    while (size) {
+        const ssize_t bytesRead = ::read(fd, ptr, size);
+        if (bytesRead > 0) {
+            ptr += bytesRead;
+            size -= static_cast<size_t>(bytesRead);
+        } else if (bytesRead < 0 && errno == EINTR) {
+            continue;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool sendJson(int fd, const QByteArray &message)
+{
+    const uint32_t length = htonl(static_cast<uint32_t>(message.size()));
+    return writeAll(fd, &length, sizeof(length)) && writeAll(fd, message.constData(), message.size());
+}
+
+QByteArray receiveJson(int fd)
+{
+    uint32_t length = 0;
+    if (!readAll(fd, &length, sizeof(length))) {
+        return {};
+    }
+    length = ntohl(length);
+    if (length > 1024 * 1024) {
+        return {};
+    }
+    QByteArray message(static_cast<qsizetype>(length), Qt::Uninitialized);
+    if (!readAll(fd, message.data(), message.size())) {
+        return {};
+    }
+    return message;
+}
+
+int createAbstractSocket(QString &name)
+{
+    const QByteArray chars = QByteArrayLiteral("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ");
+    for (int attempt = 0; attempt < 16; ++attempt) {
+        name.clear();
+        for (int i = 0; i < 50; ++i) {
+            name += chars.at(QRandomGenerator::global()->bounded(chars.size()));
+        }
+
+        const int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+        if (fd < 0) {
+            return -1;
+        }
+
+        sockaddr_un address{};
+        address.sun_family = AF_UNIX;
+        std::memcpy(address.sun_path + 1, name.constData(), static_cast<size_t>(name.size()));
+        if (bind(fd, reinterpret_cast<const sockaddr *>(&address), static_cast<socklen_t>(sizeof(address.sun_family) + 1 + name.size())) == 0) {
+            if (listen(fd, 1) == 0) {
+                return fd;
+            }
+        }
+        const int error = errno;
+        close(fd);
+        if (error != EADDRINUSE) {
+            errno = error;
+            return -1;
+        }
+    }
+    errno = EADDRINUSE;
+    return -1;
+}
+
+QByteArray termuxGuiConfiguration()
+{
+    QString mainName;
+    QString eventName;
+    const int mainServer = createAbstractSocket(mainName);
+    const int eventServer = createAbstractSocket(eventName);
+    if (mainServer < 0 || eventServer < 0) {
+        if (mainServer >= 0) {
+            close(mainServer);
+        }
+        if (eventServer >= 0) {
+            close(eventServer);
+        }
+        return {};
+    }
+
+    QProcess process;
+    process.start(QStringLiteral("termux-am"), {
+        QStringLiteral("broadcast"),
+        QStringLiteral("--user"), QStringLiteral("0"),
+        QStringLiteral("-n"), QStringLiteral("com.termux.gui/.GUIReceiver"),
+        QStringLiteral("--es"), QStringLiteral("mainSocket"), mainName,
+        QStringLiteral("--es"), QStringLiteral("eventSocket"), eventName,
+    });
+    if (!process.waitForFinished(5000) || process.exitStatus() != QProcess::NormalExit || process.exitCode() != 0) {
+        process.kill();
+        process.waitForFinished();
+        close(mainServer);
+        close(eventServer);
+        return {};
+    }
+
+    pollfd pollFd{mainServer, POLLIN, 0};
+    if (poll(&pollFd, 1, 5000) <= 0) {
+        close(mainServer);
+        close(eventServer);
+        return {};
+    }
+    const int mainFd = accept4(mainServer, nullptr, nullptr, SOCK_CLOEXEC);
+    if (mainFd < 0) {
+        close(mainServer);
+        close(eventServer);
+        return {};
+    }
+
+    pollFd = {eventServer, POLLIN, 0};
+    if (poll(&pollFd, 1, 2000) <= 0) {
+        close(mainFd);
+        close(mainServer);
+        close(eventServer);
+        return {};
+    }
+    const int eventFd = accept4(eventServer, nullptr, nullptr, SOCK_CLOEXEC);
+    close(mainServer);
+    close(eventServer);
+    if (eventFd < 0) {
+        close(mainFd);
+        return {};
+    }
+    close(eventFd);
+
+    const uint8_t protocol = 1;
+    uint8_t responseProtocol = 0xff;
+    if (!writeAll(mainFd, &protocol, sizeof(protocol)) || !readAll(mainFd, &responseProtocol, sizeof(responseProtocol)) || responseProtocol != 0) {
+        close(mainFd);
+        return {};
+    }
+
+    const QByteArray createRequest = QByteArrayLiteral("{\"method\":\"newActivity\",\"params\":{\"dialog\":false}}");
+    if (!sendJson(mainFd, createRequest)) {
+        close(mainFd);
+        return {};
+    }
+    const QByteArray createResponse = receiveJson(mainFd);
+    if (createResponse.isEmpty()) {
+        close(mainFd);
+        return {};
+    }
+
+    bool ok = false;
+    const int aid = QString::fromUtf8(createResponse).trimmed().toInt(&ok);
+    if (!ok || aid < 0) {
+        close(mainFd);
+        return {};
+    }
+
+    const QByteArray request = QByteArrayLiteral("{\"method\":\"getConfiguration\",\"params\":{\"aid\":") + QByteArray::number(aid) + QByteArrayLiteral("}}");
+    if (!sendJson(mainFd, request)) {
+        close(mainFd);
+        return {};
+    }
+    const QByteArray response = receiveJson(mainFd);
+
+    const QByteArray finishRequest = QByteArrayLiteral("{\"method\":\"finishActivity\",\"params\":{\"aid\":") + QByteArray::number(aid) + QByteArrayLiteral("}}");
+    sendJson(mainFd, finishRequest);
+    close(mainFd);
+    return response;
+}
