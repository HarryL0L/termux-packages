+bool TermuxGuiIntegration::queryDisplayInfo(TermuxGuiDisplayInfo *info) const
+{
+    char mainName[41];
+    char eventName[41];
+    const int mainServer = createJsonServer(mainName, sizeof(mainName));
+    const int eventServer = createJsonServer(eventName, sizeof(eventName));
+    if (mainServer < 0 || eventServer < 0) {
+        if (mainServer >= 0) {
+            ::close(mainServer);
+        }
+        if (eventServer >= 0) {
+            ::close(eventServer);
+        }
+        return false;
+    }
+    if (!broadcastJsonReceiver(mainName, eventName)) {
+        ::close(mainServer);
+        ::close(eventServer);
+        return false;
+    }
+
+    const int mainFd = acceptJsonConnection(mainServer);
+    const int eventFd = acceptJsonConnection(eventServer);
+    ::close(mainServer);
+    ::close(eventServer);
+    if (mainFd < 0 || eventFd < 0) {
+        if (mainFd >= 0) {
+            ::close(mainFd);
+        }
+        if (eventFd >= 0) {
+            ::close(eventFd);
+        }
+        return false;
+    }
+    ::close(eventFd);
+
+    constexpr unsigned char protocol = 0x01;
+    unsigned char responseProtocol = 0xff;
+    if (!writeFull(mainFd, &protocol, 1) || !readFull(mainFd, &responseProtocol, 1) || responseProtocol != 0) {
+        ::close(mainFd);
+        return false;
+    }
+
+    // V0Json keeps its Activity map per connection, so an Activity created by
+    // the C-binding connection cannot be queried from this JSON connection.
+    // Create a short-lived metadata Activity on this same JSON connection.
+    const QByteArray newActivityRequest = QByteArrayLiteral("{\"method\":\"newActivity\",\"params\":{\"dialog\":false}}" );
+    if (!sendJson(mainFd, newActivityRequest)) {
+        ::close(mainFd);
+        return false;
+    }
+    const QByteArray newActivityResponse = receiveJson(mainFd);
+    if (newActivityResponse.isEmpty()) {
+        ::close(mainFd);
+        return false;
+    }
+
+    QJsonParseError activityError{};
+    const QJsonDocument activityDocument = QJsonDocument::fromJson(newActivityResponse, &activityError);
+    int aid = -1;
+    if (activityError.error == QJsonParseError::NoError && activityDocument.isArray()) {
+        const QJsonArray array = activityDocument.array();
+        if (!array.isEmpty()) {
+            aid = array.at(0).toInt(-1);
+        }
+    }
+    if (aid < 0) {
+        ::close(mainFd);
+        return false;
+    }
+
+    const QByteArray request = QByteArrayLiteral("{\"method\":\"getConfiguration\",\"params\":{\"aid\":")
+        + QByteArray::number(aid) + QByteArrayLiteral("}}" );
+    if (!sendJson(mainFd, request)) {
+        ::close(mainFd);
+        return false;
+    }
+    const QByteArray response = receiveJson(mainFd);
+
+    const QByteArray finishRequest = QByteArrayLiteral("{\"method\":\"finishActivity\",\"params\":{\"aid\":")
+        + QByteArray::number(aid) + QByteArrayLiteral("}}" );
+    sendJson(mainFd, finishRequest);
+    ::close(mainFd);
+
+    if (response.isEmpty()) {
+        return false;
+    }
+    return parseDisplayInfo(response, info);
+}
