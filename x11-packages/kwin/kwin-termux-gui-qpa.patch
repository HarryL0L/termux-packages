+TermuxGuiQPainterBackend::TermuxGuiQPainterBackend(VirtualBackend *backend, TermuxGuiIntegration *integration)
+    : m_backend(backend)
+    , m_integration(integration)
+    , m_allocator(std::make_unique<ShmGraphicsBufferAllocator>())
+{
+    qRegisterMetaType<QSize>();
+    connect(m_backend, &VirtualBackend::outputAdded, this, &TermuxGuiQPainterBackend::addOutput);
+    connect(m_integration, &TermuxGuiIntegration::displayInfoChanged, this, &TermuxGuiQPainterBackend::updateDisplayInfo, Qt::QueuedConnection);
+
+    for (BackendOutput *output : m_backend->outputs()) {
+        addOutput(output);
+    }
+
+    updateDisplayInfo();
+}
+
+TermuxGuiQPainterBackend::~TermuxGuiQPainterBackend()
+{
+    const auto outputs = m_backend->outputs();
+    for (BackendOutput *output : outputs) {
+        static_cast<VirtualOutput *>(output)->setOutputLayer(nullptr);
+    }
+}
