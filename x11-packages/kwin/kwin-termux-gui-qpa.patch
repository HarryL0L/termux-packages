+void TermuxGuiInputDevice::handleTouch(const TermuxGuiTouchEvent &event)
+{
+    if (!m_enabled || !m_output) {
+        return;
+    }
+
+    const qreal scale = std::max<qreal>(m_output->scale(), 0.01);
+    const auto time = std::chrono::microseconds(event.time * 1000);
+
+    switch (event.action) {
+    case TGUI_TOUCH_DOWN:
+    case TGUI_TOUCH_POINTER_DOWN:
+        if (event.index < static_cast<uint32_t>(event.points.size())) {
+            const auto &p = event.points.at(static_cast<qsizetype>(event.index));
+            Q_EMIT touchDown(p.id, QPointF(p.x / scale, p.y / scale), time, this);
+        }
+        Q_EMIT touchFrame(this);
+        break;
+    case TGUI_TOUCH_UP:
+    case TGUI_TOUCH_POINTER_UP:
+        if (event.index < static_cast<uint32_t>(event.points.size())) {
+            const auto &p = event.points.at(static_cast<qsizetype>(event.index));
+            Q_EMIT touchUp(p.id, time, this);
+        }
+        Q_EMIT touchFrame(this);
+        break;
+    case TGUI_TOUCH_MOVE:
+        for (const auto &p : event.points) {
+            Q_EMIT touchMotion(p.id, QPointF(p.x / scale, p.y / scale), time, this);
+        }
+        Q_EMIT touchFrame(this);
+        break;
+    case TGUI_TOUCH_CANCEL:
+        Q_EMIT touchCanceled(this);
+        Q_EMIT touchFrame(this);
+        break;
+    }
+}
