+void TermuxGuiInputBackend::initialize()
+{
+    const auto outputs = m_backend->outputs();
+    if (outputs.isEmpty()) {
+        return;
+    }
+    auto *output = qobject_cast<VirtualOutput *>(outputs.front());
+    if (!output) {
+        return;
+    }
+
+    m_device = new TermuxGuiInputDevice(output, this);
+    connect(m_integration, &TermuxGuiIntegration::touchEvent, m_device, &TermuxGuiInputDevice::handleTouch, Qt::QueuedConnection);
+    Q_EMIT deviceAdded(m_device);
+}
