+bool TermuxGuiIntegration::waitForSurfaceSize(int timeoutMs)
+{
+    QMutexLocker locker(&m_mutex);
+    if (!m_surfaceSize.isEmpty()) {
+        return true;
+    }
+    return m_surfaceSizeReady.wait(&m_mutex, timeoutMs) && !m_surfaceSize.isEmpty();
+}
