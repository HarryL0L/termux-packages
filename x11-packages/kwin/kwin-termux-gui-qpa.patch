+bool parseDisplayInfo(const QByteArray &json, TermuxGuiDisplayInfo *info)
+{
+    if (!info) {
+        return false;
+    }
+    QJsonParseError error{};
+    const QJsonDocument document = QJsonDocument::fromJson(json, &error);
+    if (error.error != QJsonParseError::NoError || !document.isObject()) {
+        return false;
+    }
+    const QJsonObject object = document.object();
+    const QJsonObject current = object.value(QStringLiteral("current_mode")).toObject();
+    const int currentWidth = current.value(QStringLiteral("width")).toInt();
+    const int currentHeight = current.value(QStringLiteral("height")).toInt();
+    const double currentRate = current.value(QStringLiteral("refresh_rate")).toDouble();
+    if (currentWidth <= 0 || currentHeight <= 0 || currentRate <= 0.0) {
+        return false;
+    }
+
+    TermuxGuiDisplayInfo parsed;
+    parsed.currentMode = {
+        .size = QSize(currentWidth, currentHeight),
+        .refreshRate = static_cast<uint32_t>(std::llround(currentRate * 1000.0)),
+    };
+    parsed.density = std::max(0.01, object.value(QStringLiteral("density")).toDouble(1.0));
+    parsed.orientation = object.value(QStringLiteral("orientation")).toString();
+    parsed.hdrSupported = object.value(QStringLiteral("hdr_supported")).toBool(false);
+    for (const QJsonValue &value : object.value(QStringLiteral("hdr_types")).toArray()) {
+        parsed.hdrTypes.append(value.toInt());
+    }
+
+    for (const QJsonValue &value : object.value(QStringLiteral("supported_modes")).toArray()) {
+        const QJsonObject mode = value.toObject();
+        const QSize size(mode.value(QStringLiteral("width")).toInt(), mode.value(QStringLiteral("height")).toInt());
+        const double rate = mode.value(QStringLiteral("refresh_rate")).toDouble();
+        if (size.isEmpty() || rate <= 0.0) {
+            continue;
+        }
+        const TermuxGuiDisplayMode parsedMode{
+            .size = size,
+            .refreshRate = static_cast<uint32_t>(std::llround(rate * 1000.0)),
+        };
+        if (!parsed.supportedModes.contains(parsedMode)) {
+            parsed.supportedModes.append(parsedMode);
+        }
+    }
+    if (!parsed.supportedModes.contains(parsed.currentMode)) {
+        parsed.supportedModes.prepend(parsed.currentMode);
+    }
+    *info = parsed;
+    return true;
+}
+
+QSize orientedDisplaySize(QSize size, const QString &orientation)
+{
+    if (orientation == QLatin1String("landscape") && size.height() > size.width()) {
+        size.transpose();
+    } else if (orientation == QLatin1String("portrait") && size.width() > size.height()) {
+        size.transpose();
+    }
+    return size;
+}
+
+void applyDisplayInfoToOutput(VirtualOutput *output, const TermuxGuiDisplayInfo &info)
+{
+    if (!output || info.currentMode.size.isEmpty() || info.currentMode.refreshRate == 0) {
+        return;
+    }
+
+    const QSize currentSize = orientedDisplaySize(info.currentMode.size, info.orientation);
+    if (currentSize.isEmpty()) {
+        return;
+    }
+
+    QList<CustomModeDefinition> customModes;
+    for (const auto &mode : info.supportedModes) {
+        const QSize size = orientedDisplaySize(mode.size, info.orientation);
+        if (size.isEmpty() || mode.refreshRate == 0) {
+            continue;
+        }
+        OutputModeline::Flags flags(OutputModeline::Flag::Custom);
+        if (size == currentSize && mode.refreshRate == info.currentMode.refreshRate) {
+            flags |= OutputModeline::Flag::Preferred;
+        }
+        const CustomModeDefinition definition{
+            .size = size,
+            .refreshRate = mode.refreshRate,
+            .flags = flags,
+        };
+        const bool duplicate = std::ranges::any_of(customModes, [&definition](const CustomModeDefinition &other) {
+            return other.size == definition.size && other.refreshRate == definition.refreshRate;
+        });
+        if (!duplicate) {
+            customModes.append(definition);
+        }
+    }
+
+    if (customModes.isEmpty()) {
+        customModes.append(CustomModeDefinition{
+            .size = currentSize,
+            .refreshRate = info.currentMode.refreshRate,
+            .flags = OutputModeline::Flags(OutputModeline::Flag::Custom) | OutputModeline::Flag::Preferred,
+        });
+    }
+
+    OutputConfiguration config;
+    auto change = config.changeSet(output);
+    change->customModes = customModes;
+    change->currentMode = OutputModeline(currentSize, info.currentMode.refreshRate, OutputModeline::Flags(OutputModeline::Flag::Custom) | OutputModeline::Flag::Preferred);
+    change->scale = info.density;
+    change->scaleSetting = info.density;
+    change->pos = QPoint(0, 0);
+    change->transform = OutputTransform::Kind::Normal;
+    change->manualTransform = OutputTransform::Kind::Normal;
+    output->applyChanges(config);
+
+    qInfo() << "Termux:GUI display mode" << currentSize
+            << "@" << (info.currentMode.refreshRate / 1000.0) << "Hz"
+            << "scale" << info.density
+            << "orientation" << info.orientation
+            << "supported modes" << customModes.size()
+            << "HDR" << info.hdrSupported << info.hdrTypes;
+}
