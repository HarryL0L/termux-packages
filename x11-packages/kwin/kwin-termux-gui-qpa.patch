+void TermuxGuiIntegration::configureOutputs(VirtualBackend *backend) const
+{
+    if (!backend) {
+        return;
+    }
+
+    TermuxGuiDisplayInfo info;
+    {
+        QMutexLocker locker(&m_mutex);
+        if (!m_hasDisplayInfo) {
+            qWarning() << "Termux:GUI did not provide display-mode information";
+            return;
+        }
+        info = m_displayInfo;
+    }
+
+    const QSize currentSize = orientedDisplaySize(info.currentMode.size, info.orientation);
+    if (currentSize.isEmpty() || info.density <= 0.0) {
+        qWarning() << "Invalid Termux:GUI display information" << currentSize << info.density;
+        return;
+    }
+
+    QList<OutputModeline> modes;
+    const OutputModeline currentModeline(currentSize, info.currentMode.refreshRate, OutputModeline::Flag::Preferred);
+    modes.append(currentModeline);
+    for (const auto &mode : info.supportedModes) {
+        const QSize size = orientedDisplaySize(mode.size, info.orientation);
+        if (size.isEmpty() || mode.refreshRate == 0) {
+            continue;
+        }
+        const OutputModeline modeline(size, mode.refreshRate);
+        if (!std::ranges::any_of(modes, [&modeline](const OutputModeline &other) {
+                return other.size() == modeline.size() && other.refreshRate() == modeline.refreshRate();
+            })) {
+            modes.append(modeline);
+        }
+    }
+
+    // VirtualOutput::init() stores mode sizes in physical pixels and scales
+    // them into logical geometry. Keep the physical display mode from JSON and
+    // only divide by density for the logical OutputInfo size.
+    const QSize logicalSize = (QSizeF(currentSize) / info.density).toSize();
+    QList<BackendOutput *> outputs = backend->outputs();
+    if (outputs.isEmpty()) {
+        auto *output = backend->addOutput(VirtualBackend::OutputInfo{
+            .size = logicalSize,
+            .scale = info.density,
+            .internal = true,
+            .modes = modes,
+            .panelOrientation = OutputTransform::Kind::Normal,
+            .connectorName = QStringLiteral("Termux:GUI-0"),
+        });
+        if (auto *virtualOutput = qobject_cast<VirtualOutput *>(output)) {
+            virtualOutput->setTermuxGuiOutput(true);
+        }
+        return;
+    }
+
+    if (auto *output = qobject_cast<VirtualOutput *>(outputs.front())) {
+        applyDisplayInfoToOutput(output, info);
+    }
+}
