+TermuxGuiQPainterBackend::TermuxGuiQPainterBackend(VirtualBackend *backend, TermuxGuiIntegration *integration)
+    : m_backend(backend)
+    , m_integration(integration)
+    , m_allocator(std::make_unique<ShmGraphicsBufferAllocator>())
+{
+    qRegisterMetaType<QSize>();
+    connect(m_backend, &VirtualBackend::outputAdded, this, &TermuxGuiQPainterBackend::addOutput);
+    connect(m_integration, &TermuxGuiIntegration::surfaceSizeChanged, this, &TermuxGuiQPainterBackend::updateOutputSize, Qt::QueuedConnection);
+
+    for (BackendOutput *output : m_backend->outputs()) {
+        addOutput(output);
+    }
+
+    const QSize size = m_integration->surfaceSize();
+    if (!size.isEmpty()) {
+        updateOutputSize(size);
+    }
+}
+
+TermuxGuiQPainterBackend::~TermuxGuiQPainterBackend()
+{
+    const auto outputs = m_backend->outputs();
+    for (BackendOutput *output : outputs) {
+        static_cast<VirtualOutput *>(output)->setOutputLayer(nullptr);
+    }
+}
+
+GraphicsBufferAllocator *TermuxGuiQPainterBackend::graphicsBufferAllocator() const
+{
+    return m_allocator.get();
+}
+
+TermuxGuiIntegration *TermuxGuiQPainterBackend::integration() const
+{
+    return m_integration;
+}
+
+void TermuxGuiQPainterBackend::addOutput(BackendOutput *output)
+{
+    auto *virtualOutput = static_cast<VirtualOutput *>(output);
+    virtualOutput->setOutputLayer(std::make_unique<TermuxGuiQPainterLayer>(output, this));
+}
+
+void TermuxGuiQPainterBackend::updateOutputSize(const QSize &size)
+{
+    if (size.isEmpty()) {
+        return;
+    }
+
+    for (BackendOutput *output : m_backend->outputs()) {
+        auto *virtualOutput = static_cast<VirtualOutput *>(output);
+        OutputConfiguration config;
+        auto change = config.changeSet(virtualOutput);
+        const uint32_t refreshRate = virtualOutput->refreshRate() ? virtualOutput->refreshRate() : 60000;
+        change->customModes = {{size, refreshRate, OutputModeline::Flags(OutputModeline::Flag::Custom) | OutputModeline::Flag::Preferred}};
+        change->currentMode = OutputModeline(size, refreshRate, OutputModeline::Flags(OutputModeline::Flag::Custom) | OutputModeline::Flag::Preferred);
+        change->pos = QPoint(0, 0);
+        change->transform = OutputTransform::Kind::Normal;
+        change->manualTransform = OutputTransform::Kind::Normal;
+        virtualOutput->applyChanges(config);
+    }
+
+    // Notify the workspace that the backend output changed so its LogicalOutput geometry
+    // is synchronized with the new Termux:GUI surface size before the next frame.
+    Q_EMIT m_backend->outputsQueried();
+
+    // A surface resize is asynchronous to the render loop. Explicitly request a frame so the first
+    // frame after the resize uses buffers matching the new surface dimensions.
+    for (BackendOutput *output : m_backend->outputs()) {
+        static_cast<VirtualOutput *>(output)->renderLoop()->scheduleRepaint();
+    }
+}
+
+QList<OutputLayer *> TermuxGuiQPainterBackend::compatibleOutputLayers(BackendOutput *output)
+{
+    return {static_cast<VirtualOutput *>(output)->outputLayer()};
+}
