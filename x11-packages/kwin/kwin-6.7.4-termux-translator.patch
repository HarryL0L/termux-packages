+/*
+    Minimal client for the Termux:GUI protobuf v0 protocol.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QImage>
+#include <QSize>
+#include <QString>
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <atomic>
+#include <thread>
+
+struct AHardwareBuffer;
+
+namespace KWin
+{
+
+class TermuxGuiConnection
+{
+public:
+    TermuxGuiConnection();
+    ~TermuxGuiConnection();
+
+    bool initialize(const QSize &size);
+    bool beginFrame();
+    void endFrame();
+    bool present();
+
+    QImage *image();
+    bool isValid() const;
+
+private:
+    bool createSockets();
+    bool connectPlugin();
+    bool createActivity();
+    bool createSurfaceView(const QSize &size);
+    bool createHardwareBuffer(const QSize &size);
+    bool setSurfaceBuffer();
+    bool sendMethod(uint32_t field, const std::string &payload);
+    bool readDelimited(std::string &payload);
+    bool readExact(void *data, size_t size);
+    bool writeExact(const void *data, size_t size);
+    bool readVarint(const std::string &data, size_t &offset, uint64_t &value) const;
+    bool skipField(const std::string &data, size_t &offset, uint32_t wireType) const;
+    bool parseInt32Field(const std::string &data, uint32_t wanted, int32_t &value) const;
+    bool receiveHardwareBuffer(int32_t id);
+    bool broadcastConnection();
+    void closeSockets();
+    void drainEvents();
+
+    int m_mainListen = -1;
+    int m_eventListen = -1;
+    int m_main = -1;
+    int m_event = -1;
+    int32_t m_activity = -1;
+    int32_t m_view = -1;
+    int32_t m_bufferId = -1;
+    AHardwareBuffer *m_buffer = nullptr;
+    QImage m_image;
+    uint32_t m_stride = 0;
+    QSize m_size;
+    bool m_locked = false;
+    bool m_valid = false;
+    std::atomic_bool m_stopEventThread = false;
+    std::thread m_eventThread;
+    QString m_mainName;
+    QString m_eventName;
+};
+
+} // namespace KWin
