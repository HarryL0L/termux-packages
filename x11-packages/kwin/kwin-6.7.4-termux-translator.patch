+TranslatorQPainterLayer::TranslatorQPainterLayer(BackendOutput *output, TranslatorQPainterBackend *backend)
+    : OutputLayer(output, OutputLayerType::Primary)
+    , m_backend(backend)
+{
+}
+
+TranslatorQPainterLayer::~TranslatorQPainterLayer() = default;
+
+std::optional<OutputLayerBeginFrameInfo> TranslatorQPainterLayer::doBeginFrame()
+{
+    auto connection = m_backend->backend()->connection();
+    if (!connection->beginFrame()) {
+        return std::nullopt;
+    }
+    return OutputLayerBeginFrameInfo{
+        .renderTarget = RenderTarget(connection->image()),
+        .repaint = Region::infinite(),
+    };
+}
+
+bool TranslatorQPainterLayer::doEndFrame(const Region &, const Region &, OutputFrame *)
+{
+    m_backend->backend()->connection()->endFrame();
+    return true;
+}
