+/*
+    Minimal Termux:GUI protobuf v0 client used by the KWin translator backend.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "termuxgui_connection.h"
+#include "translator_logging.h"
+
+#include <QCoreApplication>
+#include <QProcess>
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstring>
+#include <cstddef>
+#include <random>
+#include <string>
+#include <vector>
+
+#include <arpa/inet.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#if defined(Q_OS_ANDROID)
+extern "C" {
+struct AHardwareBuffer_Desc {
+    uint32_t width;
+    uint32_t height;
+    uint32_t layers;
+    uint32_t format;
+    uint64_t usage;
+    uint32_t stride;
+    uint32_t rfu0;
+    uint64_t rfu1;
+};
+int AHardwareBuffer_recvHandleFromUnixSocket(int socketFd, AHardwareBuffer **outBuffer);
+int AHardwareBuffer_describe(const AHardwareBuffer *buffer, AHardwareBuffer_Desc *outDesc);
+int AHardwareBuffer_lock(AHardwareBuffer *buffer, uint64_t usage, int32_t fence, const void *rect, void **outVirtualAddress);
+int AHardwareBuffer_unlock(AHardwareBuffer *buffer, int32_t *fence);
+void AHardwareBuffer_release(AHardwareBuffer *buffer);
+}
+
+#ifndef AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN
+#define AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN (1ULL << 4)
+#endif
+#endif
+
+namespace KWin
+{
+
+namespace {
+
+static void appendVarint(std::string &out, uint64_t value)
+{
+    while (value >= 0x80) {
+        out.push_back(char((value & 0x7f) | 0x80));
+        value >>= 7;
+    }
+    out.push_back(char(value));
+}
+
+static void appendKey(std::string &out, uint32_t field, uint32_t wireType)
+{
+    appendVarint(out, (uint64_t(field) << 3) | wireType);
+}
+
+static void appendInt32(std::string &out, uint32_t field, int32_t value)
+{
+    appendKey(out, field, 0);
+    appendVarint(out, uint64_t(int64_t(value)));
+}
+
+static void appendBool(std::string &out, uint32_t field, bool value)
+{
+    if (value) {
+        appendKey(out, field, 0);
+        appendVarint(out, 1);
+    }
+}
+
+static void appendMessage(std::string &out, uint32_t field, const std::string &message)
+{
+    appendKey(out, field, 2);
+    appendVarint(out, message.size());
+    out.append(message);
+}
+
+static std::string makeCreateMessage(int32_t aid, int32_t parent)
+{
+    std::string out;
+    appendInt32(out, 1, aid);
+    appendInt32(out, 2, parent);
+    return out;
+}
+
+} // namespace
+
+TermuxGuiConnection::TermuxGuiConnection() = default;
+
+TermuxGuiConnection::~TermuxGuiConnection()
+{
+    if (m_buffer) {
+#if defined(Q_OS_ANDROID)
+        AHardwareBuffer_release(m_buffer);
+#endif
+        m_buffer = nullptr;
+    }
+    m_stopEventThread = true;
+    if (m_event >= 0) {
+        shutdown(m_event, SHUT_RDWR);
+    }
+    if (m_eventThread.joinable()) {
+        m_eventThread.join();
+    }
+    closeSockets();
+}
+
+bool TermuxGuiConnection::isValid() const
+{
+    return m_valid;
+}
+
+void TermuxGuiConnection::closeSockets()
+{
+    if (m_main >= 0) {
+        close(m_main);
+        m_main = -1;
+    }
+    if (m_event >= 0) {
+        close(m_event);
+        m_event = -1;
+    }
+    if (m_mainListen >= 0) {
+        close(m_mainListen);
+        m_mainListen = -1;
+    }
+    if (m_eventListen >= 0) {
+        close(m_eventListen);
+        m_eventListen = -1;
+    }
+}
+
+bool TermuxGuiConnection::createSockets()
+{
+    std::random_device rd;
+    const uint32_t tag = rd();
+    const QByteArray base = QByteArray("kwin-translator-") + QByteArray::number(QCoreApplication::applicationPid()) + '-' + QByteArray::number(tag);
+    m_mainName = QString::fromLatin1(base + "-main");
+    m_eventName = QString::fromLatin1(base + "-event");
+
+    auto make = [](const QByteArray &name) -> int {
+        int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+        if (fd < 0) {
+            return -1;
+        }
+        sockaddr_un addr{};
+        addr.sun_family = AF_UNIX;
+        if (name.size() + 1 >= sizeof(addr.sun_path)) {
+            close(fd);
+            return -1;
+        }
+        addr.sun_path[0] = '\0';
+        memcpy(addr.sun_path + 1, name.constData(), name.size());
+        const socklen_t len = offsetof(sockaddr_un, sun_path) + 1 + name.size();
+        if (bind(fd, reinterpret_cast<sockaddr *>(&addr), len) < 0 || listen(fd, 1) < 0) {
+            close(fd);
+            return -1;
+        }
+        return fd;
+    };
+
+    m_mainListen = make(m_mainName.toLatin1());
+    m_eventListen = make(m_eventName.toLatin1());
+    if (m_mainListen < 0 || m_eventListen < 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI sockets:" << strerror(errno);
+        closeSockets();
+        return false;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::broadcastConnection()
+{
+    QStringList args{
+        QStringLiteral("broadcast"),
+        QStringLiteral("--user"), QStringLiteral("0"),
+        QStringLiteral("-n"), QStringLiteral("com.termux.gui/.GUIReceiver"),
+        QStringLiteral("--es"), QStringLiteral("mainSocket"), m_mainName,
+        QStringLiteral("--es"), QStringLiteral("eventSocket"), m_eventName,
+    };
+    QProcess process;
+    process.start(QStringLiteral("/system/bin/am"), args);
+    if (!process.waitForStarted(3000)) {
+        qCWarning(KWIN_TRANSLATOR) << "Could not start Android am:" << process.errorString();
+        return false;
+    }
+    if (!process.waitForFinished(5000) || process.exitCode() != 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Termux:GUI broadcast failed:" << process.readAllStandardError();
+        return false;
+    }
+    return true;
+}
+
+void TermuxGuiConnection::drainEvents()
+{
+    std::array<char, 4096> buffer{};
+    while (!m_stopEventThread) {
+        const ssize_t n = recv(m_event, buffer.data(), buffer.size(), 0);
+        if (n <= 0) {
+            break;
+        }
+    }
+}
+
+bool TermuxGuiConnection::connectPlugin()
+{
+    if (!broadcastConnection()) {
+        return false;
+    }
+
+    m_main = accept4(m_mainListen, nullptr, nullptr, SOCK_CLOEXEC);
+    m_event = accept4(m_eventListen, nullptr, nullptr, SOCK_CLOEXEC);
+    if (m_main < 0 || m_event < 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Termux:GUI did not connect:" << strerror(errno);
+        return false;
+    }
+
+    const uint8_t protocol = 0; // protobuf v0
+    if (!writeExact(&protocol, sizeof(protocol))) {
+        return false;
+    }
+    uint8_t status = 1;
+    if (!readExact(&status, sizeof(status)) || status != 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Termux:GUI rejected protobuf v0";
+        return false;
+    }
+    m_stopEventThread = false;
+    m_eventThread = std::thread([this] { drainEvents(); });
+    return true;
+}
+
+bool TermuxGuiConnection::writeExact(const void *data, size_t size)
+{
+    const char *p = static_cast<const char *>(data);
+    while (size) {
+        const ssize_t n = send(m_main, p, size, MSG_NOSIGNAL);
+        if (n < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        if (n == 0) {
+            return false;
+        }
+        p += n;
+        size -= n;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::readExact(void *data, size_t size)
+{
+    char *p = static_cast<char *>(data);
+    while (size) {
+        const ssize_t n = recv(m_main, p, size, 0);
+        if (n < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        if (n == 0) {
+            return false;
+        }
+        p += n;
+        size -= n;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::sendMethod(uint32_t field, const std::string &payload)
+{
+    std::string method;
+    appendMessage(method, field, payload);
+
+    std::string framed;
+    appendVarint(framed, method.size());
+    framed.append(method);
+    return writeExact(framed.data(), framed.size());
+}
+
+bool TermuxGuiConnection::readDelimited(std::string &payload)
+{
+    payload.clear();
+    uint64_t length = 0;
+    int shift = 0;
+    while (shift <= 63) {
+        uint8_t byte;
+        if (!readExact(&byte, 1)) {
+            return false;
+        }
+        length |= uint64_t(byte & 0x7f) << shift;
+        if (!(byte & 0x80)) {
+            if (length > 16 * 1024 * 1024) {
+                return false;
+            }
+            payload.resize(size_t(length));
+            return length == 0 || readExact(payload.data(), size_t(length));
+        }
+        shift += 7;
+    }
+    return false;
+}
+
+bool TermuxGuiConnection::readVarint(const std::string &data, size_t &offset, uint64_t &value) const
+{
+    value = 0;
+    int shift = 0;
+    while (offset < data.size() && shift <= 63) {
+        const uint8_t byte = uint8_t(data[offset++]);
+        value |= uint64_t(byte & 0x7f) << shift;
+        if (!(byte & 0x80)) {
+            return true;
+        }
+        shift += 7;
+    }
+    return false;
+}
+
+bool TermuxGuiConnection::skipField(const std::string &data, size_t &offset, uint32_t wireType) const
+{
+    uint64_t value;
+    switch (wireType) {
+    case 0:
+        return readVarint(data, offset, value);
+    case 1:
+        if (offset + 8 > data.size()) return false;
+        offset += 8;
+        return true;
+    case 2:
+        if (!readVarint(data, offset, value) || value > data.size() - offset) return false;
+        offset += size_t(value);
+        return true;
+    case 5:
+        if (offset + 4 > data.size()) return false;
+        offset += 4;
+        return true;
+    default:
+        return false;
+    }
+}
+
+bool TermuxGuiConnection::parseInt32Field(const std::string &data, uint32_t wanted, int32_t &value) const
+{
+    size_t offset = 0;
+    while (offset < data.size()) {
+        uint64_t key;
+        if (!readVarint(data, offset, key)) return false;
+        const uint32_t field = uint32_t(key >> 3);
+        const uint32_t wire = uint32_t(key & 7);
+        if (field == wanted && wire == 0) {
+            uint64_t v;
+            if (!readVarint(data, offset, v)) return false;
+            value = int32_t(uint32_t(v));
+            return true;
+        }
+        if (!skipField(data, offset, wire)) return false;
+    }
+    return false;
+}
+
+bool TermuxGuiConnection::createActivity()
+{
+    std::string req;
+    appendInt32(req, 1, -1); // new task
+    if (!sendMethod(16, req)) return false;
+    std::string response;
+    if (!readDelimited(response)) return false;
+    int32_t aid = -1;
+    if (!parseInt32Field(response, 1, aid) || aid < 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Termux:GUI failed to create Activity";
+        return false;
+    }
+    m_activity = aid;
+    return true;
+}
+
+bool TermuxGuiConnection::createSurfaceView(const QSize &size)
+{
+    std::string create = makeCreateMessage(m_activity, -1);
+    std::string req;
+    appendMessage(req, 1, create);
+    if (!sendMethod(130, req)) return false;
+    std::string response;
+    if (!readDelimited(response)) return false;
+    int32_t id = -1;
+    if (!parseInt32Field(response, 1, id) || id < 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Termux:GUI failed to create SurfaceView";
+        return false;
+    }
+    m_view = id;
+    return true;
+}
+
+bool TermuxGuiConnection::receiveHardwareBuffer(int32_t id)
+{
+#if defined(Q_OS_ANDROID)
+    if (AHardwareBuffer_recvHandleFromUnixSocket(m_main, &m_buffer) != 0 || !m_buffer) {
+        qCWarning(KWIN_TRANSLATOR) << "Could not receive Android HardwareBuffer";
+        return false;
+    }
+    AHardwareBuffer_Desc desc{};
+    if (AHardwareBuffer_describe(m_buffer, &desc) != 0 || desc.width != uint32_t(m_size.width()) || desc.height != uint32_t(m_size.height())) {
+        qCWarning(KWIN_TRANSLATOR) << "Received unexpected HardwareBuffer dimensions";
+        AHardwareBuffer_release(m_buffer);
+        m_buffer = nullptr;
+        return false;
+    }
+    m_stride = desc.stride;
+    m_bufferId = id;
+    return true;
+#else
+    Q_UNUSED(id)
+    return false;
+#endif
+}
+
+bool TermuxGuiConnection::createHardwareBuffer(const QSize &size)
+{
+    std::string req;
+    appendInt32(req, 1, size.width());
+    appendInt32(req, 2, size.height());
+    appendInt32(req, 3, 0); // RGBA8888
+    appendInt32(req, 5, 2); // CPU write often
+    if (!sendMethod(700, req)) return false;
+
+    int32_t id;
+    uint32_t wireId = 0;
+    if (!readExact(&wireId, sizeof(wireId))) {
+        return false;
+    }
+    id = int32_t(ntohl(wireId));
+    if (id < 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Termux:GUI failed to create HardwareBuffer";
+        return false;
+    }
+    return receiveHardwareBuffer(id);
+}
+
+bool TermuxGuiConnection::setSurfaceBuffer()
+{
+    std::string view;
+    appendInt32(view, 1, m_activity);
+    appendInt32(view, 2, m_view);
+
+    std::string req;
+    appendMessage(req, 1, view);
+    appendInt32(req, 2, m_bufferId);
+    if (!sendMethod(702, req)) return false;
+    std::string response;
+    return readDelimited(response);
+}
+
+bool TermuxGuiConnection::initialize(const QSize &size)
+{
+#if !defined(Q_OS_ANDROID)
+    Q_UNUSED(size)
+    qCWarning(KWIN_TRANSLATOR) << "The translator backend requires an Android build";
+    return false;
+#else
+    m_size = size;
+    if (!createSockets() || !connectPlugin() || !createActivity() || !createSurfaceView(size) || !createHardwareBuffer(size) || !setSurfaceBuffer()) {
+        return false;
+    }
+
+    m_image = QImage(m_size, QImage::Format_RGBA8888);
+    m_valid = true;
+    return true;
+#endif
+}
+
+bool TermuxGuiConnection::beginFrame()
+{
+#if defined(Q_OS_ANDROID)
+    if (!m_valid || m_locked || !m_buffer) return false;
+    void *data = nullptr;
+    if (AHardwareBuffer_lock(m_buffer, AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN, -1, nullptr, &data) != 0 || !data) {
+        qCWarning(KWIN_TRANSLATOR) << "AHardwareBuffer_lock failed";
+        return false;
+    }
+    m_image = QImage(static_cast<uchar *>(data), m_size.width(), m_size.height(), int(m_stride * 4), QImage::Format_RGBA8888);
+    m_locked = true;
+    return true;
+#else
+    return false;
+#endif
+}
+
+void TermuxGuiConnection::endFrame()
+{
+#if defined(Q_OS_ANDROID)
+    if (!m_locked || !m_buffer) return;
+    AHardwareBuffer_unlock(m_buffer, nullptr);
+    m_locked = false;
+#endif
+}
+
+bool TermuxGuiConnection::present()
+{
+    if (!m_valid) return false;
+    return setSurfaceBuffer();
+}
+
+QImage *TermuxGuiConnection::image()
+{
+    return &m_image;
+}
+
+} // namespace KWin
