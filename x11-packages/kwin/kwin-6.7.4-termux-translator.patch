+
+TranslatorOutput::TranslatorOutput(TranslatorBackend *backend)
+    : BackendOutput()
+    , m_backend(backend)
+    , m_renderLoop(std::make_unique<RenderLoop>(this))
+    , m_vsyncMonitor(SoftwareVsyncMonitor::create())
+{
+    connect(m_vsyncMonitor.get(), &VsyncMonitor::vblankOccurred, this, &TranslatorOutput::vblank);
+    setInformation(Information{
+        .name = QStringLiteral("Termux-Display"),
+        .physicalSize = QSize(0, 0),
+        .capabilities = Capability::CustomModes,
+        .internal = true,
+    });
+}
+
+TranslatorOutput::~TranslatorOutput() = default;
+
+RenderLoop *TranslatorOutput::renderLoop() const
+{
+    return m_renderLoop.get();
+}
+
+bool TranslatorOutput::testPresentation(const std::shared_ptr<OutputFrame> &)
+{
+    return true;
+}
+
+bool TranslatorOutput::present(const QList<OutputLayer *> &, const std::shared_ptr<OutputFrame> &frame)
+{
+    if (!m_backend->connection()->present()) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to present frame to Termux:GUI";
+        return false;
+    }
+    m_frame = frame;
+    m_vsyncMonitor->arm();
+    return true;
+}
+
+void TranslatorOutput::init(const QSize &pixelSize, qreal scale)
+{
+    const auto mode = std::make_shared<OutputMode>(OutputModeline(pixelSize, 60000, OutputModeline::Flag::Preferred));
+    m_renderLoop->setRefreshRate(mode->refreshRate());
+    m_vsyncMonitor->setRefreshRate(mode->refreshRate());
+    setState(State{
+        .scale = scale,
+        .modes = {mode},
+        .currentMode = mode,
+        .scaleSetting = scale,
+    });
+}
+
+void TranslatorOutput::applyChanges(const OutputConfiguration &config)
+{
+    auto props = config.constChangeSet(this);
+    if (!props) {
+        return;
+    }
+    Q_EMIT aboutToChange(props.get());
+    State next = m_state;
+    next.enabled = props->enabled.value_or(m_state.enabled);
+    next.transform = props->transform.value_or(m_state.transform);
+    next.position = props->pos.value_or(m_state.position);
+    next.scale = props->scale.value_or(m_state.scale);
+    next.scaleSetting = props->scaleSetting.value_or(m_state.scaleSetting);
+    next.uuid = props->uuid.value_or(m_state.uuid);
+    next.dpmsMode = props->dpmsMode.value_or(m_state.dpmsMode);
+    setState(next);
+    m_renderLoop->setRefreshRate(next.currentMode->refreshRate());
+    m_vsyncMonitor->setRefreshRate(next.currentMode->refreshRate());
+    Q_EMIT changed();
+}
+
+void TranslatorOutput::vblank(std::chrono::nanoseconds timestamp)
+{
+    if (m_frame) {
+        m_frame->presented(timestamp, PresentationMode::VSync);
+        m_frame.reset();
+    }
+}
+
+void TranslatorOutput::setOutputLayer(std::unique_ptr<OutputLayer> &&layer)
+{
+    m_layer = std::move(layer);
+}
+
+OutputLayer *TranslatorOutput::outputLayer() const
+{
+    return m_layer.get();
+}
