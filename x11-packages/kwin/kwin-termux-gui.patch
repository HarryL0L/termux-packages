+{
+    return false;
+}
+
+TermuxGuiInputBackend::TermuxGuiInputBackend(TermuxGuiBackend *backend)
+    : m_backend(backend)
+{
+}
+
+TermuxGuiInputBackend::~TermuxGuiInputBackend()
+{
+    if (m_eventThread.joinable()) {
+        m_eventThread.request_stop();
+        m_eventThread.join();
+    }
+    if (m_device) {
+        Q_EMIT deviceRemoved(m_device.get());
+    }
+}
+
+void TermuxGuiInputBackend::initialize()
+{
+    m_device = std::make_unique<TermuxGuiInputDevice>();
+    Q_EMIT deviceAdded(m_device.get());
+
+    if (tgui_send_touch_event(m_backend->connection(), m_backend->activity(), m_backend->surface(), true) != TGUI_ERR_OK) {
+        Q_EMIT deviceRemoved(m_device.get());
+        m_device.reset();
+        return;
+    }
+
+    m_eventThread = std::jthread([this](std::stop_token stop) {
+        while (!stop.stop_requested()) {
+            tgui_event event{};
+            bool available = false;
+            if (tgui_poll_event(m_backend->connection(), &event, &available) != TGUI_ERR_OK) {
+                break;
+            }
+            if (!available) {
+                QThread::msleep(1);
+                continue;
+            }
+            processEvent(event);
+            tgui_event_destroy(&event);
+        }
+    });
+}
+
+void TermuxGuiInputBackend::processEvent(const tgui_event &event)
+{
+    if (event.type == TGUI_EVENT_TOUCH && event.touch.id == m_backend->surface()) {
+        processTouch(event);
+    }
+}
+
+void TermuxGuiInputBackend::processTouch(const tgui_event &event)
+{
+    if (!m_device || event.touch.events == 0 || event.touch.num_pointers == 0) {
+        return;
+    }
+
+    TermuxGuiInputDevice *device = m_device.get();
+    const auto time = std::chrono::milliseconds(event.touch.time);
+
+    switch (event.touch.action) {
+    case TGUI_TOUCH_DOWN:
+    case TGUI_TOUCH_POINTER_DOWN:
+        if (event.touch.index < event.touch.num_pointers) {
+            const auto pointer = event.touch.pointers[0][event.touch.index];
+            const QPointF position(pointer.x, pointer.y);
+            QMetaObject::invokeMethod(device, [device, id = pointer.id, position, time] {
+                Q_EMIT device->touchDown(id, position, time, device);
+                Q_EMIT device->touchFrame(device);
+            }, Qt::QueuedConnection);
+        }
+        break;
+    case TGUI_TOUCH_UP:
+    case TGUI_TOUCH_POINTER_UP:
+        if (event.touch.index < event.touch.num_pointers) {
+            const auto pointer = event.touch.pointers[0][event.touch.index];
+            QMetaObject::invokeMethod(device, [device, id = pointer.id, time] {
+                Q_EMIT device->touchUp(id, time, device);
+                Q_EMIT device->touchFrame(device);
+            }, Qt::QueuedConnection);
+        }
+        break;
+    case TGUI_TOUCH_MOVE:
+        for (uint32_t eventIndex = 0; eventIndex < event.touch.events; ++eventIndex) {
+            for (uint32_t pointerIndex = 0; pointerIndex < event.touch.num_pointers; ++pointerIndex) {
+                const auto pointer = event.touch.pointers[eventIndex][pointerIndex];
+                const QPointF position(pointer.x, pointer.y);
+                QMetaObject::invokeMethod(device, [device, id = pointer.id, position, time] {
+                    Q_EMIT device->touchMotion(id, position, time, device);
+                }, Qt::QueuedConnection);
+            }
+        }
+        QMetaObject::invokeMethod(device, [device] {
+            Q_EMIT device->touchFrame(device);
+        }, Qt::QueuedConnection);
+        break;
+    case TGUI_TOUCH_CANCEL:
+        QMetaObject::invokeMethod(device, [device] {
+            Q_EMIT device->touchCanceled(device);
+            Q_EMIT device->touchFrame(device);
+        }, Qt::QueuedConnection);
+        break;
+    }
+}
+
+} // namespace KWin
+
+#include "moc_termuxgui_input.cpp"
