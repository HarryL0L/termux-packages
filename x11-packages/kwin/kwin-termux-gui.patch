+{
+    m_enabled = enabled;
+}
+
+bool TermuxGuiInputDevice::isKeyboard() const
+{
+    return false;
+}
+
+bool TermuxGuiInputDevice::isPointer() const
+{
+    return false;
+}
+
+bool TermuxGuiInputDevice::isTouchpad() const
+{
+    return false;
+}
+
+bool TermuxGuiInputDevice::isTouch() const
+{
+    return true;
+}
+
+bool TermuxGuiInputDevice::isTabletTool() const
+{
+    return false;
+}
+
+bool TermuxGuiInputDevice::isTabletPad() const
+{
+    return false;
+}
+
+bool TermuxGuiInputDevice::isTabletModeSwitch() const
+{
+    return false;
+}
+
