+#include "termuxgui_input.h"
+#include "termuxgui_backend.h"
+
+#include <QMetaObject>
+#include <QThread>
+
+namespace KWin
+{
+
+TermuxGuiInputDevice::TermuxGuiInputDevice(QObject *parent)
+    : InputDevice(parent)
+{
+}
+
