+TranslatorInputBackend::TranslatorInputBackend(TranslatorBackend *backend, QObject *parent)
+    : InputBackend(parent)
+    , m_backend(backend)
+    , m_device(new TranslatorInputDevice(this))
+{
+    connect(m_backend, &TranslatorBackend::touchEvent, this, [this](const tgui_event &event) {
+        const auto time = std::chrono::milliseconds(event.touch.time / 1000000);
+        if (event.touch.action == TGUI_TOUCH_CANCEL) {
+            Q_EMIT m_device->touchCanceled(m_device);
+            return;
+        }
+
+        if (event.touch.action == TGUI_TOUCH_DOWN || event.touch.action == TGUI_TOUCH_POINTER_DOWN) {
+            if (event.touch.index < event.touch.num_pointers) {
+                const auto &p = event.touch.pointers[0][event.touch.index];
+                Q_EMIT m_device->touchDown(p.id, QPointF(p.x, p.y), time, m_device);
+            }
+        } else if (event.touch.action == TGUI_TOUCH_UP || event.touch.action == TGUI_TOUCH_POINTER_UP) {
+            if (event.touch.index < event.touch.num_pointers) {
+                const auto &p = event.touch.pointers[0][event.touch.index];
+                Q_EMIT m_device->touchUp(p.id, time, m_device);
+            }
+        } else if (event.touch.action == TGUI_TOUCH_MOVE) {
+            for (uint32_t i = 0; i < event.touch.num_pointers; ++i) {
+                const auto &p = event.touch.pointers[0][i];
+                Q_EMIT m_device->touchMotion(p.id, QPointF(p.x, p.y), time, m_device);
+            }
+        }
+
+        if (event.touch.action != TGUI_TOUCH_CANCEL) {
+            Q_EMIT m_device->touchFrame(m_device);
+        }
+    });
+}
+
+void TranslatorInputBackend::initialize()
+{
+    Q_EMIT deviceAdded(m_device);
+}
