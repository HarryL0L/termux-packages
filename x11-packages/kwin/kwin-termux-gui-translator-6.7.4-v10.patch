+
+TranslatorQPainterLayer::TranslatorQPainterLayer(BackendOutput *output, TranslatorQPainterBackend *backend)
+    : OutputLayer(output, OutputLayerType::Primary)
+    , m_backend(backend)
+{
+}
+
+TranslatorQPainterLayer::~TranslatorQPainterLayer() = default;
+
+std::optional<OutputLayerBeginFrameInfo> TranslatorQPainterLayer::doBeginFrame()
+{
+    const QSize size = m_output->modeSize();
+    if (!m_swapchain || m_swapchain->size() != size) {
+        m_swapchain = std::make_unique<QPainterSwapchain>(
+            m_backend->graphicsBufferAllocator(), size, DRM_FORMAT_XRGB8888);
+    }
+
+    m_current = m_swapchain->acquire();
+    if (!m_current) {
+        return std::nullopt;
+    }
+
+    m_renderTime = std::make_unique<CpuRenderTimeQuery>();
+    return OutputLayerBeginFrameInfo{
+        .renderTarget = RenderTarget(m_current->view()->image()),
+        .repaint = Region::infinite(),
+    };
+}
+
+bool TranslatorQPainterLayer::doEndFrame(const Region &, const Region &, OutputFrame *frame)
+{
+    if (m_renderTime) {
+        m_renderTime->end();
+        frame->addRenderTimeQuery(std::move(m_renderTime));
+    }
+    return true;
+}
+
+QImage *TranslatorQPainterLayer::image() const
+{
+    return m_current ? m_current->view()->image() : nullptr;
+}
+
+DrmDevice *TranslatorQPainterLayer::scanoutDevice() const
+{
+    return nullptr;
+}
+
+FormatModifierMap TranslatorQPainterLayer::supportedDrmFormats() const
+{
+    return {{DRM_FORMAT_XRGB8888, {DRM_FORMAT_MOD_LINEAR}}};
+}
+
+void TranslatorQPainterLayer::releaseBuffers()
+{
+    m_current.reset();
+    m_swapchain.reset();
+}
+
+TranslatorQPainterBackend::TranslatorQPainterBackend(TranslatorBackend *backend)
+    : m_backend(backend)
+    , m_allocator(std::make_unique<ShmGraphicsBufferAllocator>())
+{
+    for (BackendOutput *output : backend->outputs()) {
+        auto *translatorOutput = static_cast<TranslatorOutput *>(output);
+        translatorOutput->setObjectName(QStringLiteral("Termux:GUI output"));
+        translatorOutput->setLayer(std::make_unique<TranslatorQPainterLayer>(output, this));
+    }
+}
+
+TranslatorQPainterBackend::~TranslatorQPainterBackend() = default;
+
+GraphicsBufferAllocator *TranslatorQPainterBackend::graphicsBufferAllocator() const
+{
+    return m_allocator.get();
+}
+
+QList<OutputLayer *> TranslatorQPainterBackend::compatibleOutputLayers(BackendOutput *output)
+{
+    auto *translatorOutput = static_cast<TranslatorOutput *>(output);
+    return {translatorOutput->layer()};
+}
