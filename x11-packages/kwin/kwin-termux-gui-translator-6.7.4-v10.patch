+
+TranslatorBackend::TranslatorBackend(const Options &options, QObject *parent)
+    : OutputBackend(parent)
+    , m_options(options)
+{
+}
+
+TranslatorBackend::~TranslatorBackend()
+{
+    m_eventTimer.stop();
+    if (m_connection) {
+        tgui_connection_destroy(m_connection);
+        m_connection = nullptr;
+    }
+}
+
+bool TranslatorBackend::initialize()
+{
+    tgui_err err = tgui_connection_create(&m_connection);
+    if (err != 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Unable to connect to Termux:GUI:" << err;
+        return false;
+    }
+
+    err = tgui_activity_create(m_connection, &m_activity, TGUI_ACTIVITY_NORMAL, nullptr, false);
+    if (err != 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Unable to create Termux:GUI activity:" << err;
+        return false;
+    }
+
+    err = tgui_create_surface_view(m_connection, m_activity, &m_view, nullptr, TGUI_VIS_VISIBLE, false);
+    if (err != 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Unable to create Termux:GUI SurfaceView:" << err;
+        return false;
+    }
+
+    err = tgui_set_clickable(m_connection, m_activity, m_view, true);
+    if (err != 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Unable to make SurfaceView clickable:" << err;
+        return false;
+    }
+
+    err = tgui_send_touch_event(m_connection, m_activity, m_view, true);
+    if (err != 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Unable to enable SurfaceView touch:" << err;
+        return false;
+    }
+
+    err = tgui_surface_view_config(
+        m_connection, m_activity, m_view,
+        0xff000000,
+        TGUI_MISMATCH_STICK_TOPLEFT,
+        TGUI_MISMATCH_STICK_TOPLEFT,
+        60.0f);
+
+    // Query the actual Android SurfaceView size immediately. The initial KWin
+    // size is only a fallback and must not force a 1024x768 buffer onto a
+    // differently sized phone surface.
+    float width = 0;
+    float height = 0;
+    if (tgui_get_dimensions(m_connection, m_activity, m_view, TGUI_UNIT_PX, &width, &height) == TGUI_ERR_OK
+        && width > 0 && height > 0) {
+        m_options.size = QSize(qRound(width), qRound(height));
+    }
+    if (err != 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Unable to configure SurfaceView:" << err;
+        return false;
+    }
+
+    m_output = std::make_unique<TranslatorOutput>(
+        this, m_options.size, m_options.scale);
+
+    m_eventTimer.setInterval(1);
+    connect(&m_eventTimer, &QTimer::timeout, this, &TranslatorBackend::pollEvents);
+    m_eventTimer.start();
+
+    Q_EMIT outputAdded(m_output.get());
+    Q_EMIT outputsQueried();
+    return true;
+}
+
+void TranslatorBackend::pollEvents()
+{
+    if (!m_connection) {
+        return;
+    }
+
+    for (;;) {
+        tgui_event event;
+        bool available = false;
+        const tgui_err err = tgui_poll_event(m_connection, &event, &available);
+        if (err != 0 || !available) {
+            return;
+        }
+
+        switch (event.type) {
+        case TGUI_EVENT_FRAME_COMPLETE:
+            if (event.frame.id == m_view) {
+                Q_EMIT frameComplete(event.frame.timestamp);
+            }
+            break;
+        case TGUI_EVENT_SURFACE_CHANGED:
+            if (event.surfaceChanged.id == m_view) {
+                Q_EMIT surfaceChanged(QSize(event.surfaceChanged.width, event.surfaceChanged.height));
+            }
+            break;
+        case TGUI_EVENT_TOUCH:
+            if (event.touch.id == m_view) {
+                Q_EMIT touchEvent(event);
+            }
+            break;
+        case TGUI_EVENT_DESTROY:
+            break;
+        default:
+            break;
+        }
+
+        tgui_event_destroy(&event);
+    }
+}
+
+std::unique_ptr<QPainterBackend> TranslatorBackend::createQPainterBackend()
+{
+    return std::make_unique<TranslatorQPainterBackend>(this);
+}
+
+std::unique_ptr<InputBackend> TranslatorBackend::createInputBackend()
+{
+    return std::make_unique<TranslatorInputBackend>(this);
+}
+
+QList<BackendOutput *> TranslatorBackend::outputs() const
+{
+    if (m_output) {
+        return {m_output.get()};
+    }
+    return {};
+}
+
+QList<CompositingType> TranslatorBackend::supportedCompositors() const
+{
+    return {QPainterCompositing};
+}
+
+EglDisplay *TranslatorBackend::sceneEglDisplayObject() const
+{
+    return nullptr;
+}
+
+} // namespace KWin
+
+#include "moc_translator_backend.cpp"
