diff -ruN orig/src/backends/translator/translator_output.cpp src/src/backends/translator/translator_output.cpp
--- orig/src/backends/translator/translator_output.cpp	1970-01-01 00:00:00.000000000 +0000
+++ src/src/backends/translator/translator_output.cpp	2026-08-20 07:49:09.879630643 +0000
@@ -0,0 +1,310 @@
+#include "translator_output.h"
+
+#include "core/outputconfiguration.h"
+#include "core/outputlayer.h"
+#include "core/renderloop.h"
+#include "translator_backend.h"
+#include "translator_qpainter_backend.h"
+#include "utils/softwarevsyncmonitor.h"
+
+#include <android/hardware_buffer.h>
+#include <QDebug>
+
+#include <dlfcn.h>
+
+#include <algorithm>
+#include <cstring>
+
+namespace KWin
+{
+
+namespace
+{
+using DescribeFn = void (*)(const AHardwareBuffer *, AHardwareBuffer_Desc *);
+using LockFn = int (*)(AHardwareBuffer *, uint64_t, int32_t, const ARect *, void **);
+using UnlockFn = int (*)(AHardwareBuffer *, int32_t *);
+
+struct HardwareBufferApi
+{
+    void *handle = nullptr;
+    DescribeFn describe = nullptr;
+    LockFn lock = nullptr;
+    UnlockFn unlock = nullptr;
+
+    bool load()
+    {
+        if (handle) {
+            return describe && lock && unlock;
+        }
+        handle = dlopen("libandroid.so", RTLD_NOW | RTLD_LOCAL);
+        if (!handle) {
+            return false;
+        }
+        describe = reinterpret_cast<DescribeFn>(dlsym(handle, "AHardwareBuffer_describe"));
+        lock = reinterpret_cast<LockFn>(dlsym(handle, "AHardwareBuffer_lock"));
+        unlock = reinterpret_cast<UnlockFn>(dlsym(handle, "AHardwareBuffer_unlock"));
+        return describe && lock && unlock;
+    }
+};
+
+HardwareBufferApi &hardwareBufferApi()
+{
+    static HardwareBufferApi api;
+    return api;
+}
+}
+
+TranslatorOutput::TranslatorOutput(TranslatorBackend *backend, const QSize &size, qreal scale)
+    : BackendOutput()
+    , m_backend(backend)
+    , m_renderLoop(std::make_unique<RenderLoop>(this))
+    , m_vsyncMonitor(SoftwareVsyncMonitor::create())
+    , m_scale(scale)
+    , m_surfaceSize(size)
+{
+    connect(m_vsyncMonitor.get(), &VsyncMonitor::vblankOccurred, this, &TranslatorOutput::vblank);
+    connect(m_backend, &TranslatorBackend::frameComplete, this, [this](quint64) {
+        if (m_pending.empty()) {
+            return;
+        }
+        const PendingFrame pending = m_pending.front();
+        m_pending.pop_front();
+        if (pending.buffer >= 0) {
+            m_bufferValid[pending.buffer] = true;
+        }
+        pending.frame->presented(std::chrono::steady_clock::now().time_since_epoch(), PresentationMode::VSync);
+    });
+    connect(m_backend, &TranslatorBackend::surfaceChanged, this, &TranslatorOutput::setSurfaceSize);
+
+    setInformation(Information{
+        .name = QStringLiteral("Termux-1"),
+        .physicalSize = QSize(0, 0),
+        .capabilities = Capability::CustomModes,
+        .panelOrientation = OutputTransform::Kind::Normal,
+        .internal = true,
+    });
+
+    setState(State{
+        .scale = scale,
+        .modes = {std::make_shared<OutputMode>(OutputModeline(size, 60000, OutputModeline::Flag::Preferred))},
+        .currentMode = std::make_shared<OutputMode>(OutputModeline(size, 60000, OutputModeline::Flag::Preferred)),
+        .scaleSetting = scale,
+    });
+
+    m_renderLoop->setRefreshRate(60000);
+    m_vsyncMonitor->setRefreshRate(60000);
+    recreateBuffers(size);
+}
+
+void TranslatorOutput::setLayer(std::unique_ptr<TranslatorQPainterLayer> layer)
+{
+    m_layer = std::move(layer);
+}
+
+TranslatorOutput::~TranslatorOutput()
+{
+    m_layer.reset();
+    for (size_t i = 0; i < m_buffers.size(); ++i) {
+        if (m_bufferValid[i]) {
+            tgui_hardware_buffer_destroy(m_backend->connection(), &m_buffers[i]);
+            m_bufferValid[i] = false;
+        }
+    }
+}
+
+RenderLoop *TranslatorOutput::renderLoop() const
+{
+    return m_renderLoop.get();
+}
+
+bool TranslatorOutput::testPresentation(const std::shared_ptr<OutputFrame> &)
+{
+    return true;
+}
+
+int TranslatorOutput::findFreeBuffer() const
+{
+    for (size_t i = 0; i < m_buffers.size(); ++i) {
+        if (!m_bufferValid[i] || static_cast<int>(i) == m_transitionBuffer) {
+            continue;
+        }
+        const auto inFlight = std::find_if(m_pending.begin(), m_pending.end(), [i](const PendingFrame &p) {
+            return p.buffer == static_cast<int>(i);
+        });
+        if (inFlight == m_pending.end()) {
+            return static_cast<int>(i);
+        }
+    }
+    return -1;
+}
+
+void TranslatorOutput::recreateBuffers(const QSize &size)
+{
+    std::array<tgui_hardware_buffer, 8> newBuffers{};
+    std::array<bool, 8> newValid{};
+
+    if (!size.isEmpty()) {
+        for (size_t i = 0; i < newBuffers.size(); ++i) {
+            const tgui_err err = tgui_hardware_buffer_create(
+                m_backend->connection(), &newBuffers[i],
+                TGUI_HARDWARE_BUFFER_FORMAT_RGBA8888,
+                size.width(), size.height(),
+                TGUI_HARDWARE_BUFFER_CPU_NEVER,
+                TGUI_HARDWARE_BUFFER_CPU_OFTEN);
+            if (err != TGUI_ERR_OK) {
+                qWarning() << "Failed to allocate replacement Termux:GUI buffer" << i << err;
+                for (size_t j = 0; j < i; ++j) {
+                    if (newValid[j]) {
+                        tgui_hardware_buffer_destroy(m_backend->connection(), &newBuffers[j]);
+                    }
+                }
+                return;
+            }
+            newValid[i] = true;
+        }
+
+        /*
+         * Android can redraw the SurfaceView as part of the surface
+         * transition. Keep every old buffer alive until the replacement
+         * has been accepted, otherwise HardwareBufferSurfaceView can
+         * observe a closed HardwareBuffer from its surface callback.
+         */
+        const tgui_err err = tgui_surface_view_set_buffer(
+            m_backend->connection(), m_backend->activity(),
+            m_backend->surfaceView(), &newBuffers[0]);
+        if (err != TGUI_ERR_OK) {
+            qWarning() << "Failed to install replacement Termux:GUI buffer:" << err;
+            for (size_t i = 0; i < newBuffers.size(); ++i) {
+                if (newValid[i]) {
+                    tgui_hardware_buffer_destroy(m_backend->connection(), &newBuffers[i]);
+                }
+            }
+            return;
+        }
+    }
+
+    for (size_t i = 0; i < m_buffers.size(); ++i) {
+        if (m_bufferValid[i]) {
+            tgui_hardware_buffer_destroy(m_backend->connection(), &m_buffers[i]);
+        }
+    }
+
+    m_buffers = newBuffers;
+    m_bufferValid = newValid;
+    m_pending.clear();
+    m_transitionBuffer = newValid[0] ? 0 : -1;
+}
+void TranslatorOutput::setSurfaceSize(const QSize &size)
+{
+    if (size.isEmpty() || size == m_surfaceSize) {
+        return;
+    }
+
+    m_surfaceSize = size;
+    recreateBuffers(size);
+
+    const auto mode = std::make_shared<OutputMode>(OutputModeline(size, 60000, OutputModeline::Flag::Preferred));
+    setState(State{
+        .scale = m_scale,
+        .modes = {mode},
+        .currentMode = mode,
+        .scaleSetting = m_scale,
+    });
+    m_renderLoop->setRefreshRate(60000);
+    Q_EMIT changed();
+}
+
+bool TranslatorOutput::submit(const QImage &image, const std::shared_ptr<OutputFrame> &frame)
+{
+    const int index = findFreeBuffer();
+    if (index < 0) {
+        return false;
+    }
+
+    auto &api = hardwareBufferApi();
+    if (!api.load()) {
+        qWarning() << "Termux:GUI: AHardwareBuffer CPU API is unavailable";
+        return false;
+    }
+
+    AHardwareBuffer_Desc desc{};
+    api.describe(m_buffers[index].buffer, &desc);
+
+    void *mapped = nullptr;
+    const int rc = api.lock(
+        m_buffers[index].buffer,
+        AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN,
+        -1, nullptr, &mapped);
+    if (rc != 0 || !mapped) {
+        return false;
+    }
+
+    const int width = std::min<int>(image.width(), desc.width);
+    const int height = std::min<int>(image.height(), desc.height);
+    const uint32_t stride = desc.stride;
+    const uchar *src = image.constBits();
+    const int srcStride = image.bytesPerLine();
+    auto *dst = static_cast<uchar *>(mapped);
+
+    for (int y = 0; y < height; ++y) {
+        const uchar *srcRow = src + y * srcStride;
+        uchar *dstRow = dst + static_cast<size_t>(y) * stride * 4;
+        std::memcpy(dstRow, srcRow, static_cast<size_t>(width) * 4);
+    }
+
+    api.unlock(m_buffers[index].buffer, nullptr);
+
+    const tgui_err err = tgui_surface_view_set_buffer(
+        m_backend->connection(), m_backend->activity(),
+        m_backend->surfaceView(), &m_buffers[index]);
+    if (err != 0) {
+        return false;
+    }
+
+    m_pending.push_back(PendingFrame{index, frame});
+    if (index != m_transitionBuffer) {
+        m_transitionBuffer = -1;
+    }
+    return true;
+}
+
+bool TranslatorOutput::present(const QList<OutputLayer *> &, const std::shared_ptr<OutputFrame> &frame)
+{
+    if (!m_layer) {
+        return false;
+    }
+
+    if (!submit(*m_layer->image(), frame)) {
+        return false;
+    }
+
+    return true;
+}
+
+void TranslatorOutput::vblank(std::chrono::nanoseconds)
+{
+}
+
+void TranslatorOutput::applyChanges(const OutputConfiguration &config)
+{
+    auto props = config.constChangeSet(this);
+    if (!props) {
+        return;
+    }
+
+    Q_EMIT aboutToChange(props.get());
+    State next = m_state;
+    next.enabled = props->enabled.value_or(m_state.enabled);
+    next.transform = props->transform.value_or(m_state.transform);
+    next.position = props->pos.value_or(m_state.position);
+    next.scale = props->scale.value_or(m_state.scale);
+    next.scaleSetting = props->scaleSetting.value_or(m_state.scaleSetting);
+    next.uuid = props->uuid.value_or(m_state.uuid);
+    next.priority = props->priority.value_or(m_state.priority);
+    setState(next);
+    Q_EMIT changed();
+}
+
