+*/
+#include "translator_output.h"
+
+#include "core/outputconfiguration.h"
+#include "core/outputlayer.h"
+#include "core/renderbackend.h"
+#include "core/renderloop.h"
+#include "translator_backend.h"
+#include "translator_connection.h"
+#include "translator_qpainter_backend.h"
+
+namespace KWin
+{
+
+TranslatorOutput::TranslatorOutput(TranslatorBackend *backend, const QSize &size, qreal scale)
+    : BackendOutput()
+    , m_backend(backend)
+    , m_renderLoop(std::make_unique<RenderLoop>(this))
+    , m_scale(scale)
+{
+    setInformation(Information{
+        .name = QStringLiteral("Termux:GUI-1"),
+        .manufacturer = QStringLiteral("Termux"),
+        .model = QStringLiteral("Termux:GUI"),
+        .physicalSize = QSize(0, 0),
+        .capabilities = Capability::CustomModes,
+        .panelOrientation = OutputTransform::Kind::Normal,
+        .internal = true,
+    });
+
+    resize(size);
+}
+
+TranslatorOutput::~TranslatorOutput() = default;
+
+RenderLoop *TranslatorOutput::renderLoop() const
+{
+    return m_renderLoop.get();
+}
+
+void TranslatorOutput::resize(const QSize &size)
+{
+    if (!size.isValid()) {
+        return;
+    }
+
+    State next = m_state;
+    next.scale = m_scale;
+    next.scaleSetting = next.scale;
+    next.modes = {std::make_shared<OutputMode>(OutputModeline(size, 60000, OutputModeline::Flag::Preferred))};
+    next.currentMode = next.modes.front();
+    next.enabled = true;
+    setState(next);
+
+    m_renderLoop->setRefreshRate(60000);
+    Q_EMIT currentModeChanged();
+    Q_EMIT modesChanged();
+}
+
+bool TranslatorOutput::testPresentation(const std::shared_ptr<OutputFrame> &frame)
+{
+    Q_UNUSED(frame)
+    return true;
+}
+
+bool TranslatorOutput::present(const QList<OutputLayer *> &layersToUpdate, const std::shared_ptr<OutputFrame> &frame)
+{
+    if (!m_layer || layersToUpdate.isEmpty()) {
+        return false;
+    }
+
+    if (!m_backend->connection()->present(
+            m_layer->bufferIndex(),
+            *m_layer->image(),
+            frame)) {
+        return false;
+    }
+
+    return true;
+}
+
+void TranslatorOutput::setOutputLayer(std::unique_ptr<TranslatorQPainterLayer> layer)
+{
+    m_layer = std::move(layer);
+}
+
+TranslatorQPainterLayer *TranslatorOutput::outputLayer() const
+{
+    return m_layer.get();
+}
+
+} // namespace KWin
