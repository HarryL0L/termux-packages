@@ -0,0 +1,107 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_qpainter_backend.h"
+
+#include "core/drm_formats.h"
+#include "core/rendertarget.h"
+#include "translator_backend.h"
+#include "translator_connection.h"
+#include "translator_output.h"
+
+#include <drm_fourcc.h>
+
+namespace KWin
+{
+
+TranslatorQPainterLayer::TranslatorQPainterLayer(BackendOutput *output, TranslatorBackend *backend)
+    : OutputLayer(output, OutputLayerType::Primary)
+    , m_backend(backend)
+{
+}
+
+TranslatorQPainterLayer::~TranslatorQPainterLayer() = default;
+
+std::optional<OutputLayerBeginFrameInfo> TranslatorQPainterLayer::doBeginFrame()
+{
+    const QSize size = m_output->modeSize();
+    if (!size.isValid()) {
+        return std::nullopt;
+    }
+
+    if (m_image.size() != size || m_image.format() != QImage::Format_RGBA8888) {
+        m_image = QImage(size, QImage::Format_RGBA8888);
+        m_image.fill(Qt::black);
+    }
+
+    const auto buffer = m_backend->connection()->acquireBuffer(size);
+    if (!buffer) {
+        return std::nullopt;
+    }
+
+    m_bufferIndex = *buffer;
+    m_renderTime = std::make_unique<CpuRenderTimeQuery>();
+
+    return OutputLayerBeginFrameInfo{
+        .renderTarget = RenderTarget(&m_image),
+        .repaint = Region::infinite(),
+    };
+}
+
+bool TranslatorQPainterLayer::doEndFrame(const Region &renderedDeviceRegion, const Region &damagedDeviceRegion, OutputFrame *frame)
+{
+    Q_UNUSED(renderedDeviceRegion)
+    Q_UNUSED(damagedDeviceRegion)
+    Q_UNUSED(frame)
+
+    if (m_renderTime) {
+        m_renderTime->end();
+        if (frame) {
+            frame->addRenderTimeQuery(std::move(m_renderTime));
+        }
+    }
+    return m_bufferIndex >= 0;
+}
+
+QImage *TranslatorQPainterLayer::image()
+{
+    return &m_image;
+}
+
+int TranslatorQPainterLayer::bufferIndex() const
+{
+    return m_bufferIndex;
+}
+
+DrmDevice *TranslatorQPainterLayer::scanoutDevice() const
+{
+    return nullptr;
+}
+
+FormatModifierMap TranslatorQPainterLayer::supportedDrmFormats() const
+{
+    return {};
+}
+
+void TranslatorQPainterLayer::releaseBuffers()
+{
+    m_bufferIndex = -1;
+}
+
+TranslatorQPainterBackend::TranslatorQPainterBackend(TranslatorBackend *backend)
+    : m_backend(backend)
+{
+    m_backend->output()->setOutputLayer(std::make_unique<TranslatorQPainterLayer>(m_backend->output(), backend));
+}
+
+TranslatorQPainterBackend::~TranslatorQPainterBackend() = default;
+
+QList<OutputLayer *> TranslatorQPainterBackend::compatibleOutputLayers(BackendOutput *output)
+{
+    if (output == m_backend->output()) {
+        return {m_backend->output()->outputLayer()};
+    }
+    return {};
+}
+
+} // namespace KWin
