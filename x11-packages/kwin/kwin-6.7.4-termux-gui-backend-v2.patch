diff --git a/src/backends/translator/translator_connection.cpp b/src/backends/translator/translator_connection.cpp
new file mode 100644
index 0000000..f107546
--- /dev/null
+++ b/src/backends/translator/translator_connection.cpp
@@ -0,0 +1,320 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_connection.h"
+
+#include "core/renderbackend.h"
+
+#include <QDebug>
+
+#include <android/hardware_buffer.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+
+namespace KWin
+{
+
+static std::chrono::microseconds eventTime(uint64_t timestamp)
+{
+    // Termux:GUI timestamps are only used for input ordering. KWin expects
+    // monotonic microseconds, so use the local monotonic clock.
+    Q_UNUSED(timestamp)
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+        std::chrono::steady_clock::now().time_since_epoch());
+}
+
+TranslatorConnection::TranslatorConnection(QObject *parent)
+    : QObject(parent)
+{
+    m_eventTimer.setInterval(1);
+    m_eventTimer.setTimerType(Qt::PreciseTimer);
+    connect(&m_eventTimer, &QTimer::timeout, this, &TranslatorConnection::processEvents);
+}
+
+TranslatorConnection::~TranslatorConnection()
+{
+    m_eventTimer.stop();
+
+    if (m_connection) {
+        for (Buffer &buffer : m_buffers) {
+            if (buffer.valid) {
+                tgui_hardware_buffer_destroy(m_connection, &buffer.buffer);
+            }
+        }
+        m_buffers.clear();
+
+        tgui_connection_destroy(m_connection);
+        m_connection = nullptr;
+    }
+}
+
+bool TranslatorConnection::initialize(const QSize &initialSize)
+{
+    if (tgui_connection_create(&m_connection) != TGUI_ERR_OK) {
+        qWarning() << "Termux:GUI: failed to connect";
+        m_connection = nullptr;
+        return false;
+    }
+
+    if (tgui_activity_create(m_connection, &m_activity, TGUI_ACTIVITY_NORMAL, nullptr, false) != TGUI_ERR_OK) {
+        qWarning() << "Termux:GUI: failed to create Activity";
+        tgui_connection_destroy(m_connection);
+        m_connection = nullptr;
+        return false;
+    }
+
+    m_surfaceSize = initialSize;
+    m_ready = false;
+    m_eventTimer.start();
+    return true;
+}
+
+bool TranslatorConnection::ready() const
+{
+    return m_ready && m_view != -1 && !m_buffers.empty();
+}
+
+QSize TranslatorConnection::surfaceSize() const
+{
+    return m_surfaceSize;
+}
+
+void TranslatorConnection::processEvents()
+{
+    if (!m_connection) {
+        return;
+    }
+
+    for (;;) {
+        tgui_event event;
+        bool available = false;
+        if (tgui_poll_event(m_connection, &event, &available) != TGUI_ERR_OK || !available) {
+            break;
+        }
+
+        switch (event.type) {
+        case TGUI_EVENT_CREATE:
+            if (m_view == -1 && event.activity == m_activity) {
+                if (tgui_create_surface_view(m_connection, m_activity, &m_view, nullptr, TGUI_VIS_VISIBLE, false) != TGUI_ERR_OK) {
+                    qWarning() << "Termux:GUI: failed to create SurfaceView";
+                    m_view = -1;
+                    break;
+                }
+
+                if (tgui_set_clickable(m_connection, m_activity, m_view, true) != TGUI_ERR_OK
+                    || tgui_send_touch_event(m_connection, m_activity, m_view, true) != TGUI_ERR_OK) {
+                    qWarning() << "Termux:GUI: failed to enable SurfaceView input";
+                    break;
+                }
+
+                tgui_surface_view_config(m_connection, m_activity, m_view,
+                                         0xff000000,
+                                         TGUI_MISMATCH_STICK_TOPLEFT,
+                                         TGUI_MISMATCH_STICK_TOPLEFT,
+                                         60.0f);
+            }
+            break;
+
+        case TGUI_EVENT_SURFACE_CHANGED:
+            if (event.surfaceChanged.id == m_view) {
+                const QSize size(event.surfaceChanged.width, event.surfaceChanged.height);
+                if (size.isValid() && size != m_surfaceSize) {
+                    recreateBuffers(size);
+                    m_surfaceSize = size;
+                    Q_EMIT surfaceSizeChanged(size);
+                } else if (!m_ready && size.isValid()) {
+                    recreateBuffers(size);
+                    m_surfaceSize = size;
+                    Q_EMIT surfaceSizeChanged(size);
+                }
+            }
+            break;
+
+        case TGUI_EVENT_TOUCH:
+            if (event.touch.id == m_view) {
+                const auto timestamp = eventTime(event.touch.time);
+                for (uint32_t batch = 0; batch < event.touch.events; ++batch) {
+                    for (uint32_t i = 0; i < event.touch.num_pointers; ++i) {
+                        const tgui_touch_pointer &pointer = event.touch.pointers[batch][i];
+                        const QPointF pos(pointer.x, pointer.y);
+
+                        switch (event.touch.action) {
+                        case TGUI_TOUCH_DOWN:
+                        case TGUI_TOUCH_POINTER_DOWN:
+                            Q_EMIT touchDown(pointer.id, pos, timestamp);
+                            break;
+                        case TGUI_TOUCH_MOVE:
+                            Q_EMIT touchMotion(pointer.id, pos, timestamp);
+                            break;
+                        case TGUI_TOUCH_UP:
+                        case TGUI_TOUCH_POINTER_UP:
+                            Q_EMIT touchUp(pointer.id, timestamp);
+                            break;
+                        case TGUI_TOUCH_CANCEL:
+                            Q_EMIT touchCancel();
+                            break;
+                        }
+                    }
+                    Q_EMIT touchFrame();
+                }
+            }
+            break;
+
+        case TGUI_EVENT_KEY:
+            if (event.activity == m_activity) {
+                Q_EMIT keyChanged(event.key.code, event.key.down, eventTime(0));
+            }
+            break;
+
+        case TGUI_EVENT_FRAME_COMPLETE:
+            if (event.frame.id == m_view) {
+                completeFrame();
+            }
+            break;
+
+        case TGUI_EVENT_DESTROY:
+            m_ready = false;
+            break;
+
+        default:
+            break;
+        }
+
+        tgui_event_destroy(&event);
+    }
+}
+
+void TranslatorConnection::recreateBuffers(const QSize &size)
+{
+    if (!m_connection || !size.isValid()) {
+        return;
+    }
+
+    for (Buffer &buffer : m_buffers) {
+        if (buffer.valid) {
+            tgui_hardware_buffer_destroy(m_connection, &buffer.buffer);
+        }
+    }
+    m_buffers.clear();
+    m_inFlight.clear();
+
+    constexpr int bufferCount = 8;
+    m_buffers.resize(bufferCount);
+
+    for (Buffer &buffer : m_buffers) {
+        const tgui_err error = tgui_hardware_buffer_create(
+            m_connection,
+            &buffer.buffer,
+            TGUI_HARDWARE_BUFFER_FORMAT_RGBX8888,
+            size.width(),
+            size.height(),
+            TGUI_HARDWARE_BUFFER_CPU_NEVER,
+            TGUI_HARDWARE_BUFFER_CPU_OFTEN);
+
+        if (error != TGUI_ERR_OK) {
+            qWarning() << "Termux:GUI: failed to create HardwareBuffer:" << error;
+            for (Buffer &created : m_buffers) {
+                if (created.valid) {
+                    tgui_hardware_buffer_destroy(m_connection, &created.buffer);
+                    created.valid = false;
+                }
+            }
+            m_buffers.clear();
+            m_ready = false;
+            return;
+        }
+
+        buffer.valid = true;
+        buffer.inUse = false;
+    }
+
+    m_ready = true;
+}
+
+std::optional<int> TranslatorConnection::acquireBuffer(const QSize &size)
+{
+    if (!ready() || size != m_surfaceSize) {
+        return std::nullopt;
+    }
+
+    for (int i = 0; i < int(m_buffers.size()); ++i) {
+        if (m_buffers[i].valid && !m_buffers[i].inUse) {
+            m_buffers[i].inUse = true;
+            return i;
+        }
+    }
+
+    return std::nullopt;
+}
+
+bool TranslatorConnection::present(int index, const QImage &image, const std::shared_ptr<OutputFrame> &frame)
+{
+    if (index < 0 || index >= int(m_buffers.size()) || !m_buffers[index].valid || !m_view) {
+        return false;
+    }
+
+    Buffer &buffer = m_buffers[index];
+
+    AHardwareBuffer_Desc desc;
+    AHardwareBuffer_describe(buffer.buffer.buffer, &desc);
+
+    void *mapped = nullptr;
+    if (AHardwareBuffer_lock(buffer.buffer.buffer,
+                             AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN,
+                             -1, nullptr, &mapped) != 0 || !mapped) {
+        buffer.inUse = false;
+        return false;
+    }
+
+    const int width = std::min<int>(image.width(), desc.width);
+    const int height = std::min<int>(image.height(), desc.height);
+    const int sourceStride = image.bytesPerLine();
+    const int destinationStride = int(desc.stride) * 4;
+
+    const uchar *source = image.constBits();
+    uchar *destination = static_cast<uchar *>(mapped);
+
+    // Termux:GUI's tested RGBX presentation has a bottom-up row orientation.
+    for (int y = 0; y < height; ++y) {
+        const uchar *src = source + y * sourceStride;
+        uchar *dst = destination + (height - 1 - y) * destinationStride;
+        std::memcpy(dst, src, width * 4);
+    }
+
+    AHardwareBuffer_unlock(buffer.buffer.buffer, nullptr);
+
+    if (tgui_surface_view_set_buffer(m_connection, m_activity, m_view, &buffer.buffer) != TGUI_ERR_OK) {
+        buffer.inUse = false;
+        return false;
+    }
+
+    m_inFlight.emplace_back(index, frame);
+    return true;
+}
+
+void TranslatorConnection::completeFrame()
+{
+    if (m_inFlight.empty()) {
+        return;
+    }
+
+    const auto [index, frame] = std::move(m_inFlight.front());
+    m_inFlight.pop_front();
+
+    if (index >= 0 && index < int(m_buffers.size())) {
+        m_buffers[index].inUse = false;
+    }
+
+    if (frame) {
+        frame->presented(
+            std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()),
+            PresentationMode::VSync);
+    }
+}
+
+} // namespace KWin
+
+#include "moc_translator_connection.cpp"
diff --git a/src/backends/translator/translator_connection.h b/src/backends/translator/translator_connection.h
new file mode 100644
index 0000000..69203e9
