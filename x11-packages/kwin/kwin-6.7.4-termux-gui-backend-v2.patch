+++ b/src/backends/translator/translator_connection.h
@@ -0,0 +1,73 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QObject>
+#include <QImage>
+#include <QSize>
+#include <QTimer>
+
+#include <deque>
+#include <optional>
+#include <vector>
+#include <memory>
+
+extern "C" {
+#include <termuxgui/termuxgui.h>
+}
+
+namespace KWin
+{
+
+class OutputFrame;
+
+class TranslatorConnection : public QObject
+{
+    Q_OBJECT
+public:
+    explicit TranslatorConnection(QObject *parent = nullptr);
+    ~TranslatorConnection() override;
+
+    bool initialize(const QSize &initialSize);
+
+    bool ready() const;
+    QSize surfaceSize() const;
+
+    std::optional<int> acquireBuffer(const QSize &size);
+    bool present(int index, const QImage &image, const std::shared_ptr<OutputFrame> &frame);
+
+Q_SIGNALS:
+    void surfaceSizeChanged(const QSize &size);
+    void touchDown(int id, const QPointF &pos, std::chrono::microseconds time);
+    void touchMotion(int id, const QPointF &pos, std::chrono::microseconds time);
+    void touchUp(int id, std::chrono::microseconds time);
+    void touchCancel();
+    void touchFrame();
+    void keyChanged(quint32 key, bool down, std::chrono::microseconds time);
+
+private Q_SLOTS:
+    void processEvents();
+
+private:
+    struct Buffer {
+        tgui_hardware_buffer buffer{};
+        bool valid = false;
+        bool inUse = false;
+    };
+
+    void recreateBuffers(const QSize &size);
+    void completeFrame();
+
+    tgui_connection m_connection = nullptr;
+    tgui_activity m_activity = -1;
+    tgui_view m_view = -1;
+
+    std::vector<Buffer> m_buffers;
+    std::deque<std::pair<int, std::shared_ptr<OutputFrame>>> m_inFlight;
+    QSize m_surfaceSize;
+    QTimer m_eventTimer;
+    bool m_ready = false;
+};
+
+} // namespace KWin
diff --git a/src/backends/translator/translator_input.cpp b/src/backends/translator/translator_input.cpp
new file mode 100644
index 0000000..a6c6694
--- /dev/null
+++ b/src/backends/translator/translator_input.cpp
@@ -0,0 +1,117 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_input.h"
+
+#include "core/inputdevice.h"
+#include "translator_connection.h"
+#include "translator_output.h"
+
+#include <linux/input-event-codes.h>
+
+namespace KWin
+{
+
+class TranslatorInputDevice : public InputDevice
+{
+public:
+    explicit TranslatorInputDevice(TranslatorOutput *output)
+        : InputDevice(nullptr)
+        , m_output(output)
+    {
+    }
+
+    QString name() const override
+    {
+        return QStringLiteral("Termux:GUI Touchscreen");
+    }
+
+    bool isEnabled() const override { return m_enabled; }
+    void setEnabled(bool enabled) override { m_enabled = enabled; }
+
+    bool isKeyboard() const override { return true; }
+    bool isPointer() const override { return false; }
+    bool isTouchpad() const override { return false; }
+    bool isTouch() const override { return true; }
+    bool isTabletTool() const override { return false; }
+    bool isTabletPad() const override { return false; }
+    bool isTabletModeSwitch() const override { return false; }
+    bool isLidSwitch() const override { return false; }
+
+private:
+    bool m_enabled = true;
+    TranslatorOutput *m_output;
+};
+
+static quint32 androidToLinuxKey(quint32 code)
+{
+    // Android key codes are not Linux evdev codes. Cover the keys most
+    // useful for a first KWin/Plasma session and pass through Linux-like
+    // codes for anything outside the Android alphabet range.
+    if (code >= 29 && code <= 54) {
+        return KEY_A + (code - 29);
+    }
+    if (code >= 7 && code <= 16) {
+        return KEY_0 + (code - 7);
+    }
+
+    switch (code) {
+    case 4: return KEY_ESC;       // BACK
+    case 19: return KEY_UP;
+    case 20: return KEY_DOWN;
+    case 21: return KEY_LEFT;
+    case 22: return KEY_RIGHT;
+    case 61: return KEY_TAB;
+    case 62: return KEY_SPACE;
+    case 66: return KEY_ENTER;
+    case 67: return KEY_BACKSPACE;
+    case 111: return KEY_ESC;     // ESCAPE
+    case 112: return KEY_DELETE;
+    default: return code;
+    }
+}
+
+TranslatorInputBackend::TranslatorInputBackend(TranslatorConnection *connection, TranslatorOutput *output)
+    : m_device(new TranslatorInputDevice(output))
+{
+    connect(connection, &TranslatorConnection::touchDown, m_device,
+            [this](int id, const QPointF &pos, std::chrono::microseconds time) {
+                Q_EMIT m_device->touchDown(id, pos, time, m_device);
+            });
+    connect(connection, &TranslatorConnection::touchMotion, m_device,
+            [this](int id, const QPointF &pos, std::chrono::microseconds time) {
+                Q_EMIT m_device->touchMotion(id, pos, time, m_device);
+            });
+    connect(connection, &TranslatorConnection::touchUp, m_device,
+            [this](int id, std::chrono::microseconds time) {
+                Q_EMIT m_device->touchUp(id, time, m_device);
+            });
+    connect(connection, &TranslatorConnection::touchCancel, m_device,
+            [this]() {
+                Q_EMIT m_device->touchCanceled(m_device);
+            });
+    connect(connection, &TranslatorConnection::touchFrame, m_device,
+            [this]() {
+                Q_EMIT m_device->touchFrame(m_device);
+            });
+    connect(connection, &TranslatorConnection::keyChanged, m_device,
+            [this](quint32 code, bool down, std::chrono::microseconds time) {
+                Q_EMIT m_device->keyChanged(
+                    androidToLinuxKey(code),
+                    down ? KeyboardKeyState::Pressed : KeyboardKeyState::Released,
+                    time,
+                    m_device);
+            });
+
+    Q_EMIT deviceAdded(m_device);
+}
+
+TranslatorInputBackend::~TranslatorInputBackend()
+{
+    Q_EMIT deviceRemoved(m_device);
+    delete m_device;
+}
+
+} // namespace KWin
+
+#include "moc_translator_input.cpp"
