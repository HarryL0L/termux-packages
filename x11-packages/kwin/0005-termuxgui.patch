+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    Minimal native client for the Termux:GUI protobuf protocol. Only the
+    handful of methods and events the KWin backend needs are implemented,
+    with a hand-rolled protobuf wire codec, so no libtermuxgui or libprotobuf
+    is required.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QByteArray>
+#include <QImage>
+#include <QPoint>
+#include <QSize>
+#include <QString>
+
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <optional>
+#include <thread>
+#include <vector>
+
+struct AHardwareBuffer;
+
+namespace KWin
+{
+
+struct TermuxGuiHardwareBuffer
+{
+    AHardwareBuffer *buffer = nullptr;
+    int id = -1;
+};
+
+enum class TermuxGuiTouchAction {
+    Down = 0,
+    Up = 1,
+    PointerDown = 2,
+    PointerUp = 3,
+    Cancel = 4,
+    Move = 5,
+};
+
+struct TermuxGuiTouchPoint
+{
+    int id;
+    int x;
+    int y;
+};
+
+struct TermuxGuiTouchEvent
+{
+    TermuxGuiTouchAction action = TermuxGuiTouchAction::Cancel;
+    std::vector<TermuxGuiTouchPoint> points;
+    uint32_t index = 0;
+    uint64_t time = 0;
+};
+
+enum class TermuxGuiPointerAction {
+    Move = 0,
+    ButtonDown = 1,
+    ButtonUp = 2,
+    Scroll = 3,
+};
+
+enum class TermuxGuiPointerButton {
+    None = 0,
+    Left = 1,
+    Right = 2,
+    Middle = 3,
+};
+
+struct TermuxGuiPointerEvent
+{
+    TermuxGuiPointerAction action = TermuxGuiPointerAction::Move;
+    int x = 0;
+    int y = 0;
+    TermuxGuiPointerButton button = TermuxGuiPointerButton::None;
+    float scrollX = 0;
+    float scrollY = 0;
+};
+
+struct TermuxGuiKeyEvent
+{
+    uint32_t code = 0;
+    uint32_t modifiers = 0;
+    uint32_t codePoint = 0;
+    bool down = false;
+    uint32_t flags = 0;
+};
+
+/**
+ * One event from the event socket. Only the fields KWin cares about are decoded.
+ */
+struct TermuxGuiEvent
+{
+    enum class Type {
+        Create,
+        Destroy,
+        Touch,
+        SurfaceChanged,
+        Pointer,
+        Key,
+    };
+    Type type;
+    int aid = -1;
+    int view = -1;
+    // SurfaceChanged
+    QSize size;
+    // Touch
+    TermuxGuiTouchEvent touch;
+    // Pointer
+    TermuxGuiPointerEvent pointer;
+    // Key
+    TermuxGuiKeyEvent key;
+};
+
+class TermuxGuiConnection
+{
+public:
+    TermuxGuiConnection();
+    ~TermuxGuiConnection();
+
+    TermuxGuiConnection(const TermuxGuiConnection &) = delete;
+    TermuxGuiConnection &operator=(const TermuxGuiConnection &) = delete;
+
+    /**
+     * Opens the two sockets, asks the Termux:GUI app to connect (through
+     * `am broadcast`) and negotiates the binary protocol.
+     */
+    bool connect(int timeoutMs = 10000);
+    bool isConnected() const;
+    void disconnect();
+
+    /**
+     * Starts the event reader thread. @p handler is called on that thread.
+     */
+    void startEventThread(std::function<void(const TermuxGuiEvent &)> handler);
+
+    // activities
+    std::optional<int> newActivity();
+    bool setOrientationFullUser(int aid);
+    bool configureInsetsNoBars(int aid);
+
+    // views
+    std::optional<int> createSurfaceView(int aid, bool keyboard);
+    bool setMatchParent(int aid, int view);
+    bool setClickable(int aid, int view, bool clickable);
+    bool sendTouchEvents(int aid, int view, bool send);
+    bool surfaceViewConfig(int aid, int view, uint32_t backgroundColor, float framerate);
+
+    // hardware buffers
+    bool createHardwareBuffer(TermuxGuiHardwareBuffer *buffer, uint32_t width, uint32_t height);
+    bool destroyHardwareBuffer(TermuxGuiHardwareBuffer *buffer);
+    bool surfaceViewSetBuffer(int aid, int view, const TermuxGuiHardwareBuffer &buffer);
+
+    // trackpad / cursor (Termux:GUI with SurfaceView cursor support)
+    bool surfaceViewTrackpad(int aid, int view, bool enabled, float sensitivity, float scrollSensitivity);
+    bool surfaceViewSetCursor(int aid, int view, bool visible, std::optional<QPoint> position);
+    /**
+     * @p pixels must be width*height*4 bytes of non-premultiplied RGBA8888, top-down.
+     */
+    bool surfaceViewSetCursorImage(int aid, int view, const QSize &size, const QPoint &hotspot, const QByteArray &pixels);
+
+private:
+    class Private;
+    Private *const d;
+};
+
+} // namespace KWin
