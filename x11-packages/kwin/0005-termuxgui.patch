+TermuxGuiInputBackend::TermuxGuiInputBackend(VirtualBackend *backend, TermuxGuiIntegration *integration, QObject *parent)
+    : InputBackend(parent)
+    , m_backend(backend)
+    , m_integration(integration)
+{
+}
+
+void TermuxGuiInputBackend::initialize()
+{
+    const auto outputs = m_backend->outputs();
+    if (outputs.isEmpty()) {
+        return;
+    }
+    auto *output = qobject_cast<VirtualOutput *>(outputs.front());
+    if (!output) {
+        return;
+    }
+
+    m_touch = new TermuxGuiInputDevice(output, this);
+    connect(m_integration, &TermuxGuiIntegration::touchEvent, m_touch, &TermuxGuiInputDevice::handleTouch, Qt::QueuedConnection);
+    Q_EMIT deviceAdded(m_touch);
+
+    m_pointer = new TermuxGuiPointerDevice(output, m_integration, this);
+    connect(m_integration, &TermuxGuiIntegration::pointerEvent, m_pointer, &TermuxGuiPointerDevice::handlePointer, Qt::QueuedConnection);
+    Q_EMIT deviceAdded(m_pointer);
+}
