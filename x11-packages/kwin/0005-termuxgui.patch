+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    Minimal native client for the Termux:GUI protobuf protocol, see
+    termuxgui_protocol.h. Field numbers come from app/src/main/proto/GUIProt0.proto
+    of Termux:GUI.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "termuxgui_protocol.h"
+
+#include "virtual_logging.h"
+
+#include <QLibrary>
+#include <QProcess>
+#include <QRandomGenerator>
+
+#include <algorithm>
+#include <android/hardware_buffer.h>
+#include <cerrno>
+#include <cstddef>
+#include <arpa/inet.h>
+#include <cstring>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace KWin
+{
+
+namespace
+{
+
+// ---------------------------------------------------------------- protobuf
+
+class PbWriter
+{
+public:
+    void varint(uint64_t v)
+    {
+        while (v >= 0x80) {
+            m_buf.append(char((v & 0x7f) | 0x80));
+            v >>= 7;
+        }
+        m_buf.append(char(v));
+    }
+    void tag(int field, int wireType)
+    {
+        varint((uint64_t(field) << 3) | uint64_t(wireType));
+    }
+    void int32(int field, int32_t v)
+    {
+        tag(field, 0);
+        varint(uint64_t(int64_t(v)));
+    }
+    void uint32(int field, uint32_t v)
+    {
+        tag(field, 0);
+        varint(v);
+    }
+    void boolean(int field, bool v)
+    {
+        tag(field, 0);
+        varint(v ? 1 : 0);
+    }
+    void float32(int field, float v)
+    {
+        tag(field, 5);
+        uint32_t bits;
+        memcpy(&bits, &v, 4);
+        char le[4] = {char(bits & 0xff), char((bits >> 8) & 0xff), char((bits >> 16) & 0xff), char((bits >> 24) & 0xff)};
+        m_buf.append(le, 4);
+    }
+    void bytes(int field, const QByteArray &data)
+    {
+        tag(field, 2);
+        varint(uint64_t(data.size()));
+        m_buf.append(data);
+    }
+    void message(int field, const PbWriter &sub)
+    {
+        bytes(field, sub.m_buf);
+    }
+    const QByteArray &data() const
+    {
+        return m_buf;
+    }
+
+private:
+    QByteArray m_buf;
+};
+
+class PbReader
+{
+public:
+    PbReader(const char *data, qsizetype size)
+        : m_p(reinterpret_cast<const uint8_t *>(data))
+        , m_end(m_p + size)
+    {
+    }
+    explicit PbReader(const QByteArray &data)
+        : PbReader(data.constData(), data.size())
+    {
+    }
+
+    bool next(int &field, int &wireType)
+    {
+        if (m_p >= m_end || m_bad) {
+            return false;
+        }
+        const uint64_t key = varint();
+        if (m_bad) {
+            return false;
+        }
+        field = int(key >> 3);
+        wireType = int(key & 7);
+        return true;
+    }
+    uint64_t varint()
+    {
+        uint64_t result = 0;
+        int shift = 0;
+        while (m_p < m_end && shift < 64) {
+            const uint8_t b = *m_p++;
+            result |= uint64_t(b & 0x7f) << shift;
+            if (!(b & 0x80)) {
+                return result;
+            }
+            shift += 7;
+        }
+        m_bad = true;
+        return 0;
+    }
+    uint32_t fixed32()
+    {
+        if (m_end - m_p < 4) {
+            m_bad = true;
+            return 0;
+        }
+        uint32_t v = uint32_t(m_p[0]) | (uint32_t(m_p[1]) << 8) | (uint32_t(m_p[2]) << 16) | (uint32_t(m_p[3]) << 24);
+        m_p += 4;
+        return v;
+    }
+    float float32()
+    {
+        const uint32_t bits = fixed32();
+        float f;
+        memcpy(&f, &bits, 4);
+        return f;
+    }
+    PbReader sub()
+    {
+        const uint64_t len = varint();
+        if (m_bad || uint64_t(m_end - m_p) < len) {
+            m_bad = true;
+            return PbReader(nullptr, 0);
+        }
+        PbReader r(reinterpret_cast<const char *>(m_p), qsizetype(len));
+        m_p += len;
+        return r;
+    }
+    void skip(int wireType)
+    {
+        switch (wireType) {
+        case 0:
+            varint();
+            break;
+        case 1:
+            m_p += 8;
+            break;
+        case 2:
+            sub();
+            break;
+        case 5:
+            m_p += 4;
+            break;
+        default:
+            m_bad = true;
+            break;
+        }
+        if (m_p > m_end) {
+            m_bad = true;
+        }
+    }
+    bool bad() const
+    {
+        return m_bad;
+    }
+
+private:
+    const uint8_t *m_p;
+    const uint8_t *m_end;
+    bool m_bad = false;
+};
+
+// Method oneof field numbers (message Method)
+enum MethodField {
+    NewActivity = 16,
+    SetOrientation = 29,
+    ConfigureInsets = 42,
+    CreateSurfaceView = 130,
+    SetWidth = 206,
+    SetHeight = 207,
+    SetClickable = 234,
+    SendTouchEvent = 603,
+    CreateHardwareBuffer = 700,
+    DestroyHardwareBuffer = 701,
+    SurfaceViewSetBuffer = 702,
+    SurfaceViewConfig = 703,
+    SurfaceViewTrackpad = 704,
+    SurfaceViewSetCursor = 705,
+    SurfaceViewSetCursorImage = 706,
+};
+
+// Event oneof field numbers (message Event)
+enum EventField {
+    EvTouch = 2,
+    EvCreate = 16,
+    EvDestroy = 21,
+    EvKey = 48,
+    EvSurfaceChanged = 52,
+    EvPointer = 53,
+};
+
+PbWriter viewMsg(int aid, int id)
+{
+    PbWriter v;
+    v.int32(1, aid);
+    v.int32(2, id);
+    return v;
+}
+
+// ----------------------------------------------------------------- sockets
+
+bool writeAll(int fd, const char *data, qsizetype size)
+{
+    while (size > 0) {
+        const ssize_t n = ::write(fd, data, size_t(size));
+        if (n < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        data += n;
+        size -= n;
+    }
+    return true;
+}
+
+bool readAll(int fd, char *data, qsizetype size)
+{
+    while (size > 0) {
+        const ssize_t n = ::read(fd, data, size_t(size));
+        if (n < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        if (n == 0) {
+            return false;
+        }
+        data += n;
+        size -= n;
+    }
+    return true;
+}
+
+bool writeDelimited(int fd, const QByteArray &payload)
+{
+    PbWriter prefix;
+    prefix.varint(uint64_t(payload.size()));
+    return writeAll(fd, prefix.data().constData(), prefix.data().size()) && writeAll(fd, payload.constData(), payload.size());
+}
+
+std::optional<QByteArray> readDelimited(int fd)
+{
+    uint64_t len = 0;
+    int shift = 0;
+    for (;;) {
+        char b;
+        if (!readAll(fd, &b, 1)) {
+            return std::nullopt;
+        }
+        len |= uint64_t(uint8_t(b) & 0x7f) << shift;
+        if (!(uint8_t(b) & 0x80)) {
+            break;
+        }
+        shift += 7;
+        if (shift > 63) {
+            return std::nullopt;
+        }
+    }
+    if (len > (64u << 20)) {
+        return std::nullopt;
+    }
+    QByteArray data(qsizetype(len), Qt::Uninitialized);
+    if (!readAll(fd, data.data(), data.size())) {
+        return std::nullopt;
+    }
+    return data;
+}
+
+int listenAbstract(const QByteArray &name)
+{
+    const int fd = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0) {
+        return -1;
+    }
+    sockaddr_un addr{};
+    addr.sun_family = AF_UNIX;
+    addr.sun_path[0] = '\0';
+    memcpy(addr.sun_path + 1, name.constData(), size_t(name.size()));
+    const socklen_t len = socklen_t(offsetof(sockaddr_un, sun_path) + 1 + name.size());
+    if (::bind(fd, reinterpret_cast<sockaddr *>(&addr), len) < 0 || ::listen(fd, 1) < 0) {
+        ::close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+int acceptWithTimeout(int listenFd, int timeoutMs)
+{
+    pollfd pfd{listenFd, POLLIN, 0};
+    for (;;) {
+        const int r = ::poll(&pfd, 1, timeoutMs);
+        if (r < 0 && errno == EINTR) {
+            continue;
+        }
+        if (r <= 0) {
+            return -1;
+        }
+        break;
+    }
+    const int fd = ::accept4(listenFd, nullptr, nullptr, SOCK_CLOEXEC);
+    if (fd < 0) {
+        return -1;
+    }
+    ucred cred{};
+    socklen_t credLen = sizeof(cred);
+    if (::getsockopt(fd, SOL_SOCKET, SO_PEERCRED, &cred, &credLen) == 0 && cred.uid != ::getuid()) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] rejecting connection from uid %d", int(cred.uid));
+        ::close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+// ----------------------------------------------------- AHardwareBuffer API
+
+class HardwareBufferApi
+{
+public:
+    using RecvFn = int (*)(int, AHardwareBuffer **);
+    using ReleaseFn = void (*)(AHardwareBuffer *);
+
+    bool load()
+    {
+        if (m_tried) {
+            return m_recv && m_release;
+        }
+        m_tried = true;
+        if (!m_lib.load()) {
+            return false;
+        }
+        m_recv = reinterpret_cast<RecvFn>(m_lib.resolve("AHardwareBuffer_recvHandleFromUnixSocket"));
+        m_release = reinterpret_cast<ReleaseFn>(m_lib.resolve("AHardwareBuffer_release"));
+        return m_recv && m_release;
+    }
+    RecvFn recvFn() const
+    {
+        return m_recv;
+    }
+    ReleaseFn releaseFn() const
+    {
+        return m_release;
+    }
+
+private:
+    QLibrary m_lib{QStringLiteral("libandroid.so")};
+    RecvFn m_recv = nullptr;
+    ReleaseFn m_release = nullptr;
+    bool m_tried = false;
+};
+
+HardwareBufferApi &hardwareBufferApi()
+{
+    static HardwareBufferApi api;
+    return api;
+}
