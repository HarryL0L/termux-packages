+TermuxGuiIntegration::TermuxGuiIntegration(QObject *parent)
+    : QObject(parent)
+    , m_connection(std::make_unique<TermuxGuiConnection>())
+{
+    qRegisterMetaType<TermuxGuiTouchEvent>();
+    qRegisterMetaType<TermuxGuiPointerEvent>();
+
+    m_trackpad = qEnvironmentVariable("KWIN_TERMUX_GUI_TRACKPAD") != QStringLiteral("0");
+
+    if (!m_connection->connect()) {
+        m_connection.reset();
+        return;
+    }
+    const auto aid = m_connection->newActivity();
+    if (!aid) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] could not create the activity");
+        m_connection.reset();
+        return;
+    }
+    m_activity = *aid;
+    m_connection->setOrientationFullUser(m_activity);
+
+    m_valid = true;
+    m_connection->startEventThread([this](const TermuxGuiEvent &event) {
+        handleEvent(event);
+    });
+}
+
+TermuxGuiIntegration::~TermuxGuiIntegration()
+{
+    m_connection.reset();
+}
