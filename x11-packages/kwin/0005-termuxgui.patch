+void TermuxGuiPointerDevice::handlePointer(const TermuxGuiPointerEvent &event)
+{
+    if (!m_enabled || !m_output) {
+        return;
+    }
+    const qreal scale = std::max<qreal>(m_output->scale(), 0.01);
+    const auto time = nowMicroseconds();
+    const QPointF position(event.x / scale, event.y / scale);
+    m_integration->markPointerDelivered(QPoint(event.x, event.y));
+
+    switch (event.action) {
+    case TermuxGuiPointerAction::Move:
+        Q_EMIT pointerMotionAbsolute(position, time, this);
+        break;
+    case TermuxGuiPointerAction::ButtonDown:
+    case TermuxGuiPointerAction::ButtonUp: {
+        quint32 button;
+        switch (event.button) {
+        case TermuxGuiPointerButton::Left:
+            button = BTN_LEFT;
+            break;
+        case TermuxGuiPointerButton::Right:
+            button = BTN_RIGHT;
+            break;
+        case TermuxGuiPointerButton::Middle:
+            button = BTN_MIDDLE;
+            break;
+        default:
+            return;
+        }
+        // make sure the click lands where Termux:GUI drew the cursor
+        Q_EMIT pointerMotionAbsolute(position, time, this);
+        const auto state = event.action == TermuxGuiPointerAction::ButtonDown ? PointerButtonState::Pressed : PointerButtonState::Released;
+        Q_EMIT pointerButtonChanged(button, state, time, this);
+        break;
+    }
+    case TermuxGuiPointerAction::Scroll:
+        // one unit = one wheel notch; positive y scrolls down, like a mouse wheel
+        if (event.scrollY != 0) {
+            Q_EMIT pointerAxisChanged(PointerAxis::Vertical, 15.0 * event.scrollY, qint32(120 * event.scrollY), PointerAxisSource::Wheel, false, time, this);
+        }
+        if (event.scrollX != 0) {
+            Q_EMIT pointerAxisChanged(PointerAxis::Horizontal, 15.0 * event.scrollX, qint32(120 * event.scrollX), PointerAxisSource::Wheel, false, time, this);
+        }
+        break;
+    }
+    Q_EMIT pointerFrame(this);
+}
