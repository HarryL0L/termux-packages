+// ------------------------------------------------------------- connection
+
+class TermuxGuiConnection::Private
+{
+public:
+    ~Private()
+    {
+        close();
+    }
+
+    void close()
+    {
+        if (mainFd >= 0) {
+            ::shutdown(mainFd, SHUT_RDWR);
+            ::close(mainFd);
+            mainFd = -1;
+        }
+        if (eventFd >= 0) {
+            ::shutdown(eventFd, SHUT_RDWR);
+            ::close(eventFd);
+            eventFd = -1;
+        }
+    }
+
+    /**
+     * Sends a Method with @p field set to @p request and returns the raw response.
+     * The caller must hold @c mutex.
+     */
+    std::optional<QByteArray> call(int field, const PbWriter &request)
+    {
+        if (mainFd < 0) {
+            return std::nullopt;
+        }
+        PbWriter method;
+        method.message(field, request);
+        if (!writeDelimited(mainFd, method.data())) {
+            qCWarning(KWIN_VIRTUAL, "[termuxgui] write failed (method %d): %s", field, strerror(errno));
+            return std::nullopt;
+        }
+        auto response = readDelimited(mainFd);
+        if (!response) {
+            qCWarning(KWIN_VIRTUAL, "[termuxgui] read failed (method %d): %s", field, strerror(errno));
+        }
+        return response;
+    }
+
+    /**
+     * For the many "{bool success = 1; Error code = 2;}" responses.
+     */
+    bool callSuccess(int field, const PbWriter &request)
+    {
+        std::lock_guard lock(mutex);
+        const auto response = call(field, request);
+        if (!response) {
+            return false;
+        }
+        PbReader r(*response);
+        bool success = false;
+        int64_t code = 0;
+        int f, wt;
+        while (r.next(f, wt)) {
+            if (f == 1 && wt == 0) {
+                success = r.varint() != 0;
+            } else if (f == 2 && wt == 0) {
+                code = int64_t(r.varint());
+            } else {
+                r.skip(wt);
+            }
+        }
+        if (!success) {
+            qCWarning(KWIN_VIRTUAL, "[termuxgui] method %d failed, error code %lld", field, static_cast<long long>(code));
+        }
+        return success;
+    }
+
+    int mainFd = -1;
+    int eventFd = -1;
+    std::mutex mutex;
+    std::thread eventThread;
+    std::function<void(const TermuxGuiEvent &)> handler;
+};
+
+TermuxGuiConnection::TermuxGuiConnection()
+    : d(new Private)
+{
+}
+
+TermuxGuiConnection::~TermuxGuiConnection()
+{
+    disconnect();
+    delete d;
+}
+
+bool TermuxGuiConnection::isConnected() const
+{
+    return d->mainFd >= 0;
+}
+
+bool TermuxGuiConnection::connect(int timeoutMs)
+{
+    const QByteArray suffix = QByteArray::number(qlonglong(getpid())) + '-' + QByteArray::number(QRandomGenerator::global()->generate());
+    const QByteArray mainName = "kwin-tgui-main-" + suffix;
+    const QByteArray eventName = "kwin-tgui-event-" + suffix;
+
+    const int mainListen = listenAbstract(mainName);
+    const int eventListen = listenAbstract(eventName);
+    if (mainListen < 0 || eventListen < 0) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] could not create abstract unix sockets: %s", strerror(errno));
+        if (mainListen >= 0) {
+            ::close(mainListen);
+        }
+        if (eventListen >= 0) {
+            ::close(eventListen);
+        }
+        return false;
+    }
+
+    const QString am = qEnvironmentVariable("KWIN_TERMUX_GUI_AM", QStringLiteral("am"));
+    const QStringList args{
+        QStringLiteral("broadcast"), QStringLiteral("--user"), QStringLiteral("0"),
+        QStringLiteral("-n"), QStringLiteral("com.termux.gui/.GUIReceiver"),
+        QStringLiteral("--es"), QStringLiteral("mainSocket"), QString::fromLatin1(mainName),
+        QStringLiteral("--es"), QStringLiteral("eventSocket"), QString::fromLatin1(eventName),
+    };
+    const int rc = QProcess::execute(am, args);
+    if (rc != 0) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] '%s broadcast' failed with %d; is Termux:GUI installed?", qPrintable(am), rc);
+    }
+
+    d->mainFd = acceptWithTimeout(mainListen, timeoutMs);
+    d->eventFd = d->mainFd >= 0 ? acceptWithTimeout(eventListen, timeoutMs) : -1;
+    ::close(mainListen);
+    ::close(eventListen);
+    if (d->mainFd < 0 || d->eventFd < 0) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] Termux:GUI did not connect within %d ms", timeoutMs);
+        d->close();
+        return false;
+    }
+
+    // protocol negotiation: binary protocol, version 0
+    const char request = 0;
+    char reply = 1;
+    if (!writeAll(d->mainFd, &request, 1) || !readAll(d->mainFd, &reply, 1) || reply != 0) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] protocol negotiation failed (reply %d)", int(reply));
+        d->close();
+        return false;
+    }
+    qCInfo(KWIN_VIRTUAL, "[termuxgui] connected to Termux:GUI");
+    return true;
+}
+
+void TermuxGuiConnection::disconnect()
+{
+    d->close();
+    if (d->eventThread.joinable()) {
+        d->eventThread.join();
+    }
+}
+
+void TermuxGuiConnection::startEventThread(std::function<void(const TermuxGuiEvent &)> handler)
+{
+    d->handler = std::move(handler);
+    d->eventThread = std::thread([this]() {
+        for (;;) {
+            const int fd = d->eventFd;
+            if (fd < 0) {
+                return;
+            }
+            const auto data = readDelimited(fd);
+            if (!data) {
+                return;
+            }
+            PbReader r(*data);
+            int f, wt;
+            if (!r.next(f, wt) || wt != 2) {
+                continue;
+            }
+            PbReader body = r.sub();
+            TermuxGuiEvent ev{};
+            bool known = true;
+            auto readView = [&](PbReader v) {
+                int vf, vwt;
+                while (v.next(vf, vwt)) {
+                    if (vf == 1 && vwt == 0) {
+                        ev.aid = int(int64_t(v.varint()));
+                    } else if (vf == 2 && vwt == 0) {
+                        ev.view = int(int64_t(v.varint()));
+                    } else {
+                        v.skip(vwt);
+                    }
+                }
+            };
+            switch (f) {
+            case EvCreate:
+            case EvDestroy: {
+                ev.type = f == EvCreate ? TermuxGuiEvent::Type::Create : TermuxGuiEvent::Type::Destroy;
+                int bf, bwt;
+                while (body.next(bf, bwt)) {
+                    if (bf == 1 && bwt == 0) {
+                        ev.aid = int(int64_t(body.varint()));
+                    } else {
+                        body.skip(bwt);
+                    }
+                }
+                break;
+            }
+            case EvSurfaceChanged: {
+                ev.type = TermuxGuiEvent::Type::SurfaceChanged;
+                int w = 0, h = 0;
+                int bf, bwt;
+                while (body.next(bf, bwt)) {
+                    if (bf == 1 && bwt == 2) {
+                        readView(body.sub());
+                    } else if (bf == 2 && bwt == 0) {
+                        w = int(body.varint());
+                    } else if (bf == 3 && bwt == 0) {
+                        h = int(body.varint());
+                    } else {
+                        body.skip(bwt);
+                    }
+                }
+                ev.size = QSize(w, h);
+                break;
+            }
+            case EvTouch: {
+                ev.type = TermuxGuiEvent::Type::Touch;
+                int bf, bwt;
+                while (body.next(bf, bwt)) {
+                    if (bf == 1 && bwt == 2) {
+                        readView(body.sub());
+                    } else if (bf == 2 && bwt == 0) {
+                        ev.touch.action = TermuxGuiTouchAction(body.varint());
+                    } else if (bf == 3 && bwt == 2) {
+                        // repeated Touch: keep the last group of pointers
+                        PbReader touch = body.sub();
+                        std::vector<TermuxGuiTouchPoint> points;
+                        int tf, twt;
+                        while (touch.next(tf, twt)) {
+                            if (tf == 4 && twt == 2) {
+                                PbReader p = touch.sub();
+                                TermuxGuiTouchPoint point{0, 0, 0};
+                                int pf, pwt;
+                                while (p.next(pf, pwt)) {
+                                    if (pf == 1 && pwt == 0) {
+                                        point.x = int(int64_t(p.varint()));
+                                    } else if (pf == 2 && pwt == 0) {
+                                        point.y = int(int64_t(p.varint()));
+                                    } else if (pf == 3 && pwt == 0) {
+                                        point.id = int(int64_t(p.varint()));
+                                    } else {
+                                        p.skip(pwt);
+                                    }
+                                }
+                                points.push_back(point);
+                            } else {
+                                touch.skip(twt);
+                            }
+                        }
+                        ev.touch.points = std::move(points);
+                    } else if (bf == 4 && bwt == 0) {
+                        ev.touch.index = uint32_t(body.varint());
+                    } else if (bf == 5 && bwt == 0) {
+                        ev.touch.time = body.varint();
+                    } else {
+                        body.skip(bwt);
+                    }
+                }
+                break;
+            }
+            case EvPointer: {
+                ev.type = TermuxGuiEvent::Type::Pointer;
+                int bf, bwt;
+                while (body.next(bf, bwt)) {
+                    if (bf == 1 && bwt == 2) {
+                        readView(body.sub());
+                    } else if (bf == 2 && bwt == 0) {
+                        ev.pointer.action = TermuxGuiPointerAction(body.varint());
+                    } else if (bf == 3 && bwt == 0) {
+                        ev.pointer.x = int(int64_t(body.varint()));
+                    } else if (bf == 4 && bwt == 0) {
+                        ev.pointer.y = int(int64_t(body.varint()));
+                    } else if (bf == 5 && bwt == 0) {
+                        ev.pointer.button = TermuxGuiPointerButton(body.varint());
+                    } else if (bf == 6 && bwt == 5) {
+                        ev.pointer.scrollX = body.float32();
+                    } else if (bf == 7 && bwt == 5) {
+                        ev.pointer.scrollY = body.float32();
+                    } else {
+                        body.skip(bwt);
+                    }
+                }
+                break;
+            }
+            case EvKey: {
+                ev.type = TermuxGuiEvent::Type::Key;
+                int bf, bwt;
+                while (body.next(bf, bwt)) {
+                    if (bf == 1 && bwt == 2) {
+                        readView(body.sub());
+                    } else if (bf == 2 && bwt == 0) {
+                        ev.key.code = uint32_t(body.varint());
+                    } else if (bf == 3 && bwt == 0) {
+                        ev.key.modifiers = uint32_t(body.varint());
+                    } else if (bf == 4 && bwt == 0) {
+                        ev.key.codePoint = uint32_t(body.varint());
+                    } else if (bf == 5 && bwt == 0) {
+                        ev.key.down = body.varint() == 0; // KeyAction ACTION_DOWN = 0
+                    } else if (bf == 6 && bwt == 0) {
+                        ev.key.flags = uint32_t(body.varint());
+                    } else {
+                        body.skip(bwt);
+                    }
+                }
+                break;
+            }
+            default:
+                known = false;
+                break;
+            }
+            if (known && !body.bad() && d->handler) {
+                d->handler(ev);
+            }
+        }
+    });
+}
+
+// ------------------------------------------------------------ activities
+
+std::optional<int> TermuxGuiConnection::newActivity()
+{
+    PbWriter req;
+    req.int32(1, -1); // tid: new task
+    req.int32(2, 0); // ActivityType normal
+    req.boolean(3, false); // interceptBackButton
+    std::lock_guard lock(d->mutex);
+    const auto response = d->call(NewActivity, req);
+    if (!response) {
+        return std::nullopt;
+    }
+    PbReader r(*response);
+    // proto3 omits zero-valued fields, and the first activity id IS 0
+    int aid = 0;
+    int f, wt;
+    while (r.next(f, wt)) {
+        if (f == 1 && wt == 0) {
+            aid = int(int64_t(r.varint()));
+        } else {
+            r.skip(wt);
+        }
+    }
+    if (aid < 0) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] Termux:GUI could not start an activity (is it allowed to display over other apps / start from background?)");
+        return std::nullopt;
+    }
+    return aid;
+}
+
+bool TermuxGuiConnection::setOrientationFullUser(int aid)
+{
+    PbWriter req;
+    req.int32(1, aid);
+    req.int32(2, 3); // Orientation.fullUser
+    return d->callSuccess(SetOrientation, req);
+}
+
+bool TermuxGuiConnection::configureInsetsNoBars(int aid)
+{
+    PbWriter req;
+    req.int32(1, aid);
+    req.int32(2, 3); // Bars.NO_BAR
+    req.int32(3, 1); // BarBehaviour.BAR_BEHAVIOUR_TRANSIENT
+    req.boolean(4, false);
+    return d->callSuccess(ConfigureInsets, req);
+}
+
+// ----------------------------------------------------------------- views
+
+std::optional<int> TermuxGuiConnection::createSurfaceView(int aid, bool keyboard)
+{
+    PbWriter create;
+    create.int32(1, aid);
+    create.int32(2, -1); // parent: root
+    create.int32(3, 0); // Visibility.visible
+    PbWriter req;
+    req.message(1, create);
+    req.boolean(2, keyboard);
+    req.boolean(6, false); // secure
+    std::lock_guard lock(d->mutex);
+    const auto response = d->call(CreateSurfaceView, req);
+    if (!response) {
+        return std::nullopt;
+    }
+    PbReader r(*response);
+    int id = 0; // omitted when 0 (proto3), so default to success
+    int64_t code = 0;
+    int f, wt;
+    while (r.next(f, wt)) {
+        if (f == 1 && wt == 0) {
+            id = int(int64_t(r.varint()));
+        } else if (f == 2 && wt == 0) {
+            code = int64_t(r.varint());
+        } else {
+            r.skip(wt);
+        }
+    }
+    if (id < 0) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] createSurfaceView failed, error code %lld", static_cast<long long>(code));
+        return std::nullopt;
+    }
+    return id;
+}
+
+bool TermuxGuiConnection::setMatchParent(int aid, int view)
+{
+    PbWriter size;
+    size.int32(2, 0); // ViewSize.constant = MATCH_PARENT (oneof member, always encoded)
+    PbWriter w;
+    w.message(1, viewMsg(aid, view));
+    w.message(2, size);
+    PbWriter h;
+    h.message(1, viewMsg(aid, view));
+    h.message(2, size);
+    return d->callSuccess(SetWidth, w) && d->callSuccess(SetHeight, h);
+}
+
+bool TermuxGuiConnection::setClickable(int aid, int view, bool clickable)
+{
+    PbWriter req;
+    req.message(1, viewMsg(aid, view));
+    req.boolean(2, clickable);
+    return d->callSuccess(SetClickable, req);
+}
+
+bool TermuxGuiConnection::sendTouchEvents(int aid, int view, bool send)
+{
+    PbWriter req;
+    req.message(1, viewMsg(aid, view));
+    req.boolean(2, send);
+    return d->callSuccess(SendTouchEvent, req);
+}
+
+bool TermuxGuiConnection::surfaceViewConfig(int aid, int view, uint32_t backgroundColor, float framerate)
+{
+    PbWriter req;
+    req.message(1, viewMsg(aid, view));
+    req.uint32(2, backgroundColor);
+    req.int32(3, 0); // xMismatch STICK_TOPLEFT
+    req.int32(4, 0); // yMismatch STICK_TOPLEFT
+    req.float32(5, framerate);
+    return d->callSuccess(SurfaceViewConfig, req);
+}
+
+// ------------------------------------------------------ hardware buffers
+
+bool TermuxGuiConnection::createHardwareBuffer(TermuxGuiHardwareBuffer *buffer, uint32_t width, uint32_t height)
+{
+    auto &api = hardwareBufferApi();
+    if (!api.load()) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] AHardwareBuffer_recvHandleFromUnixSocket unavailable");
+        return false;
+    }
+    PbWriter req;
+    req.int32(1, int32_t(width));
+    req.int32(2, int32_t(height));
+    req.int32(3, 0); // Format.RGBA8888
+    req.int32(4, 0); // cpuRead never
+    req.int32(5, 2); // cpuWrite often (keeps the layout linear)
+
+    std::lock_guard lock(d->mutex);
+    if (d->mainFd < 0) {
+        return false;
+    }
+    PbWriter method;
+    method.message(CreateHardwareBuffer, req);
+    if (!writeDelimited(d->mainFd, method.data())) {
+        return false;
+    }
+    // no protobuf response: a big-endian int32 id, then the buffer handle as ancillary data
+    char raw[4];
+    if (!readAll(d->mainFd, raw, 4)) {
+        return false;
+    }
+    uint32_t be;
+    memcpy(&be, raw, 4);
+    const int32_t id = int32_t(ntohl(be));
+    if (id < 0) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] Termux:GUI could not create a %ux%u hardware buffer", width, height);
+        return false;
+    }
+    AHardwareBuffer *hb = nullptr;
+    if (api.recvFn()(d->mainFd, &hb) != 0 || !hb) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] receiving the hardware buffer handle failed: %s", strerror(errno));
+        return false;
+    }
+    buffer->buffer = hb;
+    buffer->id = id;
+    return true;
+}
+
+bool TermuxGuiConnection::destroyHardwareBuffer(TermuxGuiHardwareBuffer *buffer)
+{
+    bool ok = true;
+    if (buffer->id >= 0) {
+        PbWriter req;
+        req.int32(1, buffer->id);
+        ok = d->callSuccess(DestroyHardwareBuffer, req);
+        buffer->id = -1;
+    }
+    if (buffer->buffer) {
+        auto &api = hardwareBufferApi();
+        if (api.load()) {
+            api.releaseFn()(buffer->buffer);
+        }
+        buffer->buffer = nullptr;
+    }
+    return ok;
+}
+
+bool TermuxGuiConnection::surfaceViewSetBuffer(int aid, int view, const TermuxGuiHardwareBuffer &buffer)
+{
+    PbWriter req;
+    req.message(1, viewMsg(aid, view));
+    req.int32(2, buffer.id);
+    return d->callSuccess(SurfaceViewSetBuffer, req);
+}
+
+// ------------------------------------------------------ trackpad / cursor
+
+bool TermuxGuiConnection::surfaceViewTrackpad(int aid, int view, bool enabled, float sensitivity, float scrollSensitivity)
+{
+    PbWriter req;
+    req.message(1, viewMsg(aid, view));
+    req.boolean(2, enabled);
+    req.float32(3, sensitivity);
+    req.float32(4, scrollSensitivity);
+    return d->callSuccess(SurfaceViewTrackpad, req);
+}
+
+bool TermuxGuiConnection::surfaceViewSetCursor(int aid, int view, bool visible, std::optional<QPoint> position)
+{
+    PbWriter req;
+    req.message(1, viewMsg(aid, view));
+    req.boolean(2, visible);
+    req.boolean(3, position.has_value());
+    req.int32(4, position ? position->x() : 0);
+    req.int32(5, position ? position->y() : 0);
+    return d->callSuccess(SurfaceViewSetCursor, req);
+}
+
+bool TermuxGuiConnection::surfaceViewSetCursorImage(int aid, int view, const QSize &size, const QPoint &hotspot, const QByteArray &pixels)
+{
+    PbWriter req;
+    req.message(1, viewMsg(aid, view));
+    req.uint32(2, uint32_t(size.width()));
+    req.uint32(3, uint32_t(size.height()));
+    req.uint32(4, uint32_t(std::max(0, hotspot.x())));
+    req.uint32(5, uint32_t(std::max(0, hotspot.y())));
+    req.bytes(6, pixels);
+    return d->callSuccess(SurfaceViewSetCursorImage, req);
+}
+
+} // namespace KWin
