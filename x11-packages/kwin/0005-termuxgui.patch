+TermuxGuiIntegration::TermuxGuiIntegration(QObject *parent)
+    : QObject(parent)
+{
+    qRegisterMetaType<TermuxGuiTouchEvent>();
+
+    if (tgui_connection_create(&m_connection) != TGUI_ERR_OK) {
+        return;
+    }
+    if (tgui_activity_create(m_connection, &m_activity, TGUI_ACTIVITY_NORMAL, nullptr, false) != TGUI_ERR_OK) {
+        tgui_connection_destroy(m_connection);
+        m_connection = nullptr;
+        return;
+    }
+    if (tgui_activity_set_orientation(m_connection, m_activity, TGUI_ORIENTATION_FULL_USER) != TGUI_ERR_OK) {
+        tgui_connection_destroy(m_connection);
+        m_connection = nullptr;
+        return;
+    }
+
+    m_valid = true;
+    m_running = true;
+    m_thread = std::thread(&TermuxGuiIntegration::run, this);
+}
+
+TermuxGuiIntegration::~TermuxGuiIntegration()
+{
+    m_running = false;
+    if (m_thread.joinable()) {
+        m_thread.join();
+    }
+    if (m_connection) {
+        tgui_connection_destroy(m_connection);
+        m_connection = nullptr;
+    }
+}
