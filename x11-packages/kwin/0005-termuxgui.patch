+bool TermuxGuiQPainterLayer::copyImageToBuffer(const QImage *image, Buffer *buffer)
+{
+    if (!image || image->isNull() || !buffer->valid) {
+        return false;
+    }
+
+    auto &api = androidHardwareBufferApi();
+    if (!api.ensureLoaded()) {
+        return false;
+    }
+
+    AHardwareBuffer_Desc desc{};
+    api.describe()(buffer->hb.buffer, &desc);
+    if (desc.width != static_cast<uint32_t>(image->width()) || desc.height != static_cast<uint32_t>(image->height())) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] copyImageToBuffer: SIZE MISMATCH buffer=%ux%u image=%dx%d, skipping copy",
+                   desc.width, desc.height, image->width(), image->height());
+        return false;
+    }
+
+    void *mapped = nullptr;
+    const int rc = api.lock()(buffer->hb.buffer, AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN, -1, nullptr, &mapped);
+    if (rc != 0 || !mapped) {
+        return false;
+    }
+
+    const size_t srcStride = static_cast<size_t>(image->bytesPerLine());
+    auto *dst = static_cast<unsigned char *>(mapped);
+    const auto *src = image->constBits();
+    const size_t dstStride = static_cast<size_t>(desc.stride) * 4;
+    for (int y = 0; y < image->height(); ++y) {
+        const auto *srcRow = src + static_cast<size_t>(y) * srcStride;
+        auto *dstRow = dst + static_cast<size_t>(image->height() - 1 - y) * dstStride;
+        for (int x = 0; x < image->width(); ++x) {
+            dstRow[x * 4 + 0] = srcRow[x * 4 + 2];
+            dstRow[x * 4 + 1] = srcRow[x * 4 + 1];
+            dstRow[x * 4 + 2] = srcRow[x * 4 + 0];
+            dstRow[x * 4 + 3] = 0xff;
+        }
+    }
+
+    api.unlock()(buffer->hb.buffer, nullptr);
+    return true;
+}
+
+std::optional<OutputLayerBeginFrameInfo> TermuxGuiQPainterLayer::doBeginFrame()
+{
+    const QSize nativeSize = m_output->modeSize();
+    if (nativeSize.isEmpty()) {
+        return std::nullopt;
+    }
+    if (!m_swapchain || m_swapchain->size() != nativeSize) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] doBeginFrame: (re)creating swapchain at %dx%d (was %dx%d)",
+                   nativeSize.width(), nativeSize.height(),
+                   m_swapchain ? m_swapchain->size().width() : -1, m_swapchain ? m_swapchain->size().height() : -1);
+        m_swapchain = std::make_unique<QPainterSwapchain>(m_backend->graphicsBufferAllocator(), nativeSize, DRM_FORMAT_XRGB8888);
+    }
+    if (!ensureBuffers(nativeSize)) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] doBeginFrame: ensureBuffers(%dx%d) FAILED, skipping frame", nativeSize.width(), nativeSize.height());
+        return std::nullopt;
+    }
+
+    m_current = m_swapchain->acquire();
+    if (!m_current) {
+        return std::nullopt;
+    }
+
+    m_renderTime = std::make_unique<CpuRenderTimeQuery>();
+    return OutputLayerBeginFrameInfo{
+        .renderTarget = RenderTarget(m_current->view()->image()),
+        .repaint = Region::infinite(),
+    };
+}
+
+bool TermuxGuiQPainterLayer::doEndFrame(const Region &renderedDeviceRegion, const Region &damagedDeviceRegion, OutputFrame *frame)
+{
+    if (m_renderTime) {
+        m_renderTime->end();
+        if (frame) {
+            frame->addRenderTimeQuery(std::move(m_renderTime));
+        }
+    }
+
+    Buffer &buffer = m_buffers[m_currentBuffer];
+    if (copyImageToBuffer(m_current ? m_current->view()->image() : nullptr, &buffer)) {
+        if (m_integration->view() != -1) {
+            const tgui_err err = m_integration->setBuffer(&buffer.hb);
+            if (err != TGUI_ERR_OK) {
+                qCWarning(KWIN_VIRTUAL, "[termuxgui] doEndFrame: setBuffer FAILED err=%d", static_cast<int>(err));
+            }
+        } else {
+            qCWarning(KWIN_VIRTUAL, "[termuxgui] doEndFrame: no surface view yet, dropping frame");
+        }
+        m_currentBuffer = (m_currentBuffer + 1) % m_buffers.size();
+    }
+    if (m_current) {
+        m_swapchain->release(m_current);
+        m_current.reset();
+    }
+    return true;
+}
