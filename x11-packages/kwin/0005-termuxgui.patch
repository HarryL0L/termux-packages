+TermuxGuiQPainterBackend::TermuxGuiQPainterBackend(VirtualBackend *backend, TermuxGuiIntegration *integration)
+    : m_backend(backend)
+    , m_integration(integration)
+    , m_allocator(std::make_unique<ShmGraphicsBufferAllocator>())
+{
+    qRegisterMetaType<QSize>();
+    connect(m_backend, &VirtualBackend::outputAdded, this, &TermuxGuiQPainterBackend::addOutput);
+    connect(m_integration, &TermuxGuiIntegration::surfaceSizeChanged, this, &TermuxGuiQPainterBackend::updateOutputSize, Qt::QueuedConnection);
+
+    for (BackendOutput *output : m_backend->outputs()) {
+        addOutput(output);
+    }
+
+    const QSize size = m_integration->surfaceSize();
+    if (!size.isEmpty()) {
+        updateOutputSize(size);
+    }
+}
+
+TermuxGuiQPainterBackend::~TermuxGuiQPainterBackend()
+{
+    const auto outputs = m_backend->outputs();
+    for (BackendOutput *output : outputs) {
+        auto *virtualOutput = static_cast<VirtualOutput *>(output);
+        virtualOutput->setPresentCallback(nullptr);
+        virtualOutput->setOutputLayer(nullptr);
+    }
+}
+
+GraphicsBufferAllocator *TermuxGuiQPainterBackend::graphicsBufferAllocator() const
+{
+    return m_allocator.get();
+}
+
+TermuxGuiIntegration *TermuxGuiQPainterBackend::integration() const
+{
+    return m_integration;
+}
+
+void TermuxGuiQPainterBackend::addOutput(BackendOutput *output)
+{
+    auto *virtualOutput = static_cast<VirtualOutput *>(output);
+    virtualOutput->setOutputLayer(std::make_unique<TermuxGuiQPainterLayer>(output, this));
+    if (m_integration->trackpadEnabled()) {
+        auto cursor = std::make_unique<TermuxGuiQPainterCursorLayer>(output, m_integration);
+        virtualOutput->setPresentCallback([this, cursorLayer = cursor.get()](const QList<OutputLayer *> &) {
+            termuxGuiSyncCursor(m_integration, cursorLayer);
+        });
+        m_cursorLayers[output] = std::move(cursor);
+    }
+}
+
+void termuxGuiApplyOutputSize(VirtualBackend *backend, const QSize &size)
+{
+    if (size.isEmpty()) {
+        return;
+    }
+    qCDebug(KWIN_VIRTUAL, "[termuxgui] output size %dx%d", size.width(), size.height());
+
+    OutputConfiguration config;
+    for (BackendOutput *output : backend->outputs()) {
+        auto *virtualOutput = static_cast<VirtualOutput *>(output);
+        auto change = config.changeSet(virtualOutput);
+        const uint32_t refreshRate = virtualOutput->refreshRate() ? virtualOutput->refreshRate() : 60000;
+
+        // OutputModeline::custom() runs size/refreshRate through libxcvt and ORs in
+        // Flag::Generated. VirtualOutput::applyChanges() builds the OutputMode objects
+        // via this same call and matches currentMode against them exactly, so
+        // currentMode has to be built through custom() as well or it never matches.
+        const CustomModeDefinition modeDef{size, refreshRate, OutputModeline::Flags(OutputModeline::Flag::Custom) | OutputModeline::Flag::Preferred};
+        change->customModes = {modeDef};
+        change->currentMode = OutputModeline::custom(modeDef);
+        change->pos = QPoint(0, 0);
+        change->transform = OutputTransform::Kind::Normal;
+        change->manualTransform = OutputTransform::Kind::Normal;
+    }
+
+    // Workspace::applyOutputConfiguration() also recomputes the logical output
+    // geometry, re-lays-out windows and schedules a repaint; the direct
+    // applyChanges() path is only for the early startup case before Workspace exists.
+    if (Workspace *ws = Workspace::self()) {
+        ws->applyOutputConfiguration(config);
+    } else {
+        for (BackendOutput *output : backend->outputs()) {
+            static_cast<VirtualOutput *>(output)->applyChanges(config);
+        }
+    }
+}
+
+void TermuxGuiQPainterBackend::updateOutputSize(const QSize &size)
+{
+    termuxGuiApplyOutputSize(m_backend, size);
+}
+
+QList<OutputLayer *> TermuxGuiQPainterBackend::compatibleOutputLayers(BackendOutput *output)
+{
+    QList<OutputLayer *> layers{static_cast<VirtualOutput *>(output)->outputLayer()};
+    if (auto it = m_cursorLayers.find(output); it != m_cursorLayers.end()) {
+        layers.push_back(it->second.get());
+    }
+    return layers;
+}
