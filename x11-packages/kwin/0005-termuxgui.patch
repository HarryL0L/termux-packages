+void termuxGuiApplyOutputSize(VirtualBackend *backend, const QSize &size)
+{
+    if (size.isEmpty()) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] updateOutputSize() called with empty size, ignoring");
+        return;
+    }
+
+    qCWarning(KWIN_VIRTUAL, "[termuxgui] updateOutputSize() requested=%dx%d", size.width(), size.height());
+
+    OutputConfiguration config;
+    for (BackendOutput *output : backend->outputs()) {
+        auto *virtualOutput = static_cast<VirtualOutput *>(output);
+        auto change = config.changeSet(virtualOutput);
+        const uint32_t refreshRate = virtualOutput->refreshRate() ? virtualOutput->refreshRate() : 60000;
+
+        // IMPORTANT: OutputModeline::custom() runs size/refreshRate through libxcvt (VESA CVT
+        // timing generator), which can adjust the exact size/refresh-rate and always ORs in
+        // Flag::Generated on top of whatever flags we pass. VirtualOutput::applyChanges() builds
+        // the actual OutputMode objects in `modes` via this same custom() call, then tries to
+        // match `currentMode` against them with an exact (size, refreshRate, flags) comparison.
+        // If `currentMode` is built independently with the raw constructor, it will almost never
+        // compare equal to the mode that actually got inserted, match() silently returns null,
+        // and applyChanges() falls back to modes.front() -- i.e. the mode never actually changes.
+        // Building currentMode via the SAME custom() call guarantees they match.
+        const CustomModeDefinition modeDef{size, refreshRate, OutputModeline::Flags(OutputModeline::Flag::Custom) | OutputModeline::Flag::Preferred};
+        change->customModes = {modeDef};
+        change->currentMode = OutputModeline::custom(modeDef);
+        change->pos = QPoint(0, 0);
+        change->transform = OutputTransform::Kind::Normal;
+        change->manualTransform = OutputTransform::Kind::Normal;
+
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] before apply: output=%s ptr=%p modeSize=%dx%d refreshRate=%u changesetPtr=%p currentMode(post-cvt)=%dx%d@%u flags=%d",
+                   qPrintable(output->name()), static_cast<void *>(output), output->modeSize().width(), output->modeSize().height(),
+                   refreshRate, static_cast<void *>(config.constChangeSet(output).get()),
+                   change->currentMode->size().width(), change->currentMode->size().height(),
+                   change->currentMode->refreshRate(), int(change->currentMode->flags()));
+    }
+
+    // IMPORTANT: go through Workspace::applyOutputConfiguration() instead of calling
+    // BackendOutput::applyChanges() directly. The direct call only updates the low-level
+    // BackendOutput state; it skips Workspace::updateOutputs() (which recomputes
+    // LogicalOutput geometry and re-lays-out windows to fit the new output size/shape)
+    // and skips scheduling a repaint on the render loop. Without those two steps, the
+    // scene can keep compositing the old, wrong-sized frame (or windows can keep the old
+    // geometry) until something unrelated happens to trigger a repaint, which is what
+    // produced the stuck/partial rendering after rotation.
+    if (Workspace *ws = Workspace::self()) {
+        const OutputConfigurationError error = ws->applyOutputConfiguration(config);
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] applyOutputConfiguration() result=%d", static_cast<int>(error));
+    } else {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] Workspace::self() is null, falling back to direct applyChanges() (no relayout/repaint will be scheduled)");
+        for (BackendOutput *output : backend->outputs()) {
+            static_cast<VirtualOutput *>(output)->applyChanges(config);
+        }
+    }
+
+    for (BackendOutput *output : backend->outputs()) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] after apply: output=%s modeSize=%dx%d",
+                   qPrintable(output->name()), output->modeSize().width(), output->modeSize().height());
+    }
+}
+
+void TermuxGuiQPainterBackend::updateOutputSize(const QSize &size)
+{
+    termuxGuiApplyOutputSize(m_backend, size);
+}
+
+QList<OutputLayer *> TermuxGuiQPainterBackend::compatibleOutputLayers(BackendOutput *output)
+{
+    return {static_cast<VirtualOutput *>(output)->outputLayer()};
+}
+
+} // namespace KWin
