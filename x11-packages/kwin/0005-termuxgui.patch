+void termuxGuiSyncCursor(TermuxGuiIntegration *integration, OutputLayer *cursorLayer)
+{
+    if (!cursorLayer) {
+        return;
+    }
+    const bool visible = cursorLayer->isEnabled();
+    integration->setCursorVisible(visible);
+    if (visible) {
+        integration->syncCursorPosition(cursorLayer->targetRect().topLeft() + cursorLayer->hotspot().toPoint());
+    }
+}
