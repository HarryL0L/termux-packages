+void TermuxGuiIntegration::setCursorImage(const QImage &image, const QPoint &hotspot)
+{
+    if (!m_trackpad || !m_connection || image.isNull()) {
+        return;
+    }
+    // Termux:GUI wants non-premultiplied RGBA8888, top-down, tightly packed
+    QImage rgba = image.convertToFormat(QImage::Format_RGBA8888);
+    QByteArray pixels;
+    if (rgba.bytesPerLine() == rgba.width() * 4) {
+        pixels = QByteArray(reinterpret_cast<const char *>(rgba.constBits()), qsizetype(rgba.sizeInBytes()));
+    } else {
+        pixels.reserve(rgba.width() * rgba.height() * 4);
+        for (int y = 0; y < rgba.height(); ++y) {
+            pixels.append(reinterpret_cast<const char *>(rgba.constScanLine(y)), rgba.width() * 4);
+        }
+    }
+    if (m_cursorImageSent && pixels == m_cursorPixels && rgba.size() == m_cursorSize && hotspot == m_cursorHotspot) {
+        return;
+    }
+    const int view = m_view.load();
+    if (view == -1) {
+        return;
+    }
+    if (m_connection->surfaceViewSetCursorImage(m_activity, view, rgba.size(), hotspot, pixels)) {
+        m_cursorPixels = std::move(pixels);
+        m_cursorSize = rgba.size();
+        m_cursorHotspot = hotspot;
+        m_cursorImageSent = true;
+    }
+}
+
+void TermuxGuiIntegration::setCursorVisible(bool visible)
+{
+    if (!m_trackpad || !m_connection) {
+        return;
+    }
+    if (m_cursorVisibleSent.has_value() && *m_cursorVisibleSent == visible) {
+        return;
+    }
+    const int view = m_view.load();
+    if (view == -1) {
+        return;
+    }
+    if (m_connection->surfaceViewSetCursor(m_activity, view, visible, std::nullopt)) {
+        m_cursorVisibleSent = visible;
+    }
+}
+
+void TermuxGuiIntegration::syncCursorPosition(const QPoint &devicePosition)
+{
+    if (!m_trackpad || !m_connection) {
+        return;
+    }
+    const int view = m_view.load();
+    if (view == -1) {
+        return;
+    }
+    // KWin's cursor normally sits exactly where the last trackpad event put it;
+    // anything else means KWin moved it itself (warp, constraint, touch) and
+    // the app's cursor has to follow.
+    if ((devicePosition - m_deliveredCursorPos).manhattanLength() <= 2) {
+        return;
+    }
+    if (m_connection->surfaceViewSetCursor(m_activity, view, m_cursorVisibleSent.value_or(true), devicePosition)) {
+        m_deliveredCursorPos = devicePosition;
+    }
+}
+
+void TermuxGuiIntegration::markPointerDelivered(const QPoint &devicePosition)
+{
+    m_deliveredCursorPos = devicePosition;
+}
+
+void TermuxGuiIntegration::createSurfaceView()
+{
+    if (m_view.load() != -1 || !m_connection) {
+        return;
+    }
+    const auto view = m_connection->createSurfaceView(m_activity, false);
+    if (!view) {
+        return;
+    }
+    m_connection->setMatchParent(m_activity, *view);
+    m_connection->setClickable(m_activity, *view, true);
+    m_connection->sendTouchEvents(m_activity, *view, true);
+    m_connection->surfaceViewConfig(m_activity, *view, 0xff000000u, 60.0f);
+    m_connection->configureInsetsNoBars(m_activity);
+    if (m_trackpad) {
+        bool ok = false;
+        float sensitivity = qEnvironmentVariable("KWIN_TERMUX_GUI_TRACKPAD_SENSITIVITY").toFloat(&ok);
+        if (!ok || sensitivity <= 0) {
+            sensitivity = 1.0f;
+        }
+        float scrollSensitivity = qEnvironmentVariable("KWIN_TERMUX_GUI_SCROLL_SENSITIVITY").toFloat(&ok);
+        if (!ok || scrollSensitivity <= 0) {
+            scrollSensitivity = 1.0f;
+        }
+        if (!m_connection->surfaceViewTrackpad(m_activity, *view, true, sensitivity, scrollSensitivity)) {
+            qCWarning(KWIN_VIRTUAL, "[termuxgui] this Termux:GUI has no trackpad support, falling back to touch input");
+            m_trackpad = false;
+        }
+    }
+    // reset cursor bookkeeping for the new view
+    m_cursorImageSent = false;
+    m_cursorVisibleSent.reset();
+    m_view = *view;
+}
+
+void TermuxGuiIntegration::handleEvent(const TermuxGuiEvent &event)
+{
+    switch (event.type) {
+    case TermuxGuiEvent::Type::Create:
+        if (event.aid == m_activity) {
+            createSurfaceView();
+        }
+        break;
+    case TermuxGuiEvent::Type::Destroy:
+        if (event.aid == m_activity) {
+            m_view = -1;
+        }
+        break;
+    case TermuxGuiEvent::Type::SurfaceChanged:
+        if (event.aid == m_activity && event.view == m_view.load()) {
+            qCDebug(KWIN_VIRTUAL, "[termuxgui] surface changed to %dx%d", event.size.width(), event.size.height());
+            {
+                QMutexLocker locker(&m_mutex);
+                m_surfaceSize = event.size;
+            }
+            m_surfaceSizeReady.wakeAll();
+            Q_EMIT surfaceSizeChanged(event.size);
+        }
+        break;
+    case TermuxGuiEvent::Type::Touch:
+        if (event.aid == m_activity && event.view == m_view.load()) {
+            Q_EMIT touchEvent(event.touch);
+        }
+        break;
+    case TermuxGuiEvent::Type::Pointer:
+        if (event.aid == m_activity && event.view == m_view.load()) {
+            Q_EMIT pointerEvent(event.pointer);
+        }
+        break;
+    case TermuxGuiEvent::Type::Key:
+        // TODO: map Android key codes to evdev and feed a keyboard device
+        break;
+    }
+}
