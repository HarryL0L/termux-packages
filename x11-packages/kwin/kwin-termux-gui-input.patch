+#pragma once
+
+#include "core/inputbackend.h"
+#include "core/inputdevice.h"
+
+#include <termuxgui/termuxgui.h>
+
+#include <memory>
+#include <thread>
+
+namespace KWin
+{
+
+class TermuxGuiBackend;
+
+class TermuxGuiInputDevice : public InputDevice
+{
+    Q_OBJECT
+
+public:
+    explicit TermuxGuiInputDevice(QObject *parent = nullptr);
+
+    QString name() const override;
+    bool isEnabled() const override;
+    void setEnabled(bool enabled) override;
+    bool isKeyboard() const override;
+    bool isPointer() const override;
+    bool isTouchpad() const override;
+    bool isTouch() const override;
+    bool isTabletTool() const override;
+    bool isTabletPad() const override;
+    bool isTabletModeSwitch() const override;
+    bool isLidSwitch() const override;
+
+private:
+    bool m_enabled = true;
+};
+
+class TermuxGuiInputBackend : public InputBackend
+{
+    Q_OBJECT
+
+public:
+    explicit TermuxGuiInputBackend(TermuxGuiBackend *backend);
+    ~TermuxGuiInputBackend() override;
+
+    void initialize() override;
+
+private:
+    void processEvent(const tgui_event &event);
+    void processTouch(const tgui_event &event);
+
+    TermuxGuiBackend *const m_backend;
+    std::unique_ptr<TermuxGuiInputDevice> m_device;
+    std::jthread m_eventThread;
+};
+
+} // namespace KWin
