+TermuxGuiInputBackend::TermuxGuiInputBackend(TermuxGuiBackend *backend)
+    : m_backend(backend)
+{
+}
+
+TermuxGuiInputBackend::~TermuxGuiInputBackend()
+{
+    m_timer.stop();
+    if (m_device) {
+        Q_EMIT deviceRemoved(m_device.get());
+    }
+}
+
+void TermuxGuiInputBackend::initialize()
+{
+    m_device = std::make_unique<TermuxGuiInputDevice>();
+    Q_EMIT deviceAdded(m_device.get());
+
+    if (tgui_send_touch_event(m_backend->connection(), m_backend->activity(), m_backend->surface(), true) != TGUI_ERR_OK) {
+        Q_EMIT deviceRemoved(m_device.get());
+        m_device.reset();
+        return;
+    }
+
+    connect(&m_timer, &QTimer::timeout, this, &TermuxGuiInputBackend::pollEvents);
+    m_timer.start(4); // Poll frequently without busy-spinning.
+}
+
+void TermuxGuiInputBackend::pollEvents()
+{
+    for (;;) {
+        tgui_event event{};
+        bool available = false;
+        if (tgui_poll_event(m_backend->connection(), &event, &available) != TGUI_ERR_OK || !available) {
+            return;
+        }
+        processEvent(event);
+        tgui_event_destroy(&event);
+    }
+}
+
+void TermuxGuiInputBackend::processEvent(const tgui_event &event)
+{
+    if (!m_device || event.type != TGUI_EVENT_TOUCH || event.touch.id != m_backend->surface()) {
+        return;
+    }
+
+    const auto time = std::chrono::milliseconds(event.touch.time);
+    switch (event.touch.action) {
+    case TGUI_TOUCH_DOWN:
+    case TGUI_TOUCH_POINTER_DOWN: {
+        if (event.touch.events == 0 || event.touch.index >= event.touch.num_pointers) {
+            return;
+        }
+        const auto pointer = event.touch.pointers[event.touch.events - 1][event.touch.index];
+        Q_EMIT m_device->touchDown(pointer.id, QPointF(pointer.x, pointer.y), time, m_device.get());
+        Q_EMIT m_device->touchFrame(m_device.get());
+        break;
+    }
+    case TGUI_TOUCH_UP:
+    case TGUI_TOUCH_POINTER_UP: {
+        if (event.touch.events == 0 || event.touch.index >= event.touch.num_pointers) {
+            return;
+        }
+        const auto pointer = event.touch.pointers[event.touch.events - 1][event.touch.index];
+        Q_EMIT m_device->touchUp(pointer.id, time, m_device.get());
+        Q_EMIT m_device->touchFrame(m_device.get());
+        break;
+    }
+    case TGUI_TOUCH_MOVE: {
+        if (event.touch.events == 0) {
+            return;
+        }
+        const uint32_t lastEvent = event.touch.events - 1;
+        for (uint32_t i = 0; i < event.touch.num_pointers; ++i) {
+            const auto pointer = event.touch.pointers[lastEvent][i];
+            Q_EMIT m_device->touchMotion(pointer.id, QPointF(pointer.x, pointer.y), time, m_device.get());
+        }
+        Q_EMIT m_device->touchFrame(m_device.get());
+        break;
+    }
+    case TGUI_TOUCH_CANCEL:
+        Q_EMIT m_device->touchCanceled(m_device.get());
+        Q_EMIT m_device->touchFrame(m_device.get());
+        break;
+    }
+}
+
+} // namespace KWin
+
+#include "moc_termuxgui_input.cpp"
