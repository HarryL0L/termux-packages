+#include "termuxgui_backend.h"
+#include "termuxgui_input.h"
+#include "termuxgui_qpainter_backend.h"
+
+#include <QDebug>
+
+namespace KWin
+{
+
+TermuxGuiBackend::TermuxGuiBackend(QObject *parent)
+    : VirtualBackend(parent)
+{
+}
+
+TermuxGuiBackend::~TermuxGuiBackend()
+{
+    if (m_connection) {
+        tgui_connection_destroy(m_connection);
+    }
+}
+
+bool TermuxGuiBackend::initialize()
+{
+    if (tgui_connection_create(&m_connection) != TGUI_ERR_OK) {
+        qWarning() << "Failed to connect to Termux:GUI";
+        return false;
+    }
+
+    if (tgui_activity_create(m_connection, &m_activity, TGUI_ACTIVITY_NORMAL, nullptr, false) != TGUI_ERR_OK) {
+        qWarning() << "Failed to create Termux:GUI activity";
+        return false;
+    }
+
+    for (;;) {
+        tgui_event event{};
+        if (tgui_wait_event(m_connection, &event) != TGUI_ERR_OK) {
+            qWarning() << "Failed waiting for Termux:GUI activity";
+            return false;
+        }
+        const bool created = event.type == TGUI_EVENT_CREATE && event.activity == m_activity;
+        tgui_event_destroy(&event);
+        if (created) {
+            break;
+        }
+    }
+
+    if (tgui_activity_configure_insets(m_connection, m_activity, TGUI_INSET_NONE, TGUI_INSET_BEHAVIOUR_TRANSIENT) != TGUI_ERR_OK) {
+        qWarning() << "Failed to configure Termux:GUI insets";
+        return false;
+    }
+
+    if (tgui_create_surface_view(m_connection, m_activity, &m_surface, nullptr, TGUI_VIS_VISIBLE, false) != TGUI_ERR_OK) {
+        qWarning() << "Failed to create Termux:GUI SurfaceView";
+        return false;
+    }
+
+    if (tgui_set_width(m_connection, m_activity, m_surface, {TGUI_VIEW_MATCH_PARENT, 0}) != TGUI_ERR_OK ||
+        tgui_set_height(m_connection, m_activity, m_surface, {TGUI_VIEW_MATCH_PARENT, 0}) != TGUI_ERR_OK) {
+        qWarning() << "Failed to size Termux:GUI SurfaceView";
+        return false;
+    }
+
+    if (tgui_surface_view_config(m_connection, m_activity, m_surface, 0,
+                                  TGUI_MISMATCH_STICK_TOPLEFT, TGUI_MISMATCH_STICK_TOPLEFT, 60.0f) != TGUI_ERR_OK) {
+        qWarning() << "Failed to configure Termux:GUI SurfaceView";
+        return false;
+    }
+
+    return true;
+}
+
+std::unique_ptr<QPainterBackend> TermuxGuiBackend::createQPainterBackend()
+{
+    return std::make_unique<TermuxGuiQPainterBackend>(this);
+}
+
+std::unique_ptr<InputBackend> TermuxGuiBackend::createInputBackend()
+{
+    return std::make_unique<TermuxGuiInputBackend>(this);
+}
+
+EglDisplay *TermuxGuiBackend::sceneEglDisplayObject() const
+{
+    return nullptr;
+}
+
+QList<CompositingType> TermuxGuiBackend::supportedCompositors() const
+{
+    return {QPainterCompositing};
+}
+
+tgui_connection TermuxGuiBackend::connection() const
+{
+    return m_connection;
+}
+
+tgui_activity TermuxGuiBackend::activity() const
+{
+    return m_activity;
+}
+
+tgui_view TermuxGuiBackend::surface() const
+{
+    return m_surface;
+}
+
+} // namespace KWin
+
+#include "moc_termuxgui_backend.cpp"
