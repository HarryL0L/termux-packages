diff --git a/src/backends/termuxgui/termuxgui_qpainter_backend.cpp b/src/backends/termuxgui/termuxgui_qpainter_backend.cpp
new file mode 100644
index 0000000..148341f
--- /dev/null
+++ b/src/backends/termuxgui/termuxgui_qpainter_backend.cpp
@@ -0,0 +1,153 @@
+#include "termuxgui_qpainter_backend.h"
+#include "termuxgui_backend.h"
+#include "backends/virtual/virtual_output.h"
+
+#include <android/hardware_buffer.h>
+
+#include <cstring>
+#include <unistd.h>
+
+namespace KWin
+{
+
+TermuxGuiQPainterLayer::TermuxGuiQPainterLayer(BackendOutput *output, TermuxGuiBackend *backend)
+    : OutputLayer(output, OutputLayerType::Primary)
+    , m_backend(backend)
+{
+}
+
+TermuxGuiQPainterLayer::~TermuxGuiQPainterLayer()
+{
+    destroyBuffer();
+}
+
+std::optional<OutputLayerBeginFrameInfo> TermuxGuiQPainterLayer::doBeginFrame()
+{
+    const QSize size = m_output->modeSize();
+    if (m_image.size() != size || !m_bufferValid) {
+        m_image = QImage(size, QImage::Format_RGBX8888);
+        if (m_image.isNull()) {
+            return std::nullopt;
+        }
+        m_image.fill(Qt::black);
+        if (!createBuffer(size)) {
+            return std::nullopt;
+        }
+    }
+
+    m_renderTime = std::make_unique<CpuRenderTimeQuery>();
+    return OutputLayerBeginFrameInfo{
+        .renderTarget = RenderTarget(&m_image),
+        .repaint = Region::infinite(),
+    };
+}
+
+bool TermuxGuiQPainterLayer::doEndFrame(const Region &, const Region &, OutputFrame *frame)
+{
+    m_renderTime->end();
+    frame->addRenderTimeQuery(std::move(m_renderTime));
+    return uploadBuffer();
+}
+
+DrmDevice *TermuxGuiQPainterLayer::scanoutDevice() const
+{
+    return nullptr;
+}
+
+FormatModifierMap TermuxGuiQPainterLayer::supportedDrmFormats() const
+{
+    return {};
+}
+
+void TermuxGuiQPainterLayer::releaseBuffers()
+{
+    destroyBuffer();
+}
+
+bool TermuxGuiQPainterLayer::createBuffer(const QSize &size)
+{
+    destroyBuffer();
+    if (tgui_hardware_buffer_create(m_backend->connection(), &m_buffer,
+                                    TGUI_HARDWARE_BUFFER_FORMAT_RGBX8888,
+                                    size.width(), size.height(),
+                                    TGUI_HARDWARE_BUFFER_CPU_NEVER,
+                                    TGUI_HARDWARE_BUFFER_CPU_OFTEN) != TGUI_ERR_OK) {
+        return false;
+    }
+    m_bufferValid = true;
+    if (tgui_surface_view_set_buffer(m_backend->connection(), m_backend->activity(),
+                                      m_backend->surface(), &m_buffer) != TGUI_ERR_OK) {
+        destroyBuffer();
+        return false;
+    }
+    return true;
+}
+
+bool TermuxGuiQPainterLayer::uploadBuffer()
+{
+    if (!m_bufferValid || !m_buffer.buffer) {
+        return false;
+    }
+
+    AHardwareBuffer_Desc desc{};
+    AHardwareBuffer_describe(m_buffer.buffer, &desc);
+
+    void *data = nullptr;
+    if (AHardwareBuffer_lock(m_buffer.buffer, AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN,
+                              -1, nullptr, &data) != 0 || !data) {
+        return false;
+    }
+
+    const auto *src = m_image.constBits();
+    auto *dst = static_cast<unsigned char *>(data);
+    const qsizetype rowBytes = static_cast<qsizetype>(m_image.width()) * 4;
+    const qsizetype strideBytes = static_cast<qsizetype>(desc.stride) * 4;
+    for (int y = 0; y < m_image.height(); ++y) {
+        memcpy(dst + y * strideBytes, src + y * m_image.bytesPerLine(), rowBytes);
+    }
+
+    const int fence = AHardwareBuffer_unlock(m_buffer.buffer, nullptr);
+    if (fence >= 0) {
+        close(fence);
+    }
+    return true;
+}
+
+void TermuxGuiQPainterLayer::destroyBuffer()
+{
+    if (m_bufferValid) {
+        tgui_hardware_buffer_destroy(m_backend->connection(), &m_buffer);
+        m_buffer = {};
+        m_bufferValid = false;
+    }
+}
+
+TermuxGuiQPainterBackend::TermuxGuiQPainterBackend(TermuxGuiBackend *backend)
+    : m_backend(backend)
+{
+    connect(backend, &VirtualBackend::outputAdded, this, &TermuxGuiQPainterBackend::addOutput);
+    for (BackendOutput *output : backend->outputs()) {
+        addOutput(output);
+    }
+}
+
+TermuxGuiQPainterBackend::~TermuxGuiQPainterBackend()
+{
+    for (BackendOutput *output : m_backend->outputs()) {
+        static_cast<VirtualOutput *>(output)->setOutputLayer(nullptr);
+    }
+}
+
+void TermuxGuiQPainterBackend::addOutput(BackendOutput *output)
+{
+    static_cast<VirtualOutput *>(output)->setOutputLayer(std::make_unique<TermuxGuiQPainterLayer>(output, m_backend));
+}
+
+QList<OutputLayer *> TermuxGuiQPainterBackend::compatibleOutputLayers(BackendOutput *output)
+{
+    return {static_cast<VirtualOutput *>(output)->outputLayer()};
+}
+
+} // namespace KWin
+
+#include "moc_termuxgui_qpainter_backend.cpp"
