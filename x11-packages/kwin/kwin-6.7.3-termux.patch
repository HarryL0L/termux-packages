@@ -290,9 +290,18 @@ if (KWIN_BUILD_X11)
     set(XWAYLAND_SESSION_SCRIPTS "/etc/xdg/Xwayland-session.d")
 endif()
 
+# NOTE: udev and libinput are only available on "real" Linux systems that use
+# udev/eudev for device management (e.g. desktop/server distros). Platforms
+# such as Termux (Android) do not ship them, and don't provide raw DRM/KMS or
+# evdev device access either, so KWin can gracefully build and run without
+# them: the libinput input backend and the DRM output backend's udev-based
+# GPU (hot-plug) discovery are simply disabled, while everything else
+# (X11 backend, nested Wayland backend, virtual backend, and their own
+# self-contained input handling) keeps working normally.
 find_package(Libinput 1.28)
-set_package_properties(Libinput PROPERTIES TYPE REQUIRED PURPOSE "Required for input handling on Wayland.")
-if (Libinput_VERSION VERSION_GREATER_EQUAL 1.30)
+set_package_properties(Libinput PROPERTIES TYPE OPTIONAL PURPOSE "Required for input handling through the DRM backend. Not required on platforms without udev, such as Termux.")
+set(HAVE_LIBINPUT ${Libinput_FOUND})
+if (Libinput_FOUND AND Libinput_VERSION VERSION_GREATER_EQUAL 1.30)
     set(HAVE_LIBINPUT_PLUGINS 1)
 else()
     set(HAVE_LIBINPUT_PLUGINS 0)
@@ -305,9 +314,17 @@ find_package(UDev)
 set_package_properties(UDev PROPERTIES
     URL "https://www.freedesktop.org/wiki/Software/systemd/"
     DESCRIPTION "Linux device library."
-    TYPE REQUIRED
-    PURPOSE "Required for input handling on Wayland."
+    TYPE OPTIONAL
+    PURPOSE "Required for udev-based GPU/input device discovery through the DRM backend. Not available on platforms such as Termux."
 )
+set(HAVE_UDEV ${UDev_FOUND})
+
+# The libinput backend needs a real udev context (libinput_udev_create_context),
+# so it can only be built when both libraries are present.
+set(HAVE_LIBINPUT_BACKEND 0)
+if (HAVE_LIBINPUT AND HAVE_UDEV)
+    set(HAVE_LIBINPUT_BACKEND 1)
+endif()
 
 find_package(Libdrm 2.4.118)
 set_package_properties(Libdrm PROPERTIES TYPE REQUIRED PURPOSE "Required for drm output on Wayland.")
