+/*
+    KWin - the KDE window manager
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QImage>
+#include <QLibrary>
+#include <QString>
+
+#include <cstdint>
+#include <string>
+
+#include <android/hardware_buffer.h>
+
+namespace KWin
+{
+
+class TermuxGuiConnection
+{
+public:
+    TermuxGuiConnection();
+    ~TermuxGuiConnection();
+
+    bool initialize(const QSize &size);
+    bool lock(QImage *image);
+    bool unlock();
+    bool present();
+    void shutdown();
+
+    bool isValid() const;
+    QSize size() const;
+
+private:
+    using RecvHardwareBufferFn = int (*)(int, AHardwareBuffer **);
+    using DescribeHardwareBufferFn = void (*)(const AHardwareBuffer *, AHardwareBuffer_Desc *);
+    using LockHardwareBufferFn = int (*)(AHardwareBuffer *, uint64_t, int32_t, const ARect *, void **);
+    using UnlockHardwareBufferFn = int (*)(AHardwareBuffer *, int32_t *);
+    using ReleaseHardwareBufferFn = void (*)(AHardwareBuffer *);
+
+    bool loadHardwareBufferApi();
+    bool createSockets();
+    bool startTermuxGui();
+    bool negotiateProtocol();
+    bool createActivity();
+    bool createSurfaceView();
+    bool createHardwareBuffer();
+
+    bool sendMethod(uint32_t method, const std::string &payload);
+    bool writeAll(int fd, const void *data, size_t size);
+    bool readAll(int fd, void *data, size_t size);
+    bool readDelimited(std::string &out);
+
+    static void varint(std::string &out, uint64_t value);
+    static void fieldInt32(std::string &out, uint32_t field, int32_t value);
+    static void fieldMessage(std::string &out, uint32_t field, const std::string &message);
+    static bool readVarint(const std::string &data, size_t &pos, uint64_t &value);
+    static bool getInt32Default(const std::string &data, uint32_t wanted, int32_t defaultValue, int32_t &value);
+
+    static int makeAbstractSocket(const std::string &name);
+
+    QLibrary m_android;
+    RecvHardwareBufferFn m_recvHardwareBuffer = nullptr;
+    DescribeHardwareBufferFn m_describeHardwareBuffer = nullptr;
+    LockHardwareBufferFn m_lockHardwareBuffer = nullptr;
+    UnlockHardwareBufferFn m_unlockHardwareBuffer = nullptr;
+    ReleaseHardwareBufferFn m_releaseHardwareBuffer = nullptr;
+
+    int m_mainListen = -1;
+    int m_eventListen = -1;
+    int m_mainFd = -1;
+    int m_eventFd = -1;
+    int32_t m_activityId = -1;
+    int32_t m_surfaceViewId = -1;
+    int32_t m_bufferId = -1;
+
+    AHardwareBuffer *m_buffer = nullptr;
+    AHardwareBuffer_Desc m_bufferDesc{};
+    QSize m_size;
+    bool m_locked = false;
+    void *m_pixels = nullptr;
+    std::string m_mainName;
+    std::string m_eventName;
+};
+
+} // namespace KWin
