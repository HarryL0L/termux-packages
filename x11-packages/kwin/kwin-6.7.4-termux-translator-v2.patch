+/*
+    KWin - the KDE window manager
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_output.h"
+
+#include "core/outputconfiguration.h"
+#include "core/outputlayer.h"
+#include "core/renderbackend.h"
+#include "core/renderloop.h"
+#include "termuxgui_connection.h"
+#include "utils/softwarevsyncmonitor.h"
+#include "translator_backend.h"
+
+namespace KWin
+{
+
+TranslatorOutput::TranslatorOutput(TranslatorBackend *backend, const QSize &pixelSize, qreal scale)
+    : BackendOutput()
+    , m_backend(backend)
+    , m_renderLoop(std::make_unique<RenderLoop>(this))
+    , m_vsyncMonitor(SoftwareVsyncMonitor::create())
+{
+    connect(m_vsyncMonitor.get(), &VsyncMonitor::vblankOccurred, this, &TranslatorOutput::vblank);
+
+    const auto mode = std::make_shared<OutputMode>(OutputModeline(pixelSize, 60000, OutputModeline::Flag::Preferred));
+    setInformation(Information{
+        .name = QStringLiteral("Translator-1"),
+        .manufacturer = QStringLiteral("Termux"),
+        .model = QStringLiteral("Termux:GUI"),
+        .physicalSize = QSize(0, 0),
+        .capabilities = Capability::CustomModes,
+    });
+    setState(State{
+        .scale = scale,
+        .modes = {mode},
+        .currentMode = mode,
+        .scaleSetting = scale,
+    });
+    m_renderLoop->setRefreshRate(mode->refreshRate());
+    m_vsyncMonitor->setRefreshRate(mode->refreshRate());
+}
+
+TranslatorOutput::~TranslatorOutput()
+{
+}
+
+RenderLoop *TranslatorOutput::renderLoop() const
+{
+    return m_renderLoop.get();
+}
+
+bool TranslatorOutput::testPresentation(const std::shared_ptr<OutputFrame> &frame)
+{
+    return true;
+}
+
+bool TranslatorOutput::present(const QList<OutputLayer *> &layersToUpdate, const std::shared_ptr<OutputFrame> &frame)
+{
+    Q_UNUSED(layersToUpdate)
+    if (!m_backend->connection()->present()) {
+        return false;
+    }
+    m_frame = frame;
+    m_vsyncMonitor->arm();
+    return true;
+}
+
+void TranslatorOutput::vblank(std::chrono::nanoseconds timestamp)
+{
+    if (m_frame) {
+        m_frame->presented(timestamp, PresentationMode::VSync);
+        m_frame.reset();
+    }
+}
+
+void TranslatorOutput::setOutputLayer(std::unique_ptr<OutputLayer> &&layer)
+{
+    m_layer = std::move(layer);
+}
+
+OutputLayer *TranslatorOutput::outputLayer() const
+{
+    return m_layer.get();
+}
+
+} // namespace KWin
+
+#include "moc_translator_output.cpp"
