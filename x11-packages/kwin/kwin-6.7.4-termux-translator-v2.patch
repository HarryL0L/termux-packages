+/*
+    KWin - the KDE window manager
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include "core/outputbackend.h"
+
+namespace KWin
+{
+
+class TermuxGuiConnection;
+class TranslatorOutput;
+
+class TranslatorBackend : public OutputBackend
+{
+    Q_OBJECT
+
+public:
+    explicit TranslatorBackend(const QSize &size, qreal scale, QObject *parent = nullptr);
+    ~TranslatorBackend() override;
+
+    bool initialize() override;
+    std::unique_ptr<QPainterBackend> createQPainterBackend() override;
+    std::unique_ptr<InputBackend> createInputBackend() override;
+
+    EglDisplay *sceneEglDisplayObject() const override;
+    QList<CompositingType> supportedCompositors() const override;
+    QList<BackendOutput *> outputs() const override;
+    QString supportInformation() const override;
+
+    TermuxGuiConnection *connection() const;
+
+private:
+    const QSize m_size;
+    const qreal m_scale;
+    std::unique_ptr<TermuxGuiConnection> m_connection;
+    std::unique_ptr<TranslatorOutput> m_output;
+};
