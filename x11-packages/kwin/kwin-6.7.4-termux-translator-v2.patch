+/*
+    KWin - the KDE window manager
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "termuxgui_connection.h"
+
+#include "translator_logging.h"
+
+#include <QProcess>
+#include <QRandomGenerator>
+
+#include <arpa/inet.h>
+#include <cerrno>
+#include <cstddef>
+#include <cstring>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+namespace KWin
+{
+
+TermuxGuiConnection::TermuxGuiConnection()
+    : m_android(QStringLiteral("libandroid.so"))
+{
+}
+
+TermuxGuiConnection::~TermuxGuiConnection()
+{
+    shutdown();
+}
+
+void TermuxGuiConnection::varint(std::string &out, uint64_t value)
+{
+    while (value >= 0x80) {
+        out.push_back(char((value & 0x7f) | 0x80));
+        value >>= 7;
+    }
+    out.push_back(char(value));
+}
+
+void TermuxGuiConnection::fieldInt32(std::string &out, uint32_t field, int32_t value)
+{
+    varint(out, uint64_t(field) << 3);
+    varint(out, uint64_t(int64_t(value)));
+}
+
+void TermuxGuiConnection::fieldMessage(std::string &out, uint32_t field, const std::string &message)
+{
+    varint(out, (uint64_t(field) << 3) | 2);
+    varint(out, message.size());
+    out += message;
+}
+
+bool TermuxGuiConnection::readVarint(const std::string &data, size_t &pos, uint64_t &value)
+{
+    value = 0;
+    int shift = 0;
+    while (pos < data.size() && shift <= 63) {
+        const uint8_t c = uint8_t(data[pos++]);
+        value |= uint64_t(c & 0x7f) << shift;
+        if (!(c & 0x80)) {
+            return true;
+        }
+        shift += 7;
+    }
+    return false;
+}
+
+bool TermuxGuiConnection::getInt32Default(const std::string &data, uint32_t wanted, int32_t defaultValue, int32_t &value)
+{
+    size_t pos = 0;
+    value = defaultValue;
+    while (pos < data.size()) {
+        uint64_t key;
+        if (!readVarint(data, pos, key)) {
+            return false;
+        }
+        const uint32_t field = uint32_t(key >> 3);
+        const uint32_t wire = uint32_t(key & 7);
+
+        if (wire == 0) {
+            uint64_t v;
+            if (!readVarint(data, pos, v)) {
+                return false;
+            }
+            if (field == wanted) {
+                value = int32_t(uint32_t(v));
+            }
+        } else if (wire == 1) {
+            if (pos + 8 > data.size()) {
+                return false;
+            }
+            pos += 8;
+        } else if (wire == 2) {
+            uint64_t n;
+            if (!readVarint(data, pos, n) || n > data.size() - pos) {
+                return false;
+            }
+            pos += size_t(n);
+        } else if (wire == 5) {
+            if (pos + 4 > data.size()) {
+                return false;
+            }
+            pos += 4;
+        } else {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::writeAll(int fd, const void *data, size_t size)
+{
+    const auto *bytes = static_cast<const char *>(data);
+    while (size) {
+        const ssize_t result = send(fd, bytes, size, MSG_NOSIGNAL);
+        if (result < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        if (result == 0) {
+            return false;
+        }
+        bytes += result;
+        size -= size_t(result);
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::readAll(int fd, void *data, size_t size)
+{
+    auto *bytes = static_cast<char *>(data);
+    while (size) {
+        const ssize_t result = recv(fd, bytes, size, 0);
+        if (result < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        if (result == 0) {
+            return false;
+        }
+        bytes += result;
+        size -= size_t(result);
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::readDelimited(std::string &out)
+{
+    uint64_t length = 0;
+    int shift = 0;
+    for (;;) {
+        uint8_t c;
+        if (!readAll(m_mainFd, &c, 1)) {
+            return false;
+        }
+        length |= uint64_t(c & 0x7f) << shift;
+        if (!(c & 0x80)) {
+            break;
+        }
+        shift += 7;
+        if (shift > 63) {
+            return false;
+        }
+    }
+
+    if (length > 16 * 1024 * 1024) {
+        return false;
+    }
+    out.resize(size_t(length));
+    return !length || readAll(m_mainFd, out.data(), size_t(length));
+}
+
+bool TermuxGuiConnection::sendMethod(uint32_t method, const std::string &payload)
+{
+    std::string message;
+    fieldMessage(message, method, payload);
+
+    std::string framed;
+    varint(framed, message.size());
+    framed += message;
+    return writeAll(m_mainFd, framed.data(), framed.size());
+}
+
+int TermuxGuiConnection::makeAbstractSocket(const std::string &name)
+{
+    const int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (fd < 0) {
+        return -1;
+    }
+
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    if (name.size() + 1 >= sizeof(address.sun_path)) {
+        close(fd);
+        return -1;
+    }
+    address.sun_path[0] = '\0';
+    memcpy(address.sun_path + 1, name.data(), name.size());
+
+    const socklen_t length = offsetof(sockaddr_un, sun_path) + 1 + name.size();
+    if (bind(fd, reinterpret_cast<sockaddr *>(&address), length) < 0 || listen(fd, 1) < 0) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+bool TermuxGuiConnection::loadHardwareBufferApi()
+{
+    if (!m_android.load()) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to load libandroid.so:" << m_android.errorString();
+        return false;
+    }
+
+    m_recvHardwareBuffer = reinterpret_cast<RecvHardwareBufferFn>(m_android.resolve("AHardwareBuffer_recvHandleFromUnixSocket"));
+    m_describeHardwareBuffer = reinterpret_cast<DescribeHardwareBufferFn>(m_android.resolve("AHardwareBuffer_describe"));
+    m_lockHardwareBuffer = reinterpret_cast<LockHardwareBufferFn>(m_android.resolve("AHardwareBuffer_lock"));
+    m_unlockHardwareBuffer = reinterpret_cast<UnlockHardwareBufferFn>(m_android.resolve("AHardwareBuffer_unlock"));
+    m_releaseHardwareBuffer = reinterpret_cast<ReleaseHardwareBufferFn>(m_android.resolve("AHardwareBuffer_release"));
+
+    if (!m_recvHardwareBuffer || !m_describeHardwareBuffer || !m_lockHardwareBuffer || !m_unlockHardwareBuffer || !m_releaseHardwareBuffer) {
+        qCWarning(KWIN_TRANSLATOR) << "Required AHardwareBuffer symbols are unavailable";
+        return false;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::createSockets()
+{
+    const quint64 random = QRandomGenerator::global()->generate64();
+    const QString tag = QStringLiteral("kwin-translator-%1-%2").arg(getpid()).arg(random);
+    m_mainName = tag.toStdString() + "-main";
+    m_eventName = tag.toStdString() + "-event";
+
+    m_mainListen = makeAbstractSocket(m_mainName);
+    m_eventListen = makeAbstractSocket(m_eventName);
+    if (m_mainListen < 0 || m_eventListen < 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI sockets";
+        return false;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::startTermuxGui()
+{
+    const QStringList arguments{
+        QStringLiteral("broadcast"),
+        QStringLiteral("--user"), QStringLiteral("0"),
+        QStringLiteral("-n"), QStringLiteral("com.termux.gui/.GUIReceiver"),
+        QStringLiteral("--es"), QStringLiteral("mainSocket"), QString::fromStdString(m_mainName),
+        QStringLiteral("--es"), QStringLiteral("eventSocket"), QString::fromStdString(m_eventName),
+    };
+
+    if (QProcess::execute(QStringLiteral("/system/bin/am"), arguments) != 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to start Termux:GUI through GUIReceiver";
+        return false;
+    }
+
+    m_mainFd = accept4(m_mainListen, nullptr, nullptr, SOCK_CLOEXEC);
+    m_eventFd = accept4(m_eventListen, nullptr, nullptr, SOCK_CLOEXEC);
+    if (m_mainFd < 0 || m_eventFd < 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to accept Termux:GUI connections";
+        return false;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::negotiateProtocol()
+{
+    const uint8_t version = 0;
+    if (!writeAll(m_mainFd, &version, 1)) {
+        return false;
+    }
+
+    uint8_t status = 0xff;
+    if (!readAll(m_mainFd, &status, 1) || status != 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Termux:GUI rejected protocol v0 with status" << status;
+        return false;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::createActivity()
+{
+    std::string request;
+    fieldInt32(request, 1, -1);
+    fieldInt32(request, 2, 0);
+    if (!sendMethod(16, request)) {
+        return false;
+    }
+
+    std::string response;
+    if (!readDelimited(response)) {
+        return false;
+    }
+    if (!getInt32Default(response, 1, -1, m_activityId) || m_activityId < 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI activity";
+        return false;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::createSurfaceView()
+{
+    std::string create;
+    fieldInt32(create, 1, m_activityId);
+    fieldInt32(create, 2, -1);
+
+    std::string request;
+    fieldMessage(request, 1, create);
+    if (!sendMethod(130, request)) {
+        return false;
+    }
+
+    std::string response;
+    if (!readDelimited(response)) {
+        return false;
+    }
+    if (!getInt32Default(response, 1, -1, m_surfaceViewId) || m_surfaceViewId < 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI SurfaceView";
+        return false;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::createHardwareBuffer()
+{
+    std::string request;
+    fieldInt32(request, 1, m_size.width());
+    fieldInt32(request, 2, m_size.height());
+    fieldInt32(request, 3, 0); // RGBA8888
+    fieldInt32(request, 5, 2); // CPU_WRITE_OFTEN
+
+    if (!sendMethod(700, request)) {
+        return false;
+    }
+
+    uint32_t wireId = 0;
+    if (!readAll(m_mainFd, &wireId, sizeof(wireId))) {
+        return false;
+    }
+    m_bufferId = int32_t(ntohl(wireId));
+    if (m_bufferId < 0) {
+        qCWarning(KWIN_TRANSLATOR) << "Termux:GUI failed to create HardwareBuffer:" << m_bufferId;
+        return false;
+    }
+
+    if (m_recvHardwareBuffer(m_mainFd, &m_buffer) != 0 || !m_buffer) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to receive AHardwareBuffer from Termux:GUI";
+        return false;
+    }
+
+    m_describeHardwareBuffer(m_buffer, &m_bufferDesc);
+    if (m_bufferDesc.width != uint32_t(m_size.width()) || m_bufferDesc.height != uint32_t(m_size.height()) || m_bufferDesc.format != AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM) {
+        qCWarning(KWIN_TRANSLATOR) << "Unexpected HardwareBuffer:" << m_bufferDesc.width << m_bufferDesc.height << m_bufferDesc.format;
+        return false;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::initialize(const QSize &size)
+{
+    m_size = size;
+    if (m_size.isEmpty() || !loadHardwareBufferApi() || !createSockets() || !startTermuxGui() || !negotiateProtocol() || !createActivity() || !createSurfaceView() || !createHardwareBuffer()) {
+        shutdown();
+        return false;
+    }
+    return true;
+}
+
+bool TermuxGuiConnection::lock(QImage *image)
+{
+    if (!m_buffer || m_locked || !image) {
+        return false;
+    }
+
+    if (m_lockHardwareBuffer(m_buffer, AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN, -1, nullptr, &m_pixels) != 0 || !m_pixels) {
+        return false;
+    }
+
+    *image = QImage(static_cast<uchar *>(m_pixels), int(m_bufferDesc.width), int(m_bufferDesc.height), int(m_bufferDesc.stride * 4), QImage::Format_RGBA8888);
+    m_locked = true;
+    return !image->isNull();
+}
+
+bool TermuxGuiConnection::unlock()
+{
+    if (!m_buffer || !m_locked) {
+        return false;
+    }
+    const bool success = m_unlockHardwareBuffer(m_buffer, nullptr) == 0;
+    m_locked = false;
+    m_pixels = nullptr;
+    return success;
+}
+
+bool TermuxGuiConnection::present()
+{
+    if (m_mainFd < 0 || m_activityId < 0 || m_surfaceViewId < 0 || m_bufferId < 0) {
+        return false;
+    }
+
+    std::string viewMessage;
+    fieldInt32(viewMessage, 1, m_activityId);
+    fieldInt32(viewMessage, 2, m_surfaceViewId);
+
+    std::string request;
+    fieldMessage(request, 1, viewMessage);
+    fieldInt32(request, 2, m_bufferId);
+
+    if (!sendMethod(702, request)) {
+        return false;
+    }
+
+    std::string response;
+    return readDelimited(response);
+}
+
+void TermuxGuiConnection::shutdown()
+{
+    if (m_locked) {
+        unlock();
+    }
+    if (m_buffer && m_releaseHardwareBuffer) {
+        m_releaseHardwareBuffer(m_buffer);
+        m_buffer = nullptr;
+    }
+
+    if (m_mainFd >= 0) {
+        close(m_mainFd);
+        m_mainFd = -1;
+    }
+    if (m_eventFd >= 0) {
+        close(m_eventFd);
+        m_eventFd = -1;
+    }
+    if (m_mainListen >= 0) {
+        close(m_mainListen);
+        m_mainListen = -1;
+    }
+    if (m_eventListen >= 0) {
+        close(m_eventListen);
+        m_eventListen = -1;
+    }
+    m_activityId = -1;
+    m_surfaceViewId = -1;
+    m_bufferId = -1;
+    m_pixels = nullptr;
+    m_locked = false;
+}
+
+bool TermuxGuiConnection::isValid() const
+{
+    return m_buffer != nullptr && m_mainFd >= 0;
+}
+
+QSize TermuxGuiConnection::size() const
+{
+    return m_size;
+}
+
+} // namespace KWin
