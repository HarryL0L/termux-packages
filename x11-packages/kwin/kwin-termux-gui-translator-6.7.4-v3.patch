+*/
+#include "translator_qpainter_backend.h"
+
+#include "core/outputlayer.h"
+#include "translator_output.h"
+
+namespace KWin
+{
+
+TranslatorQPainterLayer::TranslatorQPainterLayer(BackendOutput *output, TranslatorOutput *backend)
+    : OutputLayer(output, OutputLayerType::Primary)
+    , m_output(backend)
+{
+}
+
+TranslatorQPainterLayer::~TranslatorQPainterLayer()
+{
+}
+
+std::optional<OutputLayerBeginFrameInfo> TranslatorQPainterLayer::doBeginFrame()
+{
+    QImage *image = m_output->beginRender();
+    if (!image) {
+        return std::nullopt;
+    }
+
+    m_renderTime = std::make_unique<CpuRenderTimeQuery>();
+    return OutputLayerBeginFrameInfo{
+        .renderTarget = RenderTarget(image),
+        .repaint = Region::infinite(),
+    };
+}
+
+bool TranslatorQPainterLayer::doEndFrame(const Region &renderedDeviceRegion, const Region &damagedDeviceRegion, OutputFrame *frame)
+{
+    Q_UNUSED(renderedDeviceRegion)
+    Q_UNUSED(damagedDeviceRegion)
+
+    if (m_renderTime) {
+        m_renderTime->end();
+        frame->addRenderTimeQuery(std::move(m_renderTime));
+    }
+
+    return m_output->endRender();
+}
+
+DrmDevice *TranslatorQPainterLayer::scanoutDevice() const
+{
+    return nullptr;
+}
+
+FormatModifierMap TranslatorQPainterLayer::supportedDrmFormats() const
+{
+    return {};
+}
+
+void TranslatorQPainterLayer::releaseBuffers()
+{
+    m_output->endRender();
+}
+
+TranslatorQPainterBackend::TranslatorQPainterBackend(TranslatorOutput *output)
+    : m_output(output)
+{
+    if (!TranslatorOutput::isHardwareBufferMappingAvailable()) {
+        setFailed(QStringLiteral("AHardwareBuffer CPU mapping functions are unavailable"));
+        return;
+    }
+
+    m_layer = std::make_unique<TranslatorQPainterLayer>(output, output);
+}
+
+TranslatorQPainterBackend::~TranslatorQPainterBackend()
+{
+}
+
+QList<OutputLayer *> TranslatorQPainterBackend::compatibleOutputLayers(BackendOutput *output)
+{
+    if (output != m_output || !m_layer) {
+        return {};
+    }
+
+    return {m_layer.get()};
+}
+
+} // namespace KWin
