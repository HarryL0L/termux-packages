+*/
+#include "translator_backend.h"
+
+#include "core/inputbackend.h"
+#include "core/inputdevice.h"
+#include "translator_connection.h"
+#include "translator_output.h"
+#include "translator_qpainter_backend.h"
+
+#include <QDebug>
+#include <QHash>
+#include <optional>
+#include <chrono>
+
+namespace KWin
+{
+
+namespace
+{
+
+class TranslatorInputDevice : public InputDevice
+{
+public:
+    explicit TranslatorInputDevice(TranslatorBackend *backend)
+        : InputDevice(backend)
+    {
+    }
+
+    QString name() const override
+    {
+        return QStringLiteral("Termux:GUI Touchscreen");
+    }
+
+    bool isEnabled() const override
+    {
+        return m_enabled;
+    }
+
+    void setEnabled(bool enabled) override
+    {
+        m_enabled = enabled;
+    }
+
+    bool isKeyboard() const override
+    {
+        return false;
+    }
+
+    bool isPointer() const override
+    {
+        return false;
+    }
+
+    bool isTouchpad() const override
+    {
+        return false;
+    }
+
+    bool isTouch() const override
+    {
+        return true;
+    }
+
+    bool isTabletTool() const override
+    {
+        return false;
+    }
+
+    bool isTabletPad() const override
+    {
+        return false;
+    }
+
+    bool isTabletModeSwitch() const override
+    {
+        return false;
+    }
+
+    bool isLidSwitch() const override
+    {
+        return false;
+    }
+
+private:
+    bool m_enabled = true;
+};
+
+class TranslatorInputBackend : public InputBackend
+{
+public:
+    explicit TranslatorInputBackend(TranslatorBackend *backend)
+        : InputBackend(backend)
+        , m_backend(backend)
+        , m_device(std::make_unique<TranslatorInputDevice>(backend))
+    {
+        connect(backend->connection(), &TranslatorConnection::touchEvent,
+                this, &TranslatorInputBackend::handleTouchEvent);
+        connect(backend->connection(), &TranslatorConnection::activityDestroyed,
+                this, [this]() {
+                    if (m_device) {
+                        Q_EMIT m_device->touchCanceled(m_device.get());
+                        Q_EMIT m_device->touchFrame(m_device.get());
+                    }
+                });
+    }
+
+    void initialize() override
+    {
+        Q_EMIT deviceAdded(m_device.get());
+    }
+
+private:
+    void handleTouchEvent(const TranslatorTouchEvent &event)
+    {
+        TranslatorOutput *output = m_backend->output();
+        if (!output || !m_device->isEnabled()) {
+            return;
+        }
+
+        const std::chrono::microseconds time(std::chrono::milliseconds(event.time));
+
+        auto globalPosition = [output](const QPointF &devicePosition) {
+            QPointF position = output->transform().map(devicePosition, output->modeSize());
+            position -= output->deviceOffset();
+            position /= output->scale();
+            position += QPointF(output->position());
+            return position;
+        };
+
+        QHash<int, QPointF> currentPointers;
+        for (const TranslatorTouchPoint &pointer : event.pointers) {
+            currentPointers.insert(pointer.id, pointer.position);
+        }
+
+        auto pointerAtIndex = [&event](uint32_t index) -> const TranslatorTouchPoint * {
+            if (index >= uint32_t(event.pointers.size())) {
+                return nullptr;
+            }
+            return &event.pointers.at(int(index));
+        };
+
+        auto removedPointerId = [&]() -> std::optional<int> {
+            for (auto it = m_activePointers.cbegin(); it != m_activePointers.cend(); ++it) {
+                if (!currentPointers.contains(it.key())) {
+                    return it.key();
+                }
+            }
+            return std::nullopt;
+        };
+
+        switch (event.action) {
+        case TGUI_TOUCH_DOWN: {
+            m_activePointers.clear();
+            const TranslatorTouchPoint *pointer = pointerAtIndex(event.index);
+            if (!pointer && !event.pointers.isEmpty()) {
+                pointer = &event.pointers.constFirst();
+            }
+            if (pointer) {
+                m_activePointers.insert(pointer->id, pointer->position);
+                Q_EMIT m_device->touchDown(pointer->id, globalPosition(pointer->position), time, m_device.get());
+            }
+            Q_EMIT m_device->touchFrame(m_device.get());
+            break;
+        }
+        case TGUI_TOUCH_POINTER_DOWN: {
+            const TranslatorTouchPoint *pointer = pointerAtIndex(event.index);
+            if (!pointer) {
+                for (const TranslatorTouchPoint &candidate : event.pointers) {
+                    if (!m_activePointers.contains(candidate.id)) {
+                        pointer = &candidate;
+                        break;
+                    }
+                }
+            }
+            if (pointer) {
+                m_activePointers.insert(pointer->id, pointer->position);
+                Q_EMIT m_device->touchDown(pointer->id, globalPosition(pointer->position), time, m_device.get());
+            }
+            for (auto it = currentPointers.cbegin(); it != currentPointers.cend(); ++it) {
+                m_activePointers.insert(it.key(), it.value());
+            }
+            Q_EMIT m_device->touchFrame(m_device.get());
+            break;
+        }
+        case TGUI_TOUCH_MOVE:
+            for (const QVector<TranslatorTouchPoint> &pointers : event.batchedPointers) {
+                for (const TranslatorTouchPoint &pointer : pointers) {
+                    m_activePointers.insert(pointer.id, pointer.position);
+                    Q_EMIT m_device->touchMotion(pointer.id, globalPosition(pointer.position), time, m_device.get());
+                }
+            }
+            Q_EMIT m_device->touchFrame(m_device.get());
+            break;
+        case TGUI_TOUCH_POINTER_UP: {
+            const TranslatorTouchPoint *pointer = pointerAtIndex(event.index);
+            std::optional<int> removedId = removedPointerId();
+            if (!removedId && pointer) {
+                removedId = pointer->id;
+            }
+            if (removedId) {
+                Q_EMIT m_device->touchUp(*removedId, time, m_device.get());
+                m_activePointers.remove(*removedId);
+            }
+            for (auto it = currentPointers.cbegin(); it != currentPointers.cend(); ++it) {
+                m_activePointers.insert(it.key(), it.value());
+            }
+            Q_EMIT m_device->touchFrame(m_device.get());
+            break;
+        }
+        case TGUI_TOUCH_UP: {
+            std::optional<int> removedId;
+            const TranslatorTouchPoint *pointer = pointerAtIndex(event.index);
+            if (pointer) {
+                removedId = pointer->id;
+            } else if (!m_activePointers.isEmpty()) {
+                removedId = m_activePointers.constBegin().key();
+            }
+            if (removedId) {
+                Q_EMIT m_device->touchUp(*removedId, time, m_device.get());
+            }
+            m_activePointers.clear();
+            Q_EMIT m_device->touchFrame(m_device.get());
+            break;
+        }
+        case TGUI_TOUCH_CANCEL:
+            m_activePointers.clear();
+            Q_EMIT m_device->touchCanceled(m_device.get());
+            Q_EMIT m_device->touchFrame(m_device.get());
+            break;
+        }
+    }
+
+    TranslatorBackend *m_backend;
+    std::unique_ptr<TranslatorInputDevice> m_device;
+    QHash<int, QPointF> m_activePointers;
+};
+
+} // namespace
+
+TranslatorBackend::TranslatorBackend(const QSize &initialSize, qreal scale, QObject *parent)
+    : OutputBackend(parent)
+    , m_initialSize(initialSize)
+    , m_scale(scale)
+    , m_connection(std::make_unique<TranslatorConnection>(this))
+{
+    connect(m_connection.get(), &TranslatorConnection::surfaceChanged,
+            this, [this](const QSize &size) {
+                if (m_output) {
+                    m_output->handleSurfaceChanged(size);
+                }
+            });
+    connect(m_connection.get(), &TranslatorConnection::frameComplete,
+            this, [this](uint64_t timestamp) {
+                if (m_output) {
+                    m_output->handleFrameComplete(timestamp);
+                }
+            });
+    connect(m_connection.get(), &TranslatorConnection::activityDestroyed,
+            this, [this]() {
+                if (m_output) {
+                    m_output->handleActivityDestroyed();
+                }
+            });
+}
+
+TranslatorBackend::~TranslatorBackend()
+{
+}
+
+bool TranslatorBackend::initialize()
+{
+    if (!m_connection->initialize()) {
+        return false;
+    }
+
+    if (!m_output) {
+        m_output = std::make_unique<TranslatorOutput>(m_connection.get(), m_initialSize, m_scale);
+        Q_EMIT outputAdded(m_output.get());
+        Q_EMIT outputsQueried();
+    }
+
+    return true;
+}
+
+std::unique_ptr<InputBackend> TranslatorBackend::createInputBackend()
+{
+    return std::make_unique<TranslatorInputBackend>(this);
+}
+
+std::unique_ptr<QPainterBackend> TranslatorBackend::createQPainterBackend()
+{
+    if (!m_output) {
+        return nullptr;
+    }
+    return std::make_unique<TranslatorQPainterBackend>(m_output.get());
+}
+
+QList<CompositingType> TranslatorBackend::supportedCompositors() const
+{
+    return {QPainterCompositing};
+}
+
+QList<BackendOutput *> TranslatorBackend::outputs() const
+{
+    if (!m_output) {
+        return {};
+    }
+    return {m_output.get()};
+}
+
+EglDisplay *TranslatorBackend::sceneEglDisplayObject() const
+{
+    return nullptr;
+}
+
+TranslatorConnection *TranslatorBackend::connection() const
+{
+    return m_connection.get();
+}
+
+TranslatorOutput *TranslatorBackend::output() const
+{
+    return m_output.get();
+}
+
+} // namespace KWin
+
+#include "moc_translator_backend.cpp"
