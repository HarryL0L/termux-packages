diff --git a/src/backends/translator/translator_output.cpp b/src/backends/translator/translator_output.cpp
new file mode 100644
index 0000000..4c5fb6e
--- /dev/null
+++ b/src/backends/translator/translator_output.cpp
@@ -0,0 +1,365 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_output.h"
+
+#include "core/outputconfiguration.h"
+#include "core/outputlayer.h"
+#include "core/renderbackend.h"
+#include "core/renderloop.h"
+#include "translator_connection.h"
+#include "utils/common.h"
+
+#include <QDebug>
+
+#include <dlfcn.h>
+#include <chrono>
+#include <cstring>
+#include <vector>
+
+#if __has_include(<android/hardware_buffer.h>)
+#include <android/hardware_buffer.h>
+#else
+struct ARect
+{
+    int32_t left;
+    int32_t top;
+    int32_t right;
+    int32_t bottom;
+};
+
+struct AHardwareBuffer_Desc
+{
+    uint32_t width;
+    uint32_t height;
+    uint32_t layers;
+    uint32_t format;
+    uint64_t usage;
+    uint32_t stride;
+    uint32_t rfu0;
+    uint64_t rfu1;
+};
+
+#endif
+
+namespace KWin
+{
+
+namespace
+{
+
+constexpr uint64_t CpuWriteOften = 3ULL << 4;
+
+struct AndroidHardwareBufferApi
+{
+    using LockFunction = int (*)(AHardwareBuffer *, uint64_t, int32_t, const ARect *, void **);
+    using UnlockFunction = int (*)(AHardwareBuffer *, int32_t *);
+    using DescribeFunction = void (*)(const AHardwareBuffer *, AHardwareBuffer_Desc *);
+
+    void *library = nullptr;
+    LockFunction lock = nullptr;
+    UnlockFunction unlock = nullptr;
+    DescribeFunction describe = nullptr;
+
+    AndroidHardwareBufferApi()
+    {
+        library = dlopen("libandroid.so", RTLD_NOW | RTLD_LOCAL);
+        if (!library) {
+            return;
+        }
+
+        lock = reinterpret_cast<LockFunction>(dlsym(library, "AHardwareBuffer_lock"));
+        unlock = reinterpret_cast<UnlockFunction>(dlsym(library, "AHardwareBuffer_unlock"));
+        describe = reinterpret_cast<DescribeFunction>(dlsym(library, "AHardwareBuffer_describe"));
+
+        if (!lock || !unlock || !describe) {
+            dlclose(library);
+            library = nullptr;
+            lock = nullptr;
+            unlock = nullptr;
+            describe = nullptr;
+        }
+    }
+
+    ~AndroidHardwareBufferApi()
+    {
+        if (library) {
+            dlclose(library);
+        }
+    }
+
+    bool valid() const
+    {
+        return library && lock && unlock && describe;
+    }
+};
+
+AndroidHardwareBufferApi &androidHardwareBufferApi()
+{
+    static AndroidHardwareBufferApi api;
+    return api;
+}
+
+} // namespace
+
+TranslatorOutput::TranslatorOutput(TranslatorConnection *connection, const QSize &size, qreal scale)
+    : BackendOutput()
+    , m_connection(connection)
+    , m_renderLoop(std::make_unique<RenderLoop>(this))
+{
+    setInformation(Information{
+        .name = QStringLiteral("Termux:GUI-1"),
+        .manufacturer = QStringLiteral("Termux:GUI"),
+        .model = QStringLiteral("SurfaceView"),
+        .physicalSize = QSize(),
+        .capabilities = {},
+        .panelOrientation = OutputTransform::Kind::Normal,
+        .internal = true,
+    });
+
+    QList<std::shared_ptr<OutputMode>> modes;
+    modes.push_back(std::make_shared<OutputMode>(OutputModeline(size, 60000, OutputModeline::Flag::Preferred)));
+
+    State state = m_state;
+    state.scale = scale;
+    state.scaleSetting = scale;
+    state.modes = modes;
+    state.currentMode = modes.front();
+    setState(state);
+    m_renderLoop->setRefreshRate(60000);
+}
+
+TranslatorOutput::~TranslatorOutput()
+{
+    if (m_locked) {
+        endRender();
+    }
+    destroyBuffer();
+}
+
+RenderLoop *TranslatorOutput::renderLoop() const
+{
+    return m_renderLoop.get();
+}
+
+bool TranslatorOutput::testPresentation(const std::shared_ptr<OutputFrame> &frame)
+{
+    Q_UNUSED(frame)
+    return m_bufferValid && !m_inFlight;
+}
+
+bool TranslatorOutput::present(const QList<OutputLayer *> &layersToUpdate, const std::shared_ptr<OutputFrame> &frame)
+{
+    Q_UNUSED(layersToUpdate);
+
+    if (!m_bufferValid || m_locked || m_inFlight || !m_connection->setBuffer(&m_buffer)) {
+        return false;
+    }
+
+    m_frame = frame;
+    m_inFlight = true;
+    return true;
+}
+
+QImage *TranslatorOutput::beginRender()
+{
+    if (!m_bufferValid || m_inFlight || m_locked || !androidHardwareBufferApi().valid()) {
+        return nullptr;
+    }
+
+    AHardwareBuffer_Desc description{};
+    androidHardwareBufferApi().describe(m_buffer.buffer, &description);
+
+    if (description.stride < uint32_t(m_bufferSize.width())) {
+        qCWarning(KWIN_CORE) << "Termux:GUI returned an invalid hardware buffer stride";
+        return nullptr;
+    }
+
+    ARect rect{
+        .left = 0,
+        .top = 0,
+        .right = m_bufferSize.width(),
+        .bottom = m_bufferSize.height(),
+    };
+
+    void *address = nullptr;
+    const int result = androidHardwareBufferApi().lock(m_buffer.buffer, CpuWriteOften, -1, &rect, &address);
+    if (result != 0 || !address) {
+        qCWarning(KWIN_CORE) << "AHardwareBuffer_lock failed:" << result;
+        return nullptr;
+    }
+
+    m_image = QImage(static_cast<uchar *>(address),
+                     m_bufferSize.width(),
+                     m_bufferSize.height(),
+                     int(description.stride * 4),
+                     QImage::Format_RGBA8888);
+    if (m_image.isNull()) {
+        androidHardwareBufferApi().unlock(m_buffer.buffer, nullptr);
+        return nullptr;
+    }
+
+    m_locked = true;
+    return &m_image;
+}
+
+bool TranslatorOutput::endRender()
+{
+    if (!m_locked) {
+        return true;
+    }
+
+    const size_t rowBytes = size_t(m_bufferSize.width()) * 4;
+    const size_t stride = size_t(m_image.bytesPerLine());
+    if (rowBytes > 0 && stride >= rowBytes) {
+        m_flipScratch.resize(rowBytes);
+        uchar *base = m_image.bits();
+        for (int y = 0; y < m_bufferSize.height() / 2; ++y) {
+            uchar *top = base + size_t(y) * stride;
+            uchar *bottom = base + size_t(m_bufferSize.height() - 1 - y) * stride;
+            std::memcpy(m_flipScratch.data(), top, rowBytes);
+            std::memcpy(top, bottom, rowBytes);
+            std::memcpy(bottom, m_flipScratch.data(), rowBytes);
+        }
+    }
+
+    m_image = QImage();
+    const int result = androidHardwareBufferApi().unlock(m_buffer.buffer, nullptr);
+    m_locked = false;
+    if (result != 0) {
+        qCWarning(KWIN_CORE) << "AHardwareBuffer_unlock failed:" << result;
+        return false;
+    }
+
+    return true;
+}
+
+bool TranslatorOutput::isHardwareBufferMappingAvailable()
+{
+    return androidHardwareBufferApi().valid();
+}
+
+bool TranslatorOutput::allocateBuffer(const QSize &size)
+{
+    if (size.isEmpty() || !m_connection || !m_connection->connection()) {
+        return false;
+    }
+
+    tgui_hardware_buffer buffer{};
+    const tgui_err error = tgui_hardware_buffer_create(
+        m_connection->connection(),
+        &buffer,
+        TGUI_HARDWARE_BUFFER_FORMAT_RGBA8888,
+        uint32_t(size.width()),
+        uint32_t(size.height()),
+        TGUI_HARDWARE_BUFFER_CPU_NEVER,
+        TGUI_HARDWARE_BUFFER_CPU_OFTEN);
+
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to allocate Termux:GUI AHardwareBuffer:" << error;
+        return false;
+    }
+
+    m_buffer = buffer;
+    m_bufferSize = size;
+    m_bufferValid = true;
+    return true;
+}
+
+void TranslatorOutput::destroyBuffer()
+{
+    if (!m_bufferValid || !m_connection || !m_connection->connection()) {
+        m_bufferValid = false;
+        m_buffer = {};
+        m_bufferSize = QSize();
+        return;
+    }
+
+    const tgui_err error = tgui_hardware_buffer_destroy(m_connection->connection(), &m_buffer);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to destroy Termux:GUI AHardwareBuffer:" << error;
+    }
+
+    m_bufferValid = false;
+    m_buffer = {};
+    m_bufferSize = QSize();
+}
+
+void TranslatorOutput::setSurfaceSize(const QSize &size)
+{
+    if (size.isEmpty()) {
+        destroyBuffer();
+        return;
+    }
+
+    if (m_bufferValid && m_bufferSize == size) {
+        m_resizePending = false;
+        return;
+    }
+
+    destroyBuffer();
+    if (!allocateBuffer(size)) {
+        return;
+    }
+
+    QList<std::shared_ptr<OutputMode>> modes;
+    modes.push_back(std::make_shared<OutputMode>(OutputModeline(size, 60000, OutputModeline::Flag::Preferred)));
+
+    State state = m_state;
+    state.modes = modes;
+    state.currentMode = modes.front();
+    setState(state);
+
+    m_renderLoop->setRefreshRate(60000);
+    Q_EMIT changed();
+
+    m_resizePending = false;
+    m_renderLoop->scheduleRepaint();
+}
+
+void TranslatorOutput::handleSurfaceChanged(const QSize &size)
+{
+    if (m_inFlight) {
+        m_pendingSize = size;
+        m_resizePending = true;
+        return;
+    }
+
+    setSurfaceSize(size);
+}
+
+void TranslatorOutput::handleFrameComplete(uint64_t timestampNanoseconds)
+{
+    if (!m_inFlight) {
+        return;
+    }
+
+    m_inFlight = false;
+
+    const std::shared_ptr<OutputFrame> frame = std::move(m_frame);
+    if (frame) {
+        frame->presented(std::chrono::nanoseconds(timestampNanoseconds), PresentationMode::VSync);
+    }
+
+    if (m_resizePending) {
+        const QSize pending = m_pendingSize;
+        m_pendingSize = QSize();
+        m_resizePending = false;
+        setSurfaceSize(pending);
+    }
+}
+
+void TranslatorOutput::handleActivityDestroyed()
+{
+    if (m_locked) {
+        endRender();
+    }
+    m_inFlight = false;
+    m_frame.reset();
+    m_pendingSize = QSize();
+    m_resizePending = false;
+    destroyBuffer();
+}
+
+} // namespace KWin
+
+#include "moc_translator_output.cpp"
