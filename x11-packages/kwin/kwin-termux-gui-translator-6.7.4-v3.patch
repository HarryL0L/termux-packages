diff --git a/src/backends/translator/translator_connection.cpp b/src/backends/translator/translator_connection.cpp
new file mode 100644
index 0000000..b2adc56
--- /dev/null
+++ b/src/backends/translator/translator_connection.cpp
@@ -0,0 +1,253 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_connection.h"
+#include "utils/common.h"
+
+#include <QDebug>
+#include <QTimer>
+
+namespace KWin
+{
+
+TranslatorConnection::TranslatorConnection(QObject *parent)
+    : QObject(parent)
+{
+}
+
+TranslatorConnection::~TranslatorConnection()
+{
+    if (m_timer) {
+        m_timer->stop();
+    }
+
+    if (m_connection) {
+        if (m_activity != -1) {
+            tgui_activity_finish(m_connection, m_activity);
+        }
+        tgui_connection_destroy(m_connection);
+    }
+
+    m_connection = nullptr;
+    m_activity = -1;
+    m_surfaceView = -1;
+    m_frameLayout = -1;
+}
+
+bool TranslatorConnection::initialize()
+{
+    if (m_initialized) {
+        return true;
+    }
+
+    tgui_err error = tgui_connection_create(&m_connection);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Termux:GUI connection creation failed:" << error;
+        m_connection = nullptr;
+        return false;
+    }
+
+    error = tgui_activity_create(m_connection, &m_activity, TGUI_ACTIVITY_NORMAL, nullptr, false);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Termux:GUI Activity creation failed:" << error;
+        tgui_connection_destroy(m_connection);
+        m_connection = nullptr;
+        m_activity = -1;
+        return false;
+    }
+
+    m_timer = new QTimer(this);
+    m_timer->setInterval(1);
+    connect(m_timer, &QTimer::timeout, this, &TranslatorConnection::pollEvents);
+    m_timer->start();
+
+    m_initialized = true;
+    return true;
+}
+
+tgui_connection TranslatorConnection::connection() const
+{
+    return m_connection;
+}
+
+tgui_activity TranslatorConnection::activity() const
+{
+    return m_activity;
+}
+
+tgui_view TranslatorConnection::surfaceView() const
+{
+    return m_surfaceView;
+}
+
+bool TranslatorConnection::createViews()
+{
+    if (m_surfaceView != -1) {
+        return true;
+    }
+
+    tgui_err error = tgui_create_frame_layout(m_connection, m_activity, &m_frameLayout, nullptr, TGUI_VIS_VISIBLE);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to create Termux:GUI FrameLayout:" << error;
+        return false;
+    }
+
+    error = tgui_create_surface_view(m_connection, m_activity, &m_surfaceView, &m_frameLayout, TGUI_VIS_VISIBLE, false);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to create Termux:GUI SurfaceView:" << error;
+        m_surfaceView = -1;
+        return false;
+    }
+
+    tgui_view_size matchParent;
+    matchParent.type = TGUI_VIEW_MATCH_PARENT;
+    matchParent.value.unit = TGUI_UNIT_PX;
+    matchParent.value.value = 0;
+
+    error = tgui_set_width(m_connection, m_activity, m_frameLayout, matchParent);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to size Termux:GUI FrameLayout:" << error;
+        return false;
+    }
+    error = tgui_set_height(m_connection, m_activity, m_frameLayout, matchParent);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to size Termux:GUI FrameLayout:" << error;
+        return false;
+    }
+
+    error = tgui_set_width(m_connection, m_activity, m_surfaceView, matchParent);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to size Termux:GUI SurfaceView:" << error;
+        return false;
+    }
+    error = tgui_set_height(m_connection, m_activity, m_surfaceView, matchParent);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to size Termux:GUI SurfaceView:" << error;
+        return false;
+    }
+
+    error = tgui_set_clickable(m_connection, m_activity, m_surfaceView, true);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to make Termux:GUI SurfaceView clickable:" << error;
+        return false;
+    }
+
+    error = tgui_send_touch_event(m_connection, m_activity, m_surfaceView, true);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to enable Termux:GUI touch events:" << error;
+        return false;
+    }
+
+    error = tgui_surface_view_config(m_connection, m_activity, m_surfaceView,
+                                      0xff000000u,
+                                      TGUI_MISMATCH_STICK_TOPLEFT,
+                                      TGUI_MISMATCH_STICK_TOPLEFT,
+                                      60.0f);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to configure Termux:GUI SurfaceView:" << error;
+        return false;
+    }
+
+    Q_EMIT surfaceCreated();
+    return true;
+}
+
+void TranslatorConnection::pollEvents()
+{
+    if (!m_connection) {
+        return;
+    }
+
+    for (;;) {
+        tgui_event event;
+        bool available = false;
+        const tgui_err error = tgui_poll_event(m_connection, &event, &available);
+        if (error != TGUI_ERR_OK) {
+            qCWarning(KWIN_CORE) << "Termux:GUI event polling failed:" << error;
+            return;
+        }
+        if (!available) {
+            return;
+        }
+
+        switch (event.type) {
+        case TGUI_EVENT_CREATE:
+            if (event.activity == m_activity) {
+                createViews();
+            }
+            break;
+
+        case TGUI_EVENT_TOUCH:
+            if (event.activity == m_activity && event.touch.id == m_surfaceView) {
+                TranslatorTouchEvent touch;
+                touch.action = event.touch.action;
+                touch.index = event.touch.index;
+                touch.time = event.touch.time;
+                if (event.touch.pointers) {
+                    const uint32_t pointerCount = event.touch.num_pointers;
+                    const uint32_t eventCount = event.touch.events;
+                    touch.batchedPointers.reserve(int(eventCount));
+                    for (uint32_t n = 0; n < eventCount; ++n) {
+                        QVector<TranslatorTouchPoint> pointers;
+                        pointers.reserve(int(pointerCount));
+                        for (uint32_t i = 0; i < pointerCount; ++i) {
+                            const tgui_touch_pointer &pointer = event.touch.pointers[n][i];
+                            pointers.push_back(TranslatorTouchPoint{
+                                .id = pointer.id,
+                                .position = QPointF(pointer.x, pointer.y),
+                            });
+                        }
+                        touch.batchedPointers.push_back(std::move(pointers));
+                    }
+                    if (!touch.batchedPointers.isEmpty()) {
+                        touch.pointers = touch.batchedPointers.constLast();
+                    }
+                }
+
+                Q_EMIT touchEvent(touch);
+            }
+            break;
+
+        case TGUI_EVENT_FRAME_COMPLETE:
+            if (event.activity == m_activity && event.frame.id == m_surfaceView) {
+                Q_EMIT frameComplete(event.frame.timestamp);
+            }
+            break;
+
+        case TGUI_EVENT_SURFACE_CHANGED:
+            if (event.activity == m_activity && event.surfaceChanged.id == m_surfaceView) {
+                Q_EMIT surfaceChanged(QSize(int(event.surfaceChanged.width), int(event.surfaceChanged.height)));
+            }
+            break;
+
+        case TGUI_EVENT_DESTROY:
+            if (event.activity == m_activity) {
+                Q_EMIT activityDestroyed();
+            }
+            break;
+
+        default:
+            break;
+        }
+
+        tgui_event_destroy(&event);
+    }
+}
+
+bool TranslatorConnection::setBuffer(tgui_hardware_buffer *buffer)
+{
+    if (!m_connection || m_activity == -1 || m_surfaceView == -1 || !buffer) {
+        return false;
+    }
+
+    const tgui_err error = tgui_surface_view_set_buffer(m_connection, m_activity, m_surfaceView, buffer);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_CORE) << "Failed to submit Termux:GUI hardware buffer:" << error;
+        return false;
+    }
+
+    return true;
+}
+
+} // namespace KWin
+
+#include "moc_translator_connection.cpp"
diff --git a/src/backends/translator/translator_connection.h b/src/backends/translator/translator_connection.h
new file mode 100644
index 0000000..86b6ee0
--- /dev/null
+++ b/src/backends/translator/translator_connection.h
@@ -0,0 +1,71 @@
+/*
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QObject>
+#include <QPointF>
+#include <QTimer>
+#include <QSize>
+#include <QVector>
+
+#include <cstdint>
+
+#include <termuxgui/termuxgui.h>
+
+namespace KWin
+{
+
+struct TranslatorTouchPoint
+{
+    int id = -1;
+    QPointF position;
+};
+
+struct TranslatorTouchEvent
+{
+    tgui_touch_action action = TGUI_TOUCH_CANCEL;
+    QVector<TranslatorTouchPoint> pointers;
+    QVector<QVector<TranslatorTouchPoint>> batchedPointers;
+    uint32_t index = 0;
+    uint64_t time = 0;
+};
+
+class TranslatorConnection : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit TranslatorConnection(QObject *parent = nullptr);
+    ~TranslatorConnection() override;
+
+    bool initialize();
+
+    tgui_connection connection() const;
+    tgui_activity activity() const;
+    tgui_view surfaceView() const;
+
+    bool setBuffer(tgui_hardware_buffer *buffer);
