diff --git a/src/backends/translator/translator_connection.cpp b/src/backends/translator/translator_connection.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..10326a58045157cc78004cb141b47a1ff7622c65
--- /dev/null
+++ b/src/backends/translator/translator_connection.cpp
@@ -0,0 +1,277 @@
+/*
+    KWin - the KDE window manager
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_connection.h"
+
+#include "core/renderbackend.h"
+
+#include <termuxgui/termuxgui.h>
+
+#include <QLoggingCategory>
+
+#include <android/hardware_buffer.h>
+#include <dlfcn.h>
+
+#include <chrono>
+#include <thread>
+#include <utility>
+
+Q_DECLARE_LOGGING_CATEGORY(KWIN_TRANSLATOR)
+
+namespace KWin
+{
+
+namespace
+{
+struct AndroidHardwareBufferApi
+{
+    using Lock = int (*)(AHardwareBuffer *, uint64_t, int32_t, const ARect *, void **);
+    using Unlock = int (*)(AHardwareBuffer *, int *);
+
+    void *handle = nullptr;
+    Lock lock = nullptr;
+    Unlock unlock = nullptr;
+
+    bool load()
+    {
+        if (!handle) {
+            handle = dlopen("libandroid.so", RTLD_LAZY | RTLD_LOCAL);
+            if (!handle) {
+                return false;
+            }
+            lock = reinterpret_cast<Lock>(dlsym(handle, "AHardwareBuffer_lock"));
+            unlock = reinterpret_cast<Unlock>(dlsym(handle, "AHardwareBuffer_unlock"));
+        }
+        return lock && unlock;
+    }
+};
+
+AndroidHardwareBufferApi s_android;
+}
+
+TranslatorConnection::TranslatorConnection(const QSize &size)
+    : m_requestedSize(size)
+{
+}
+
+TranslatorConnection::~TranslatorConnection()
+{
+    stopEvents();
+    destroyBuffer();
+    if (m_surface >= 0) {
+        tgui_delete_view(m_connection, m_activity, m_surface);
+    }
+    if (m_root >= 0) {
+        tgui_delete_view(m_connection, m_activity, m_root);
+    }
+    if (m_activity >= 0) {
+        tgui_activity_finish(m_connection, m_activity);
+    }
+    if (m_connection) {
+        tgui_connection_destroy(m_connection);
+    }
+}
+
+bool TranslatorConnection::initialize()
+{
+    if (!s_android.load()) {
+        qCWarning(KWIN_TRANSLATOR) << "Required Android HardwareBuffer API is unavailable";
+        return false;
+    }
+    if (tgui_connection_create(&m_connection) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to connect to Termux:GUI";
+        return false;
+    }
+    if (tgui_activity_create(m_connection, &m_activity, TGUI_ACTIVITY_NORMAL, nullptr, false) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI activity";
+        return false;
+    }
+
+    if (tgui_create_frame_layout(m_connection, m_activity, &m_root, nullptr, TGUI_VIS_VISIBLE) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI root view";
+        return false;
+    }
+    if (tgui_create_surface_view(m_connection, m_activity, &m_surface, &m_root, TGUI_VIS_VISIBLE, false) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI SurfaceView";
+        return false;
+    }
+
+    const tgui_view_size matchParent{.type = TGUI_VIEW_MATCH_PARENT};
+    if (tgui_set_width(m_connection, m_activity, m_surface, matchParent) != TGUI_ERR_OK
+        || tgui_set_height(m_connection, m_activity, m_surface, matchParent) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to size Termux:GUI SurfaceView";
+        return false;
+    }
+    if (tgui_surface_view_config(m_connection, m_activity, m_surface, 0xff000000,
+                                  TGUI_MISMATCH_STICK_TOPLEFT, TGUI_MISMATCH_STICK_TOPLEFT, 60.0f) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to configure Termux:GUI SurfaceView";
+        return false;
+    }
+    if (!createBuffer(m_requestedSize)) {
+        return false;
+    }
+    if (tgui_surface_view_set_buffer(m_connection, m_activity, m_surface, &m_buffer) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to attach Termux:GUI HardwareBuffer";
+        return false;
+    }
+    return true;
+}
+
+void TranslatorConnection::startEvents()
+{
+    if (m_running.exchange(true)) {
+        return;
+    }
+    m_eventThread = std::thread([this] { eventLoop(); });
+}
+
+QSize TranslatorConnection::size() const
+{
+    return m_size;
+}
+
+QSize TranslatorConnection::pendingSize() const
+{
+    return QSize(m_pendingWidth.load(std::memory_order_acquire), m_pendingHeight.load(std::memory_order_acquire));
+}
+
+bool TranslatorConnection::applyPendingSize()
+{
+    const QSize requested = pendingSize();
+    if (requested.isEmpty() || requested == m_size) {
+        return false;
+    }
+    m_pendingWidth.store(0, std::memory_order_release);
+    m_pendingHeight.store(0, std::memory_order_release);
+    if (!createBuffer(requested)) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to resize Termux:GUI HardwareBuffer to" << requested;
+        return false;
+    }
+    if (tgui_surface_view_set_buffer(m_connection, m_activity, m_surface, &m_buffer) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to attach resized Termux:GUI HardwareBuffer";
+        return false;
+    }
+    return true;
+}
+
+void *TranslatorConnection::lock()
+{
+    void *data = nullptr;
+    if (!m_buffer.buffer || s_android.lock(m_buffer.buffer, AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN, -1, nullptr, &data) != 0) {
+        return nullptr;
+    }
+    return data;
+}
+
+void TranslatorConnection::unlock()
+{
+    if (m_buffer.buffer) {
+        s_android.unlock(m_buffer.buffer, nullptr);
+    }
+}
+
+void TranslatorConnection::setFrame(const std::shared_ptr<OutputFrame> &frame)
+{
+    m_frame = frame;
+}
+
+void TranslatorConnection::presentFrame(uint64_t timestamp)
+{
+    if (auto frame = std::exchange(m_frame, nullptr)) {
+        frame->presented(std::chrono::nanoseconds(timestamp), PresentationMode::VSync);
+    }
+}
+
+void TranslatorConnection::setTouchCallback(TranslatorTouchCallback callback)
+{
+    m_touchCallback = std::move(callback);
+}
+
+void TranslatorConnection::setFrameCallback(TranslatorFrameCallback callback)
+{
+    m_frameCallback = std::move(callback);
+}
+
+void TranslatorConnection::setResizeCallback(TranslatorResizeCallback callback)
+{
+    m_resizeCallback = std::move(callback);
+}
+
+bool TranslatorConnection::createBuffer(const QSize &size)
+{
+    destroyBuffer();
+    tgui_hardware_buffer buffer{};
+    if (tgui_hardware_buffer_create(m_connection, &buffer, TGUI_HARDWARE_BUFFER_FORMAT_RGBA8888,
+                                    size.width(), size.height(),
+                                    TGUI_HARDWARE_BUFFER_CPU_NEVER,
+                                    TGUI_HARDWARE_BUFFER_CPU_OFTEN) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI HardwareBuffer" << size;
+        return false;
+    }
+    m_buffer = buffer;
+    m_size = size;
+    return true;
+}
+
+void TranslatorConnection::destroyBuffer()
+{
+    if (m_buffer.buffer) {
+        tgui_hardware_buffer_destroy(m_connection, &m_buffer);
+        m_buffer = {};
+    }
+}
+
+void TranslatorConnection::stopEvents()
+{
+    m_running.store(false, std::memory_order_release);
+    if (m_eventThread.joinable()) {
+        m_eventThread.join();
+    }
+}
+
+void TranslatorConnection::eventLoop()
+{
+    while (m_running.load(std::memory_order_acquire)) {
+        tgui_event event{};
+        bool available = false;
+        const tgui_err error = tgui_poll_event(m_connection, &event, &available);
+        if (error != TGUI_ERR_OK) {
+            if (m_running.load(std::memory_order_acquire)) {
+                qCWarning(KWIN_TRANSLATOR) << "Termux:GUI event polling failed:" << error;
+            }
+            break;
+        }
+        if (!available) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            continue;
+        }
+
+        if (event.type == TGUI_EVENT_TOUCH && m_touchCallback) {
+            std::vector<std::vector<TranslatorTouchPoint>> batches;
+            batches.reserve(event.touch.events);
+            for (uint32_t e = 0; e < event.touch.events; ++e) {
+                std::vector<TranslatorTouchPoint> points;
+                points.reserve(event.touch.num_pointers);
+                for (uint32_t i = 0; i < event.touch.num_pointers; ++i) {
+                    const auto &p = event.touch.pointers[e][i];
+                    points.push_back({p.id, p.x, p.y});
+                }
+                batches.push_back(std::move(points));
+            }
+            m_touchCallback(event.touch.action, event.touch.index, std::move(batches), event.touch.time);
+        } else if (event.type == TGUI_EVENT_FRAME_COMPLETE && m_frameCallback) {
+            m_frameCallback(event.frame.timestamp);
+        } else if (event.type == TGUI_EVENT_SURFACE_CHANGED) {
+            const QSize size(int(event.surfaceChanged.width), int(event.surfaceChanged.height));
+            m_pendingWidth.store(size.width(), std::memory_order_release);
+            m_pendingHeight.store(size.height(), std::memory_order_release);
+            if (m_resizeCallback) {
+                m_resizeCallback(size);
+            }
+        }
+        tgui_event_destroy(&event);
+    }
+}
+
+} // namespace KWin
