+/*
+    KWin - the KDE window manager
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_backend.h"
+#include "translator_connection.h"
+#include "translator_output.h"
+#include "translator_qpainter_backend.h"
+
+#include "core/inputbackend.h"
+#include "core/inputdevice.h"
+
+#include <QMetaObject>
+
+namespace KWin
+{
+
+class TranslatorInputDevice : public InputDevice
+{
+public:
+    explicit TranslatorInputDevice(QObject *parent = nullptr)
+        : InputDevice(parent)
+    {
+    }
+
+    QString name() const override { return QStringLiteral("Termux:GUI Touchscreen"); }
+    bool isEnabled() const override { return true; }
+    void setEnabled(bool) override { }
+    bool isKeyboard() const override { return false; }
+    bool isPointer() const override { return false; }
+    bool isTouchpad() const override { return false; }
+    bool isTouch() const override { return true; }
+    bool isTabletTool() const override { return false; }
+    bool isTabletPad() const override { return false; }
+    bool isTabletModeSwitch() const override { return false; }
+    bool isLidSwitch() const override { return false; }
+};
+
+class TranslatorInputBackend : public InputBackend
+{
+public:
+    explicit TranslatorInputBackend(TranslatorConnection *connection, QObject *parent = nullptr)
+        : InputBackend(parent)
+        , m_connection(connection)
+        , m_device(std::make_unique<TranslatorInputDevice>(this))
+    {
+    }
+
+    void initialize() override
+    {
+        m_connection->setTouchCallback([this](tgui_touch_action action, uint32_t index, std::vector<std::vector<TranslatorTouchPoint>> batches, uint64_t time) {
+            QMetaObject::invokeMethod(this, [this, action, index, batches = std::move(batches), time] {
+                processTouch(action, index, batches, time);
+            }, Qt::QueuedConnection);
+        });
+        Q_EMIT deviceAdded(m_device.get());
+        m_connection->startEvents();
+    }
+
+private:
+    void processTouch(tgui_touch_action action, uint32_t index, const std::vector<std::vector<TranslatorTouchPoint>> &batches, uint64_t time)
+    {
+        if (batches.empty()) {
+            return;
+        }
+        const auto timestamp = std::chrono::milliseconds(time);
+        if (action == TGUI_TOUCH_CANCEL) {
+            Q_EMIT m_device->touchCanceled(m_device.get());
+            return;
+        }
+
+        const auto &current = batches.back();
+        if (action == TGUI_TOUCH_DOWN || action == TGUI_TOUCH_POINTER_DOWN) {
+            if (index < current.size()) {
+                const auto &point = current[index];
+                Q_EMIT m_device->touchDown(point.id, QPointF(point.x, point.y), timestamp, m_device.get());
+            }
+        } else if (action == TGUI_TOUCH_UP || action == TGUI_TOUCH_POINTER_UP) {
+            if (index < current.size()) {
+                const auto &point = current[index];
+                Q_EMIT m_device->touchUp(point.id, timestamp, m_device.get());
+            }
+        } else if (action == TGUI_TOUCH_MOVE) {
+            for (const auto &batch : batches) {
+                for (const auto &point : batch) {
+                    Q_EMIT m_device->touchMotion(point.id, QPointF(point.x, point.y), timestamp, m_device.get());
+                }
+            }
+        }
+        Q_EMIT m_device->touchFrame(m_device.get());
+    }
+
+    TranslatorConnection *const m_connection;
+    std::unique_ptr<TranslatorInputDevice> m_device;
+};
+
+
+TranslatorBackend::TranslatorBackend(const QSize &size, qreal scale, QObject *parent)
+    : OutputBackend(parent)
+    , m_connection(std::make_unique<TranslatorConnection>(size))
+{
+}
+
+TranslatorBackend::~TranslatorBackend() = default;
+
+bool TranslatorBackend::initialize()
+{
+    if (!m_connection->initialize()) {
+        return false;
+    }
+
+    auto output = std::make_unique<TranslatorOutput>(this, m_connection->size(), 1, m_connection.get());
+    m_output = std::move(output);
+
+    m_connection->setFrameCallback([this](uint64_t timestamp) {
+        QMetaObject::invokeMethod(this, [this, timestamp] {
+            if (m_output) {
+                m_connection->presentFrame(timestamp);
+            }
+        }, Qt::QueuedConnection);
+    });
+    m_connection->setResizeCallback([this](const QSize &size) {
+        QMetaObject::invokeMethod(this, [this, size] {
+            if (m_output) {
+                m_output->resize(size);
+            }
+        }, Qt::QueuedConnection);
+    });
+
+    Q_EMIT outputAdded(m_output.get());
+    Q_EMIT outputsQueried();
+    return true;
+}
+
+std::unique_ptr<InputBackend> TranslatorBackend::createInputBackend()
+{
+    return std::make_unique<TranslatorInputBackend>(m_connection.get());
+}
+
+std::unique_ptr<QPainterBackend> TranslatorBackend::createQPainterBackend()
+{
+    return std::make_unique<TranslatorQPainterBackend>(this);
+}
+
+EglDisplay *TranslatorBackend::sceneEglDisplayObject() const
+{
+    return nullptr;
+}
+
+QList<CompositingType> TranslatorBackend::supportedCompositors() const
+{
+    return {QPainterCompositing};
+}
+
+QList<BackendOutput *> TranslatorBackend::outputs() const
+{
+    return m_output ? QList<BackendOutput *>{m_output.get()} : QList<BackendOutput *>{};
+}
+
+QString TranslatorBackend::supportInformation() const
+{
+    return QStringLiteral("Termux:GUI HardwareBuffer + QPainter");
+}
+
+TranslatorConnection *TranslatorBackend::connection() const
+{
+    return m_connection.get();
+}
+
+} // namespace KWin
+
+#include "moc_translator_backend.cpp"
