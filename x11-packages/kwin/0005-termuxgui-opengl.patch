+/*
+    KWin - the KDE window manager
+    This file is part of the KDE project.
+
+    Termux:GUI OpenGL render backend.
+
+    Composites with OpenGL through a surfaceless EGL display (Mesa
+    Zink / Panfrost / Turnip ... on top of the Android GPU stack) and
+    presents through Termux:GUI hardware buffers. No DRM/KMS device is
+    required. The rendered frame is handed over to the Android side
+    either by a GPU-side blit into a dma-buf import of the hardware
+    buffer, or, if the import isn't possible on this driver, by a
+    glReadPixels() readback into a CPU mapping of the hardware buffer.
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include "core/outputlayer.h"
+#include "opengl/eglbackend.h"
+#include "utils/damagejournal.h"
+
+#include <array>
+#include <memory>
+
+#include <termuxgui/termuxgui.h>
+
+namespace KWin
+{
+
+class GLFramebuffer;
+class GLRenderTimeQuery;
+class GLTexture;
+class RenderDevice;
+class TermuxGuiEglBackend;
+class TermuxGuiIntegration;
+class VirtualBackend;
+class VirtualOutput;
+
+/**
+ * Creates a RenderDevice that is backed by a surfaceless EGL display and no
+ * DRM device at all. Returns nullptr if the EGL implementation can't do that.
+ */
+std::unique_ptr<RenderDevice> createTermuxGuiRenderDevice();
+
+class TermuxGuiEglLayer : public OutputLayer
+{
+public:
+    TermuxGuiEglLayer(BackendOutput *output, TermuxGuiEglBackend *backend);
+    ~TermuxGuiEglLayer() override;
+
+    std::optional<OutputLayerBeginFrameInfo> doBeginFrame() override;
+    bool doEndFrame(const Region &renderedDeviceRegion, const Region &damagedDeviceRegion, OutputFrame *frame) override;
+
+    DrmDevice *scanoutDevice() const override;
+    FormatModifierMap supportedDrmFormats() const override;
+    void releaseBuffers() override;
+
+    GLTexture *texture() const;
+
+private:
+    struct Buffer
+    {
+        tgui_hardware_buffer hb{};
+        bool valid = false;
+        // GPU path: dma-buf import of the hardware buffer
+        std::shared_ptr<GLTexture> texture;
+        std::unique_ptr<GLFramebuffer> framebuffer;
+        bool importAttempted = false;
+    };
+
+    bool ensureRenderTarget(const QSize &size);
+    bool ensureBuffers(const QSize &size);
+    void destroyBuffers();
+    bool importBuffer(Buffer &buffer);
+    bool presentBlit(Buffer &buffer);
+    bool presentReadback(Buffer &buffer);
+
+    TermuxGuiEglBackend *const m_backend;
+    TermuxGuiIntegration *const m_integration;
+
+    // intermediate render target KWin composites into
+    std::unique_ptr<GLTexture> m_renderTexture;
+    std::unique_ptr<GLFramebuffer> m_renderFbo;
+    std::unique_ptr<GLRenderTimeQuery> m_query;
+    DamageJournal m_damageJournal;
+
+    std::array<Buffer, 3> m_buffers;
+    size_t m_currentBuffer = 0;
+    QByteArray m_readbackScratch;
+};
+
+class TermuxGuiEglBackend : public EglBackend
+{
+    Q_OBJECT
+
+public:
+    TermuxGuiEglBackend(VirtualBackend *backend, TermuxGuiIntegration *integration);
+    ~TermuxGuiEglBackend() override;
+
+    bool init() override;
+    QList<OutputLayer *> compatibleOutputLayers(BackendOutput *output) override;
+
+    VirtualBackend *backend() const;
+    TermuxGuiIntegration *integration() const;
+    DrmDevice *drmDevice() const override;
+
+private:
+    void addOutput(BackendOutput *output);
+    void updateOutputSize(const QSize &size);
+
+    VirtualBackend *const m_backend;
+    TermuxGuiIntegration *const m_integration;
+};
+
