+// ---------------------------------------------------------------------------
+
+TermuxGuiEglLayer::TermuxGuiEglLayer(BackendOutput *output, TermuxGuiEglBackend *backend)
+    : OutputLayer(output, OutputLayerType::Primary)
+    , m_backend(backend)
+    , m_integration(backend->integration())
+{
+}
+
+TermuxGuiEglLayer::~TermuxGuiEglLayer()
+{
+    (void)m_backend->openglContext()->makeCurrent();
+    destroyBuffers();
+}
+
+bool TermuxGuiEglLayer::ensureRenderTarget(const QSize &size)
+{
+    if (m_renderTexture && m_renderTexture->size() == size && m_renderFbo && m_renderFbo->valid()) {
+        return true;
+    }
+    m_renderFbo.reset();
+    m_renderTexture = GLTexture::allocate(GL_RGBA8, size);
+    if (!m_renderTexture) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] could not allocate %dx%d render texture", size.width(), size.height());
+        return false;
+    }
+    m_renderTexture->setFilter(GL_NEAREST);
+    m_renderTexture->setWrapMode(GL_CLAMP_TO_EDGE);
+    m_renderFbo = std::make_unique<GLFramebuffer>(m_renderTexture.get());
+    if (!m_renderFbo->valid()) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] render framebuffer is incomplete");
+        m_renderFbo.reset();
+        m_renderTexture.reset();
+        return false;
+    }
+    m_damageJournal.clear();
+    return true;
+}
+
+bool TermuxGuiEglLayer::ensureBuffers(const QSize &size)
+{
+    auto &api = androidBufferApi();
+    if (!api.ensureLoaded()) {
+        return false;
+    }
+
+    bool recreate = false;
+    for (const auto &buffer : m_buffers) {
+        if (!buffer.valid) {
+            recreate = true;
+            break;
+        }
+    }
+    if (!recreate) {
+        AHardwareBuffer_Desc desc{};
+        api.describeFn()(m_buffers[0].hb.buffer, &desc);
+        recreate = QSize(int(desc.width), int(desc.height)) != size;
+    }
+    if (!recreate) {
+        return true;
+    }
+
+    destroyBuffers();
+    for (auto &buffer : m_buffers) {
+        if (m_integration->createHardwareBuffer(&buffer.hb, uint32_t(size.width()), uint32_t(size.height())) != TGUI_ERR_OK) {
+            qCWarning(KWIN_VIRTUAL, "[termuxgui] creating a %dx%d hardware buffer failed", size.width(), size.height());
+            destroyBuffers();
+            return false;
+        }
+        buffer.valid = true;
+    }
+    m_currentBuffer = 0;
+    return true;
+}
+
+void TermuxGuiEglLayer::destroyBuffers()
+{
+    for (auto &buffer : m_buffers) {
+        buffer.framebuffer.reset();
+        buffer.texture.reset();
+        buffer.importAttempted = false;
+        if (buffer.valid) {
+            m_integration->destroyHardwareBuffer(&buffer.hb);
+            buffer.valid = false;
+        }
+    }
+}
+
+bool TermuxGuiEglLayer::importBuffer(Buffer &buffer)
+{
+    if (buffer.importAttempted) {
+        return buffer.framebuffer && buffer.framebuffer->valid();
+    }
+    buffer.importAttempted = true;
+
+    if (qEnvironmentVariable("KWIN_TERMUX_GUI_DMABUF") == QStringLiteral("0")) {
+        return false;
+    }
+
+    auto &api = androidBufferApi();
+    if (!api.nativeHandleFn()) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] AHardwareBuffer_getNativeHandle unavailable, presenting through readback");
+        return false;
+    }
+    const native_handle *handle = api.nativeHandleFn()(buffer.hb.buffer);
+    if (!handle || handle->numFds < 1) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] hardware buffer has no dma-buf fd, presenting through readback");
+        return false;
+    }
+
+    AHardwareBuffer_Desc desc{};
+    api.describeFn()(buffer.hb.buffer, &desc);
+
+    DmaBufAttributes attrs;
+    attrs.planeCount = 1;
+    attrs.width = int(desc.width);
+    attrs.height = int(desc.height);
+    attrs.format = DRM_FORMAT_ABGR8888; // AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM
+    attrs.modifier = DRM_FORMAT_MOD_LINEAR;
+    attrs.device = 0;
+    // The first fd of gralloc handles is the buffer itself (further fds, if
+    // any, carry vendor metadata).
+    attrs.fd[0] = FileDescriptor(dup(handle->data[0]));
+    attrs.offset[0] = 0;
+    attrs.pitch[0] = desc.stride * 4;
+
+    bool ok;
+    const uint64_t modifier = qEnvironmentVariable("KWIN_TERMUX_GUI_MODIFIER").toULongLong(&ok, 0);
+    if (ok) {
+        attrs.modifier = modifier;
+    }
+
+    if (!attrs.fd[0].isValid()) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] dup() of the dma-buf fd failed, presenting through readback");
+        return false;
+    }
+
+    buffer.texture = m_backend->importDmaBufAsTexture(attrs);
+    if (!buffer.texture) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] dma-buf import of the hardware buffer failed (format ABGR8888, pitch %u, modifier 0x%llx), presenting through readback",
+                  attrs.pitch[0], static_cast<unsigned long long>(attrs.modifier));
+        return false;
+    }
+    buffer.framebuffer = std::make_unique<GLFramebuffer>(buffer.texture.get());
+    if (!buffer.framebuffer->valid()) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] imported hardware buffer is not renderable, presenting through readback");
+        buffer.framebuffer.reset();
+        buffer.texture.reset();
+        return false;
+    }
+    qCInfo(KWIN_VIRTUAL, "[termuxgui] hardware buffer imported as dma-buf, presenting through GPU blit");
+    return true;
+}
+
+std::optional<OutputLayerBeginFrameInfo> TermuxGuiEglLayer::doBeginFrame()
+{
+    if (!m_backend->openglContext()->makeCurrent()) {
+        return std::nullopt;
+    }
+    const QSize nativeSize = m_output->modeSize();
+    if (nativeSize.isEmpty()) {
+        return std::nullopt;
+    }
+    if (!ensureRenderTarget(nativeSize)) {
+        return std::nullopt;
+    }
+    if (!ensureBuffers(nativeSize)) {
+        return std::nullopt;
+    }
+
+    m_query = std::make_unique<GLRenderTimeQuery>(m_backend->openglContextRef());
+    m_query->begin();
+
+    return OutputLayerBeginFrameInfo{
+        .renderTarget = RenderTarget(m_renderFbo.get()),
+        // the render texture persists between frames, so only new damage needs repainting
+        .repaint = m_damageJournal.accumulate(1, Region::infinite()),
+    };
+}
+
+bool TermuxGuiEglLayer::presentBlit(Buffer &buffer)
+{
+    GLFramebuffer::pushFramebuffer(m_renderFbo.get());
+    buffer.framebuffer->blitFromFramebuffer(Rect(), Rect(), GL_NEAREST, false, s_flipY);
+    GLFramebuffer::popFramebuffer();
+    // Termux:GUI has no fence parameter: make sure the GPU is done before the
+    // Android side scans the buffer out.
+    glFinish();
+    return true;
+}
+
+bool TermuxGuiEglLayer::presentReadback(Buffer &buffer)
+{
+    auto &api = androidBufferApi();
+    AHardwareBuffer_Desc desc{};
+    api.describeFn()(buffer.hb.buffer, &desc);
+
+    const int width = m_renderTexture->size().width();
+    const int height = m_renderTexture->size().height();
+    if (int(desc.width) != width || int(desc.height) != height) {
+        return false;
+    }
+
+    const size_t rowBytes = size_t(width) * 4;
+    if (m_readbackScratch.size() != qsizetype(rowBytes * height)) {
+        m_readbackScratch.resize(qsizetype(rowBytes * height));
+    }
+
+    GLFramebuffer::pushFramebuffer(m_renderFbo.get());
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, m_readbackScratch.data());
+    GLFramebuffer::popFramebuffer();
+
+    void *mapped = nullptr;
+    if (api.lockFn()(buffer.hb.buffer, AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN, -1, nullptr, &mapped) != 0 || !mapped) {
+        return false;
+    }
+    const size_t dstStride = size_t(desc.stride) * 4;
+    auto *dst = static_cast<unsigned char *>(mapped);
+    const auto *src = reinterpret_cast<const unsigned char *>(m_readbackScratch.constData());
+    for (int y = 0; y < height; ++y) {
+        const int dstRow = s_flipY ? (height - 1 - y) : y;
+        memcpy(dst + size_t(dstRow) * dstStride, src + size_t(y) * rowBytes, rowBytes);
+    }
+    api.unlockFn()(buffer.hb.buffer, nullptr);
+    return true;
+}
+
+bool TermuxGuiEglLayer::doEndFrame(const Region &renderedDeviceRegion, const Region &damagedDeviceRegion, OutputFrame *frame)
+{
+    if (m_query) {
+        m_query->end();
+        if (frame) {
+            frame->addRenderTimeQuery(std::move(m_query));
+        }
+    }
+    m_damageJournal.add(damagedDeviceRegion);
+
+    Buffer &buffer = m_buffers[m_currentBuffer];
+    const bool presented = importBuffer(buffer) ? presentBlit(buffer) : presentReadback(buffer);
+    if (presented) {
+        if (m_integration->view() != -1) {
+            const tgui_err err = m_integration->setBuffer(&buffer.hb);
+            if (err != TGUI_ERR_OK) {
+                qCWarning(KWIN_VIRTUAL, "[termuxgui] setBuffer failed err=%d", int(err));
+            }
+        }
+        m_currentBuffer = (m_currentBuffer + 1) % m_buffers.size();
+    }
+    return true;
+}
+
+DrmDevice *TermuxGuiEglLayer::scanoutDevice() const
+{
+    return nullptr;
+}
+
+FormatModifierMap TermuxGuiEglLayer::supportedDrmFormats() const
+{
+    return m_backend->supportedFormats();
+}
+
+void TermuxGuiEglLayer::releaseBuffers()
+{
+    (void)m_backend->openglContext()->makeCurrent();
+    m_query.reset();
+    m_renderFbo.reset();
+    m_renderTexture.reset();
+    destroyBuffers();
+}
+
+GLTexture *TermuxGuiEglLayer::texture() const
+{
+    return m_renderTexture.get();
+}
