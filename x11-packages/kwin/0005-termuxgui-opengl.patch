+
+bool TermuxGuiEglBackend::init()
+{
+    RenderDevice *device = m_backend->renderDevice();
+    if (!device || !device->eglDisplay()) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] no EGL display, OpenGL compositing unavailable");
+        return false;
+    }
+    // Deliberately not calling EglBackend::initClientExtensions(): it insists
+    // on EGL_KHR_platform_gbm, which is irrelevant for a surfaceless display.
+    setRenderDevice(device);
+    if (!createContext()) {
+        qCWarning(KWIN_VIRTUAL, "[termuxgui] could not create the OpenGL context");
+        return false;
+    }
+    // EglBackend::initWayland() requires a DRM scanout device to advertise
+    // linux-dmabuf. There is none here, so clients keep using wl_shm buffers,
+    // which are uploaded to textures like on any other backend.
+
+    const auto outputs = m_backend->outputs();
+    for (BackendOutput *output : outputs) {
+        addOutput(output);
+    }
+    connect(m_backend, &VirtualBackend::outputAdded, this, &TermuxGuiEglBackend::addOutput);
+    connect(m_integration, &TermuxGuiIntegration::surfaceSizeChanged, this, &TermuxGuiEglBackend::updateOutputSize, Qt::QueuedConnection);
+
+    const QSize size = m_integration->surfaceSize();
+    if (!size.isEmpty()) {
+        updateOutputSize(size);
+    }
+    return true;
+}
+
+void TermuxGuiEglBackend::addOutput(BackendOutput *output)
+{
+    static_cast<VirtualOutput *>(output)->setOutputLayer(std::make_unique<TermuxGuiEglLayer>(output, this));
+}
+
+void TermuxGuiEglBackend::updateOutputSize(const QSize &size)
+{
+    termuxGuiApplyOutputSize(m_backend, size);
+}
+
+QList<OutputLayer *> TermuxGuiEglBackend::compatibleOutputLayers(BackendOutput *output)
+{
+    return {static_cast<VirtualOutput *>(output)->outputLayer()};
+}
+
+} // namespace KWin
