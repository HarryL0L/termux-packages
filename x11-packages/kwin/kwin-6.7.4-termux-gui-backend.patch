@@ -0,0 +1,105 @@
+/*
+    KWin - the KDE window manager
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_qpainter_backend.h"
+
+#include "core/renderbackend.h"
+#include "translator_backend.h"
+#include "translator_connection.h"
+#include "translator_output.h"
+
+#include <drm_fourcc.h>
+
+#include <QImage>
+
+namespace KWin
+{
+
+TranslatorQPainterLayer::TranslatorQPainterLayer(TranslatorOutput *output, TranslatorConnection *connection)
+    : OutputLayer(output, OutputLayerType::Primary)
+    , m_connection(connection)
+{
+}
+
+TranslatorQPainterLayer::~TranslatorQPainterLayer() = default;
+
+std::optional<OutputLayerBeginFrameInfo> TranslatorQPainterLayer::doBeginFrame()
+{
+    m_connection->applyPendingSize();
+    const QSize size = m_connection->size();
+    if (size.isEmpty() || !m_connection->beginFrame()) {
+        return std::nullopt;
+    }
+
+    m_image = QImage(size, QImage::Format_RGBX8888);
+    if (m_image.isNull()) {
+        m_connection->cancelFrame();
+        return std::nullopt;
+    }
+
+    m_renderTime = std::make_unique<CpuRenderTimeQuery>();
+    return OutputLayerBeginFrameInfo{
+        .renderTarget = RenderTarget(&m_image),
+        .repaint = Region::infinite(),
+    };
+}
+
+bool TranslatorQPainterLayer::doEndFrame(const Region &, const Region &, OutputFrame *frame)
+{
+    m_renderTime->end();
+    frame->addRenderTimeQuery(std::move(m_renderTime));
+    return true;
+}
+
+bool TranslatorQPainterLayer::present(const std::shared_ptr<OutputFrame> &frame)
+{
+    const bool submitted = m_connection->submitFrame(m_image, frame);
+    m_image = QImage();
+    return submitted;
+}
+
+DrmDevice *TranslatorQPainterLayer::scanoutDevice() const
+{
+    return nullptr;
+}
+
+FormatModifierMap TranslatorQPainterLayer::supportedDrmFormats() const
+{
+    return {};
+}
+
+void TranslatorQPainterLayer::releaseBuffers()
+{
+    if (!m_image.isNull()) {
+        m_image = QImage();
+        m_connection->cancelFrame();
+    }
+}
+
+TranslatorQPainterBackend::TranslatorQPainterBackend(TranslatorBackend *backend)
+    : m_backend(backend)
+{
+    const auto outputs = m_backend->outputs();
+    if (!outputs.isEmpty()) {
+        auto *output = static_cast<TranslatorOutput *>(outputs.front());
+        output->setOutputLayer(std::make_unique<TranslatorQPainterLayer>(output, m_backend->connection()));
+    }
+}
+
+TranslatorQPainterBackend::~TranslatorQPainterBackend()
+{
+    const auto outputs = m_backend->outputs();
+    if (!outputs.isEmpty()) {
+        static_cast<TranslatorOutput *>(outputs.front())->setOutputLayer(nullptr);
+    }
+}
+
+QList<OutputLayer *> TranslatorQPainterBackend::compatibleOutputLayers(BackendOutput *output)
+{
+    return {static_cast<TranslatorOutput *>(output)->outputLayer()};
+}
+
+} // namespace KWin
+
+#include "moc_translator_qpainter_backend.cpp"
