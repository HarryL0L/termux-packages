diff --git a/src/backends/translator/translator_connection.cpp b/src/backends/translator/translator_connection.cpp
new file mode 100644
--- /dev/null
+++ b/src/backends/translator/translator_connection.cpp
@@ -0,0 +1,383 @@
+/*
+    KWin - the KDE window manager
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_connection.h"
+
+#include <termuxgui/termuxgui.h>
+
+#include <QLoggingCategory>
+
+#include <android/hardware_buffer.h>
+#include <dlfcn.h>
+
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <utility>
+
+Q_LOGGING_CATEGORY(KWIN_TRANSLATOR, "kwin.backends.translator")
+
+namespace KWin
+{
+
+namespace
+{
+struct AndroidHardwareBufferApi
+{
+    using Lock = int (*)(AHardwareBuffer *, uint64_t, uint64_t, const ARect *, void **);
+    using Unlock = int (*)(AHardwareBuffer *, int *);
+
+    void *handle = nullptr;
+    Lock lock = nullptr;
+    Unlock unlock = nullptr;
+
+    bool load()
+    {
+        if (!handle) {
+            handle = dlopen("libandroid.so", RTLD_LAZY | RTLD_LOCAL);
+            if (!handle) {
+                return false;
+            }
+            lock = reinterpret_cast<Lock>(dlsym(handle, "AHardwareBuffer_lock"));
+            unlock = reinterpret_cast<Unlock>(dlsym(handle, "AHardwareBuffer_unlock"));
+        }
+        return describe && lock && unlock;
+    }
+};
+
+AndroidHardwareBufferApi s_android;
+constexpr int BUFFER_COUNT = 8;
+}
+
+TranslatorConnection::TranslatorConnection(const QSize &size)
+    : m_requestedSize(size)
+{
+}
+
+TranslatorConnection::~TranslatorConnection()
+{
+    stopEvents();
+
+    std::lock_guard lock(m_mutex);
+    for (auto &slot : m_buffers) {
+        if (slot.valid && m_connection) {
+            tgui_hardware_buffer_destroy(m_connection, &slot.buffer);
+        }
+    }
+    m_buffers.clear();
+
+    if (m_surface >= 0 && m_connection) {
+        tgui_delete_view(m_connection, m_activity, m_surface);
+    }
+    if (m_root >= 0 && m_connection) {
+        tgui_delete_view(m_connection, m_activity, m_root);
+    }
+    if (m_activity >= 0 && m_connection) {
+        tgui_activity_finish(m_connection, m_activity);
+    }
+    if (m_connection) {
+        tgui_connection_destroy(m_connection);
+    }
+}
+
+bool TranslatorConnection::initialize()
+{
+    if (!s_android.load()) {
+        qCWarning(KWIN_TRANSLATOR) << "Required Android HardwareBuffer API is unavailable";
+        return false;
+    }
+
+    if (tgui_connection_create(&m_connection) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to connect to Termux:GUI";
+        return false;
+    }
+    if (tgui_activity_create(m_connection, &m_activity, TGUI_ACTIVITY_NORMAL, nullptr, false) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI activity";
+        return false;
+    }
+    if (tgui_create_frame_layout(m_connection, m_activity, &m_root, nullptr, TGUI_VIS_VISIBLE) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI root view";
+        return false;
+    }
+    if (tgui_create_surface_view(m_connection, m_activity, &m_surface, &m_root, TGUI_VIS_VISIBLE, false) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI SurfaceView";
+        return false;
+    }
+
+    const tgui_view_size matchParent{.type = TGUI_VIEW_MATCH_PARENT};
+    if (tgui_set_width(m_connection, m_activity, m_surface, matchParent) != TGUI_ERR_OK
+        || tgui_set_height(m_connection, m_activity, m_surface, matchParent) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to size Termux:GUI SurfaceView";
+        return false;
+    }
+
+    if (tgui_set_clickable(m_connection, m_activity, m_surface, true) != TGUI_ERR_OK
+        || tgui_send_touch_event(m_connection, m_activity, m_surface, true) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to enable Termux:GUI touch input";
+        return false;
+    }
+
+    if (tgui_surface_view_config(m_connection, m_activity, m_surface, 0xff000000,
+                                  TGUI_MISMATCH_STICK_TOPLEFT, TGUI_MISMATCH_STICK_TOPLEFT, 60.0f) != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to configure Termux:GUI SurfaceView";
+        return false;
+    }
+
+    return createBuffers(m_requestedSize);
+}
+
+void TranslatorConnection::startEvents()
+{
+    if (m_running.exchange(true)) {
+        return;
+    }
+    m_eventThread = std::thread([this] {
+        eventLoop();
+    });
+}
+
+QSize TranslatorConnection::size() const
+{
+    std::lock_guard lock(m_mutex);
+    return m_size;
+}
+
+QSize TranslatorConnection::pendingSize() const
+{
+    return QSize(m_pendingWidth.load(std::memory_order_acquire), m_pendingHeight.load(std::memory_order_acquire));
+}
+
+bool TranslatorConnection::applyPendingSize()
+{
+    const QSize requested = pendingSize();
+    if (requested.isEmpty() || requested == size()) {
+        return false;
+    }
+    m_pendingWidth.store(0, std::memory_order_release);
+    m_pendingHeight.store(0, std::memory_order_release);
+    return createBuffers(requested);
+}
+
+bool TranslatorConnection::beginFrame()
+{
+    std::unique_lock lock(m_mutex);
+    m_bufferCondition.wait(lock, [this] {
+        if (!m_running.load(std::memory_order_acquire) || m_buffers.empty()) {
+            return true;
+        }
+        for (const auto &slot : m_buffers) {
+            if (slot.valid && !slot.inFlight) {
+                return true;
+            }
+        }
+        return false;
+    });
+
+    if (m_buffers.empty()) {
+        return false;
+    }
+
+    for (int i = 0; i < int(m_buffers.size()); ++i) {
+        if (m_buffers[i].valid && !m_buffers[i].inFlight) {
+            m_lockedBuffer = i;
+            return true;
+        }
+    }
+    return false;
+}
+
+bool TranslatorConnection::submitFrame(const QImage &image, const std::shared_ptr<OutputFrame> &frame)
+{
+    std::lock_guard lock(m_mutex);
+    if (m_lockedBuffer < 0 || m_lockedBuffer >= int(m_buffers.size())) {
+        return false;
+    }
+
+    auto &slot = m_buffers[m_lockedBuffer];
+    AHardwareBuffer_Desc desc{};
+    AHardwareBuffer_describe(slot.buffer.buffer, &desc);
+
+    void *data = nullptr;
+    if (s_android.lock(slot.buffer.buffer, AHARDWAREBUFFER_USAGE_CPU_WRITE_OFTEN, -1, nullptr, &data) != 0 || !data) {
+        qCWarning(KWIN_TRANSLATOR) << "AHardwareBuffer_lock failed";
+        m_lockedBuffer = -1;
+        return false;
+    }
+
+    const int width = image.width();
+    const int height = image.height();
+    const int bytes = width * 4;
+    auto *dst = static_cast<unsigned char *>(data);
+    const auto *src = image.constBits();
+    for (int y = 0; y < height; ++y) {
+        std::memcpy(dst + size_t(height - 1 - y) * desc.stride * 4,
+                    src + size_t(y) * image.bytesPerLine(),
+                    size_t(bytes));
+    }
+    s_android.unlock(slot.buffer.buffer, nullptr);
+
+    const tgui_err error = tgui_surface_view_set_buffer(m_connection, m_activity, m_surface, &slot.buffer);
+    if (error != TGUI_ERR_OK) {
+        qCWarning(KWIN_TRANSLATOR) << "Failed to submit Termux:GUI frame:" << error;
+        m_lockedBuffer = -1;
+        return false;
+    }
+
+    slot.inFlight = true;
+    m_submittedFrames.emplace_back(m_lockedBuffer, frame);
+    m_lockedBuffer = -1;
+    return true;
+}
+
+void TranslatorConnection::cancelFrame()
+{
+    std::lock_guard lock(m_mutex);
+    m_lockedBuffer = -1;
+    m_bufferCondition.notify_all();
+}
+
+void TranslatorConnection::setTouchCallback(TranslatorTouchCallback callback)
+{
+    std::lock_guard lock(m_mutex);
+    m_touchCallback = std::move(callback);
+}
+
+void TranslatorConnection::setFrameCallback(TranslatorFrameCallback callback)
+{
+    std::lock_guard lock(m_mutex);
+    m_frameCallback = std::move(callback);
+}
+
+void TranslatorConnection::setResizeCallback(TranslatorResizeCallback callback)
+{
+    std::lock_guard lock(m_mutex);
+    m_resizeCallback = std::move(callback);
+}
+
+bool TranslatorConnection::createBuffers(const QSize &size)
+{
+    if (size.isEmpty()) {
+        return false;
+    }
+
+    std::unique_lock lock(m_mutex);
+    m_bufferCondition.wait(lock, [this] {
+        return m_submittedFrames.empty() && m_lockedBuffer < 0;
+    });
+
+    std::vector<BufferSlot> buffers(BUFFER_COUNT);
+    for (auto &slot : buffers) {
+        if (tgui_hardware_buffer_create(m_connection, &slot.buffer, TGUI_HARDWARE_BUFFER_FORMAT_RGBX8888,
+                                        size.width(), size.height(),
+                                        TGUI_HARDWARE_BUFFER_CPU_NEVER,
+                                        TGUI_HARDWARE_BUFFER_CPU_OFTEN) != TGUI_ERR_OK) {
+            for (auto &created : buffers) {
+                if (created.valid) {
+                    tgui_hardware_buffer_destroy(m_connection, &created.buffer);
+                }
+            }
+            qCWarning(KWIN_TRANSLATOR) << "Failed to create Termux:GUI HardwareBuffer" << size;
+            return false;
+        }
+        slot.valid = true;
+    }
+
+    for (auto &slot : m_buffers) {
+        if (slot.valid) {
+            tgui_hardware_buffer_destroy(m_connection, &slot.buffer);
+        }
+    }
+    m_buffers = std::move(buffers);
+    m_size = size;
+    m_lockedBuffer = -1;
+    return true;
+}
+
+void TranslatorConnection::stopEvents()
+{
+    m_running.store(false, std::memory_order_release);
+    m_bufferCondition.notify_all();
+    if (m_eventThread.joinable()) {
+        m_eventThread.join();
+    }
+}
+
+void TranslatorConnection::eventLoop()
+{
+    while (m_running.load(std::memory_order_acquire)) {
+        tgui_event event{};
+        bool available = false;
+        tgui_err error;
+        TranslatorTouchCallback touchCallback;
+        TranslatorFrameCallback frameCallback;
+        TranslatorResizeCallback resizeCallback;
+
+        {
+            std::lock_guard lock(m_mutex);
+            error = tgui_poll_event(m_connection, &event, &available);
+            touchCallback = m_touchCallback;
+            frameCallback = m_frameCallback;
+            resizeCallback = m_resizeCallback;
+        }
+
+        if (error != TGUI_ERR_OK) {
+            if (m_running.load(std::memory_order_acquire)) {
+                qCWarning(KWIN_TRANSLATOR) << "Termux:GUI event polling failed:" << error;
+            }
+            break;
+        }
+        if (!available) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+            continue;
+        }
+
+        if (event.type == TGUI_EVENT_TOUCH && touchCallback) {
+            std::vector<std::vector<TranslatorTouchPoint>> batches;
+            batches.reserve(event.touch.events);
+            for (uint32_t e = 0; e < event.touch.events; ++e) {
+                std::vector<TranslatorTouchPoint> points;
+                points.reserve(event.touch.num_pointers);
+                for (uint32_t i = 0; i < event.touch.num_pointers; ++i) {
+                    const auto &p = event.touch.pointers[e][i];
+                    points.push_back({p.id, p.x, p.y});
+                }
+                batches.push_back(std::move(points));
+            }
+            touchCallback(event.touch.action, event.touch.index, std::move(batches), event.touch.time);
+        } else if (event.type == TGUI_EVENT_FRAME_COMPLETE) {
+            std::shared_ptr<OutputFrame> frame;
+            uint64_t timestamp = event.frame.timestamp;
+            {
+                std::lock_guard lock(m_mutex);
+                if (!m_submittedFrames.empty()) {
+                    const int index = m_submittedFrames.front().first;
+                    frame = std::move(m_submittedFrames.front().second);
+                    m_submittedFrames.pop_front();
+                    if (index >= 0 && index < int(m_buffers.size())) {
+                        m_buffers[index].inFlight = false;
+                    }
+                }
+            }
+            m_bufferCondition.notify_all();
+            if (frame && frameCallback) {
+                frameCallback(std::move(frame), timestamp);
+            }
+        } else if (event.type == TGUI_EVENT_SURFACE_CHANGED) {
+            const QSize size(int(event.surfaceChanged.width), int(event.surfaceChanged.height));
+            m_pendingWidth.store(size.width(), std::memory_order_release);
+            m_pendingHeight.store(size.height(), std::memory_order_release);
+            if (resizeCallback) {
+                resizeCallback(size);
+            }
+        } else if (event.type == TGUI_EVENT_DESTROY) {
+            m_running.store(false, std::memory_order_release);
+            m_bufferCondition.notify_all();
+        }
+
+        tgui_event_destroy(&event);
+    }
+}
+
+} // namespace KWin
diff --git a/src/backends/translator/translator_connection.h b/src/backends/translator/translator_connection.h
