+/*
+    KWin - the KDE window manager
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+#include <QImage>
+#include <QSize>
+
+#include <termuxgui/types.h>
+
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace KWin
+{
+
+class OutputFrame;
+
+struct TranslatorTouchPoint
+{
+    int id;
+    int x;
+    int y;
+};
+
+using TranslatorTouchCallback = std::function<void(tgui_touch_action, uint32_t, std::vector<std::vector<TranslatorTouchPoint>>, uint64_t)>;
+using TranslatorFrameCallback = std::function<void(std::shared_ptr<OutputFrame>, uint64_t)>;
+using TranslatorResizeCallback = std::function<void(const QSize &)>;
+
+class TranslatorConnection
+{
+public:
+    explicit TranslatorConnection(const QSize &size);
+    ~TranslatorConnection();
+
+    bool initialize();
+    void startEvents();
+
+    QSize size() const;
+    QSize pendingSize() const;
+    bool applyPendingSize();
+
+    bool beginFrame();
+    bool submitFrame(const QImage &image, const std::shared_ptr<OutputFrame> &frame);
+    void cancelFrame();
+
+    void setTouchCallback(TranslatorTouchCallback callback);
+    void setFrameCallback(TranslatorFrameCallback callback);
+    void setResizeCallback(TranslatorResizeCallback callback);
+
+private:
+    struct BufferSlot
+    {
+        tgui_hardware_buffer buffer{};
+        bool valid = false;
+        bool inFlight = false;
+    };
+
+    bool createBuffers(const QSize &size);
+    void stopEvents();
+    void eventLoop();
+
+    tgui_connection m_connection = nullptr;
+    tgui_activity m_activity = -1;
+    tgui_view m_root = -1;
+    tgui_view m_surface = -1;
+    const QSize m_requestedSize;
+    QSize m_size;
+    std::vector<BufferSlot> m_buffers;
+    int m_lockedBuffer = -1;
+    std::deque<std::pair<int, std::shared_ptr<OutputFrame>>> m_submittedFrames;
+    std::atomic<int> m_pendingWidth = 0;
+    std::atomic<int> m_pendingHeight = 0;
+    std::atomic_bool m_running = false;
+    std::thread m_eventThread;
+    mutable std::mutex m_mutex;
+    std::condition_variable m_bufferCondition;
+    TranslatorTouchCallback m_touchCallback;
+    TranslatorFrameCallback m_frameCallback;
+    TranslatorResizeCallback m_resizeCallback;
+};
+
+} // namespace KWin
