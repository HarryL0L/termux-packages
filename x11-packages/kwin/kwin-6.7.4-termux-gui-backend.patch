+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#include "translator_output.h"
+
+#include "core/outputconfiguration.h"
+#include "core/renderloop.h"
+#include "translator_connection.h"
+#include "translator_qpainter_backend.h"
+
+namespace KWin
+{
+
+TranslatorOutput::TranslatorOutput(TranslatorBackend *backend, const QSize &size, qreal scale, TranslatorConnection *connection)
+    : m_backend(backend)
+    , m_connection(connection)
+    , m_renderLoop(std::make_unique<RenderLoop>(this))
+{
+    const auto mode = std::make_shared<OutputMode>(OutputModeline(size, 60000, OutputModeline::Flag::Preferred));
+    setInformation(Information{
+        .name = QStringLiteral("Translator-1"),
+        .manufacturer = QStringLiteral("Termux"),
+        .model = QStringLiteral("Termux:GUI"),
+        .physicalSize = QSize(0, 0),
+        .capabilities = Capability::CustomModes,
+    });
+    setState(State{
+        .scale = scale,
+        .modes = {mode},
+        .currentMode = mode,
+        .scaleSetting = scale,
+    });
+    m_renderLoop->setRefreshRate(mode->refreshRate());
+    m_renderLoop->setMaxPendingFrameCount(1);
+}
+
+TranslatorOutput::~TranslatorOutput() = default;
+
+RenderLoop *TranslatorOutput::renderLoop() const
+{
+    return m_renderLoop.get();
+}
+
+bool TranslatorOutput::testPresentation(const std::shared_ptr<OutputFrame> &)
+{
+    return true;
+}
+
+bool TranslatorOutput::present(const QList<OutputLayer *> &, const std::shared_ptr<OutputFrame> &frame)
+{
+    auto *layer = static_cast<TranslatorQPainterLayer *>(m_layer.get());
+    return layer->present(frame);
+}
+
+void TranslatorOutput::resize(const QSize &size)
+{
+    if (size.isEmpty() || size == modeSize()) {
+        return;
+    }
+    const auto mode = std::make_shared<OutputMode>(OutputModeline(size, 60000, OutputModeline::Flag::Preferred));
+    State next = m_state;
+    next.modes = {mode};
+    next.currentMode = mode;
+    setState(next);
+    m_renderLoop->setRefreshRate(mode->refreshRate());
+    Q_EMIT changed();
+}
+
+void TranslatorOutput::setOutputLayer(std::unique_ptr<OutputLayer> layer)
+{
+    m_layer = std::move(layer);
+}
+
+OutputLayer *TranslatorOutput::outputLayer() const
+{
+    return m_layer.get();
+}
+
+} // namespace KWin
