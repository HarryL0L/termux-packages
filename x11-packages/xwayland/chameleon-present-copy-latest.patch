     struct xwl_screen *xwl_screen = xwl_screen_get(window->drawable.pScreen);
     Bool notify_only = !vblank->window || !vblank->pixmap;
+    Bool was_blocking;
 
     xorg_list_del(&vblank->event_queue);
 
@@ -1158,6 +1183,8 @@
         present_execute_copy(vblank, crtc_msc);
         assert(!vblank->queued);
 
+        xwl_present_window->copy_msc = crtc_msc;
+
         /* Set the copy_executed field, so this will fall through to present_execute_post next time */
         event->copy_executed = TRUE;
 
@@ -1170,7 +1197,15 @@
             return;
     }
 
+    /* A held present that was replaced while it blocked later ones (waiting
+     * for a fence) ends here without a copy: let them run.
+     */
+    was_blocking = xwl_present_window->blocking_event == vblank->event_id;
+
     present_execute_post(vblank, ust, crtc_msc);
+
+    if (was_blocking)
+        xwl_present_flush_blocked(xwl_present_window, crtc_msc);
