+/* Builds a drmDevice describing the kbase GPU: a platform-bus device whose
+ * only node is the render node KBASE_DEVICE_NODE. Everything downstream
+ * (platform_surfaceless's probe loop, _eglFindDevice, the EXT_device_drm
+ * queries) only consults nodes[]/available_nodes/bustype/businfo, all of
+ * which are the public, stable libdrm ABI - so the platforms need no
+ * kbase-specific code at all. drmDevicesEqual() compares platform devices
+ * by businfo.platform->fullname, hence the fixed name. */
+static drmDevicePtr
+_eglAllocKbaseDevice(void)
+{
+   drmDevicePtr device = calloc(1, sizeof(*device));
+   if (!device)
+      return NULL;
+
+   device->nodes = calloc(DRM_NODE_MAX, sizeof(char *));
+   device->businfo.platform = calloc(1, sizeof(drmPlatformBusInfo));
+   device->deviceinfo.platform = calloc(1, sizeof(drmPlatformDeviceInfo));
+   if (!device->nodes || !device->businfo.platform ||
+       !device->deviceinfo.platform)
+      goto fail;
+
+   device->nodes[DRM_NODE_RENDER] = strdup(KBASE_DEVICE_NODE);
+   if (!device->nodes[DRM_NODE_RENDER])
+      goto fail;
+
+   device->available_nodes = 1 << DRM_NODE_RENDER;
+   device->bustype = DRM_BUS_PLATFORM;
+   snprintf(device->businfo.platform->fullname,
+            sizeof(device->businfo.platform->fullname), "kbase-mali0");
+   /* compatible: a NULL-terminated string list; empty is fine. */
+   device->deviceinfo.platform->compatible = calloc(1, sizeof(char *));
+   if (!device->deviceinfo.platform->compatible)
+      goto fail;
+
+   return device;
+
+fail:
+   _eglFreeKbaseDevice(device);
+   return NULL;
+}
