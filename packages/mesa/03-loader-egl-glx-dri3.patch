+
+   int ret = _eglAddDRMDevice(device);
+   if (ret != 0) {
+      _eglFreeKbaseDevice(device);
+      return ret;
+   }
+
+   /* _eglAddDRMDevice appended it; find the tail and mark it. */
+   for (dev = _eglGlobal.DeviceList; dev->Next; dev = dev->Next)
+      ;
+   assert(dev->device == device);
+   dev->kbase = EGL_TRUE;
+   return 0;
