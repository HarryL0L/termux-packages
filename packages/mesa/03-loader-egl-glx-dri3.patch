+/* Deferred presentation.
+ *
+ * DRM drivers attach the rendering fence to a shared dma-buf, so the X
+ * server waits before compositing (implicit sync). kbase attaches no such
+ * fence, and Present's shm wait_fence cannot be observed asynchronously by
+ * the server. Instead, the PresentPixmap request is handed, together with
+ * the frame's GPU fence (dri_create_fence + dri_get_fence_fd), to a worker
+ * thread that sends it once the fence signals. The caller never blocks,
+ * presents stay in order, and the server only sees finished frames. */
+
+static int
+loader_dri3_deferred_present_thread(void *arg)
+{
+   struct loader_dri3_drawable *draw = arg;
+
+   mtx_lock(&draw->deferred.mtx);
+   for (;;) {
+      while (draw->deferred.head == draw->deferred.tail && !draw->deferred.exit)
+         cnd_wait(&draw->deferred.cnd, &draw->deferred.mtx);
+      if (draw->deferred.head == draw->deferred.tail && draw->deferred.exit)
+         break;
+
+      __typeof__(draw->deferred.queue[0]) e = draw->deferred.queue[draw->deferred.head];
+      draw->deferred.head = (draw->deferred.head + 1) % ARRAY_SIZE(draw->deferred.queue);
+      draw->deferred.in_progress++;
+      mtx_unlock(&draw->deferred.mtx);
+
+      if (e.fence_fd >= 0) {
+         struct pollfd pfd = {.fd = e.fence_fd, .events = POLLIN};
+         while (poll(&pfd, 1, -1) < 0 && errno == EINTR)
+            ;
+         close(e.fence_fd);
+      }
+
+      /* Damage is snapshotted per present so a later swap cannot alter it. */
+      xcb_xfixes_region_t update = 0;
+      if (e.n_rects) {
+         update = xcb_generate_id(draw->conn);
+         xcb_xfixes_create_region(draw->conn, update, e.n_rects, e.rects);
+      }
+      xcb_present_pixmap(draw->conn, e.drawable, e.pixmap, e.serial,
+                         0 /* valid */, update, 0, 0, None /* target_crtc */,
+                         None /* wait_fence */, e.idle_fence, e.options,
+                         e.target_msc, e.divisor, e.remainder, 0, NULL);
+      if (update)
+         xcb_xfixes_destroy_region(draw->conn, update);
+      xcb_flush(draw->conn);
+
+      mtx_lock(&draw->deferred.mtx);
+      draw->deferred.in_progress--;
+      cnd_broadcast(&draw->deferred.cnd);
+   }
+   mtx_unlock(&draw->deferred.mtx);
+   return 0;
+}
+
+/* Block until every queued present has been sent. Used before a buffer's
+ * pixmap/fence is destroyed and at drawable teardown. */
+static void
+loader_dri3_deferred_present_drain(struct loader_dri3_drawable *draw)
+{
+   if (!draw->deferred.started)
+      return;
+   mtx_lock(&draw->deferred.mtx);
+   while (draw->deferred.head != draw->deferred.tail || draw->deferred.in_progress)
+      cnd_wait(&draw->deferred.cnd, &draw->deferred.mtx);
+   mtx_unlock(&draw->deferred.mtx);
+}
+
+static void
+loader_dri3_deferred_present_fini(struct loader_dri3_drawable *draw)
+{
+   if (!draw->deferred.started)
+      return;
+   loader_dri3_deferred_present_drain(draw);
+   mtx_lock(&draw->deferred.mtx);
+   draw->deferred.exit = true;
+   cnd_broadcast(&draw->deferred.cnd);
+   mtx_unlock(&draw->deferred.mtx);
+   thrd_join(draw->deferred.thread, NULL);
+   draw->deferred.started = false;
+}
+
+static bool
+loader_dri3_deferred_present_enabled(struct loader_dri3_drawable *draw)
+{
+   /* Decide once: only for a kbase device (a DRM driver already fences the
+    * dma-buf implicitly); LOADER_DRI3_DEFERRED_PRESENT=1/0 forces it. */
+   if (!draw->deferred.enabled) {
+      const char *env = getenv("LOADER_DRI3_DEFERRED_PRESENT");
+      bool on = env ? atoi(env) != 0
+                    : loader_is_kbase_fd(draw->dri_screen_render_gpu->fd);
+      draw->deferred.enabled = on ? 1 : 2;
+   }
+   return draw->deferred.enabled == 1;
+}
+
+/* A sync_file fd that signals when everything the context has flushed so
+ * far completes on the GPU, or -1 if the driver can't provide one. */
+static int
+loader_dri3_gpu_fence_fd(struct loader_dri3_drawable *draw)
+{
+   struct dri_context *ctx = draw->vtable->get_dri_context(draw);
+   if (!ctx)
+      return -1;
+   void *fence = dri_create_fence(ctx);
+   if (!fence)
+      return -1;
+   int fd = dri_get_fence_fd(draw->dri_screen_render_gpu, fence);
+   dri_destroy_fence(draw->dri_screen_render_gpu, fence);
+   return fd;
+}
+
+/* Queue a present to be sent once the GPU fence signals. Returns false if
+ * it couldn't be deferred (caller then presents directly). */
+static bool
+loader_dri3_deferred_present_queue(struct loader_dri3_drawable *draw,
+                                   xcb_pixmap_t pixmap, uint32_t serial,
+                                   const xcb_rectangle_t *rects, unsigned n_rects,
+                                   xcb_sync_fence_t idle_fence, uint32_t options,
+                                   uint64_t target_msc, uint64_t divisor,
+                                   uint64_t remainder)
+{
+   int fd = loader_dri3_gpu_fence_fd(draw);
+   if (fd < 0)
+      return false;
+
+   if (!draw->deferred.started) {
+      mtx_init(&draw->deferred.mtx, mtx_plain);
+      cnd_init(&draw->deferred.cnd);
+      draw->deferred.head = draw->deferred.tail = 0;
+      draw->deferred.in_progress = 0;
+      draw->deferred.exit = false;
+      if (thrd_create(&draw->deferred.thread, loader_dri3_deferred_present_thread,
+                      draw) != thrd_success) {
+         close(fd);
+         return false;
+      }
+      draw->deferred.started = true;
+   }
+
+   mtx_lock(&draw->deferred.mtx);
+   while ((draw->deferred.tail + 1) % ARRAY_SIZE(draw->deferred.queue) == draw->deferred.head)
+      cnd_wait(&draw->deferred.cnd, &draw->deferred.mtx);
+   __typeof__(draw->deferred.queue[0]) *e = &draw->deferred.queue[draw->deferred.tail];
+   e->fence_fd = fd;
+   e->drawable = draw->drawable;
+   e->pixmap = pixmap;
+   e->serial = serial;
+   e->n_rects = (uint16_t)n_rects;
+   if (n_rects)
+      memcpy(e->rects, rects, n_rects * sizeof(*rects));
+   e->idle_fence = idle_fence;
+   e->options = options;
+   e->target_msc = target_msc;
+   e->divisor = divisor;
+   e->remainder = remainder;
+   draw->deferred.tail = (draw->deferred.tail + 1) % ARRAY_SIZE(draw->deferred.queue);
+   cnd_broadcast(&draw->deferred.cnd);
+   mtx_unlock(&draw->deferred.mtx);
+   return true;
+}
 
