+/* See loader_is_kbase_fd() in loader.h.
+ *
+ * Detection must be side-effect free: kbase's VERSION_CHECK ioctl (the
+ * obvious probe) can succeed only ONCE per open file - the kernel moves
+ * the file from NEED_VSN to VSN_IN_PROGRESS with a cmpxchg and answers
+ * -EPERM ever after (kbase_file_set_api_version, mali_kbase_core_linux.c).
+ * A dup()'d fd shares that file, and the EGL path probes the same file
+ * from three layers (loader, pipe-loader, pan_kmod), so an ioctl probe
+ * only works for whichever layer asks first. Comparing the fd's device
+ * number against /dev/mali0's has no side effects and survives dup(). */
+bool
+loader_is_kbase_fd(int fd)
+{
+   static dev_t kbase_rdev;
+   static int kbase_rdev_state; /* 0 = unknown, 1 = found, -1 = absent */
+   struct stat st;
+
+   if (fd < 0)
+      return false;
+
+   if (kbase_rdev_state == 0) {
+      struct stat node;
+      if (stat("/dev/mali0", &node) == 0 && S_ISCHR(node.st_mode)) {
+         kbase_rdev = node.st_rdev;
+         kbase_rdev_state = 1;
+      } else {
+         kbase_rdev_state = -1;
+      }
+   }
+   if (kbase_rdev_state < 0)
+      return false;
+
+   return fstat(fd, &st) == 0 && S_ISCHR(st.st_mode) && st.st_rdev == kbase_rdev;
+}
